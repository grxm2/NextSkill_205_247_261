@* Scroll moves the depth planes; their children keep drifting when the voyage stops mid-sea. *@
<div class="ow-open-sea-effects" aria-hidden="true">
    <div class="ow-sea-mist ow-sea-mist--far"><div class="ow-sea-mist-drift"></div></div>
    <div class="ow-sea-mist ow-sea-mist--mid"><div class="ow-sea-mist-drift"></div></div>
    <div class="ow-sea-foam ow-sea-foam--far"><div class="ow-sea-foam-bob"><div class="ow-sea-foam-drift"></div></div></div>
    <div class="ow-sea-mist ow-sea-mist--near"><div class="ow-sea-mist-drift"></div></div>
    <div class="ow-sea-foam ow-sea-foam--near"><div class="ow-sea-foam-bob"><div class="ow-sea-foam-drift"></div></div></div>
</div>
