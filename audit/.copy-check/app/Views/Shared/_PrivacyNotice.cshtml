@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var configuredEmail = Configuration["Privacy:ContactEmail"];
    var contactEmail = System.Net.Mail.MailAddress.TryCreate(configuredEmail, out var address)
        ? address.Address : null;
}

<h2>ข้อมูลที่ NextSkill ใช้</h2>
<ul>
    <li>ชื่อที่แสดง อีเมล รหัสผ่านที่แปลงเป็นแฮช เวลาสร้างบัญชีและยอมรับเงื่อนไข รวมถึงเวลาเข้าสู่ระบบล่าสุดและจำนวนครั้งที่เข้าสู่ระบบไม่สำเร็จ ใช้ดูแลบัญชี ยืนยันตัวตน และจำกัดการพยายามเข้าสู่ระบบ</li>
    <li>คอร์สที่ลงทะเบียน ความคืบหน้าของบทเรียน สถานะวิดีโอ คะแนนและจำนวนครั้งที่ทำแบบทดสอบท้ายคอร์ส XP และรางวัล ใช้ให้กลับมาเรียนต่อ ตรวจเงื่อนไขการปลดล็อก และสรุปผลการเรียน</li>
    <li>เมื่อออกใบประกาศ ระบบเก็บชื่อผู้รับ ชื่อคอร์ส วันที่เกี่ยวข้อง และเลขอ้างอิง ผู้ที่ได้รับเลขอ้างอิงสามารถตรวจชื่อคอร์สและวันที่ของใบประกาศจาก NextSkill ได้ หน้าเว็บตรวจสอบไม่แสดงชื่อผู้รับหรืออีเมล</li>
</ul>

<h2>ใครเข้าถึงข้อมูลได้</h2>
<p>ผู้เรียนดูผลการเรียนและจัดการข้อมูลบัญชีของตนเอง ผู้ดูแลระบบที่ได้รับสิทธิ์เข้าถึงรายการบัญชีและสถิติที่ใช้ดูแล NextSkill ชื่อผู้รับปรากฏในใบประกาศที่เจ้าของบัญชีเปิดดูหรือเลือกแชร์</p>

<h2>คุกกี้และข้อมูลในเบราว์เซอร์</h2>
<p>NextSkill ใช้คุกกี้เพื่อตรวจสถานะการเข้าสู่ระบบและป้องกันการส่งฟอร์มจากเว็บไซต์อื่น เมื่อเลือก “จำการเข้าสู่ระบบในเบราว์เซอร์นี้” คุกกี้เข้าสู่ระบบจะยังอยู่หลังปิดเบราว์เซอร์จนกว่าจะหมดอายุ ล้างข้อมูลเว็บไซต์ หรือออกจากระบบ ธีมและการตั้งค่าการเคลื่อนไหวเก็บไว้ในเบราว์เซอร์</p>

<h2>สื่อจากผู้ให้บริการภายนอก</h2>
<p>เบราว์เซอร์อาจติดต่อ YouTube, Vimeo หรือโฮสต์วิดีโอที่คอร์สกำหนดเมื่อเปิดตัวเล่น วิดีโอในหน้ารายละเอียดคอร์สอาจเริ่มเชื่อมต่อเมื่ออยู่ในพื้นที่ที่กำลังดูหรือเมื่อเบราว์เซอร์โหลดข้อมูลไฟล์วิดีโอ ผู้ให้บริการอาจได้รับที่อยู่ IP และข้อมูลเบราว์เซอร์ หน้าเว็บที่ใช้แบบอักษรภายนอกอาจส่งคำขอไปยังผู้ให้บริการแบบอักษรด้วย</p>

<h2>ระยะเก็บข้อมูลและช่องทางติดต่อ</h2>
<p>แอปเก็บบัญชีและประวัติการเรียนเพื่อให้ใช้เรียนต่อและตรวจผลได้ ขณะนี้ไม่มีการลบระเบียนเหล่านี้อัตโนมัติตามอายุข้อมูล คุณแก้ชื่อหรืออีเมลของตนเองจากหน้าโปรไฟล์ได้ หากต้องการขอเข้าถึง แก้ไข หรือลบข้อมูล ให้ติดต่อผู้ดูแลการติดตั้ง NextSkill</p>
@if (contactEmail is not null)
{
    <p>อีเมลผู้ดูแล <a href="@($"mailto:{contactEmail}")">@contactEmail</a></p>
}
else
{
    <p>ยังไม่ได้ตั้งอีเมลผู้ดูแลบนเว็บไซต์นี้ ให้ใช้ช่องทางที่ผู้จัดการเรียนแจ้งตอนให้สิทธิ์เข้าใช้ NextSkill</p>
}
