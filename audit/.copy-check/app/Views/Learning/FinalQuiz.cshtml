@model CourseFinalQuizPage
@{
    ViewData["Title"] = "แบบทดสอบท้ายคอร์ส";
    var completed = Model.AlreadyCompleted || Model.Result?.Passed == true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/final-quiz.css" asp-append-version="true" />
}

<section class="ns-final-quiz" aria-labelledby="final-quiz-title">
    <a class="ns-button ns-button--text ns-final-quiz-back" asp-action="Island" asp-route-courseId="@Model.CourseId">← กลับแผนที่บทเรียน</a>
    <header>
        <h1 id="final-quiz-title">แบบทดสอบท้ายคอร์ส</h1>
        <p class="ns-final-quiz-course" dir="auto">@Model.CourseTitle</p>
    </header>

    @if (Model.Result is { } result)
    {
        <div id="final-quiz-result" class="ns-status @(result.Passed ? "ns-status--success" : "ns-status--error")"
             role="status" data-passed="@result.Passed.ToString().ToLowerInvariant()">
            <h2>@(result.Passed ? "สอบผ่านและเรียนจบคอร์สแล้ว" : "คะแนนยังไม่ถึงเกณฑ์ผ่าน")</h2>
            <p>ตอบถูก @result.Score จาก @result.TotalQuestions ข้อ · ต้องตอบถูกอย่างน้อย @result.RequiredCorrect ข้อ</p>
            @if (result.AwardedXp > 0)
            {
                <p>ได้รับโบนัสจบคอร์ส +@result.AwardedXp XP</p>
            }
            @if (!result.Passed)
            {
                <p>ทบทวนบทเรียนแล้วกลับมาสอบใหม่ได้</p>
            }
        </div>
    }
    else if (completed)
    {
        <p id="final-quiz-result" class="ns-status ns-status--success" data-passed="true">คุณเรียนจบคอร์สนี้แล้ว</p>
    }

    @if (completed)
    {
        <div class="ns-button-row ns-final-quiz-actions">
            @if (Model.NextCourseId is int nextCourseId)
            {
                <a id="final-quiz-next-course" class="ns-button ns-button--primary" asp-controller="Home" asp-action="Details" asp-route-id="@nextCourseId">
                    ไปคอร์สถัดไป · @Model.NextCourseTitle
                </a>
            }
            @if (User.IsInRole("User"))
            {
                <a id="final-quiz-certificate" class="ns-button @(Model.NextCourseId.HasValue ? "ns-button--secondary" : "ns-button--primary")"
                   asp-controller="Account" asp-action="Certificate" asp-route-courseId="@Model.CourseId">เปิดใบประกาศ</a>
            }
            @if (!Model.NextCourseId.HasValue)
            {
                <a class="ns-button ns-button--secondary" asp-controller="Home" asp-action="Courses">กลับคลังคอร์ส</a>
            }
        </div>
    }
    else
    {
        <form id="final-quiz-form" class="ns-surface ns-final-quiz-form" asp-action="FinalQuiz" asp-route-courseId="@Model.CourseId" method="post">
            <input type="hidden" name="CourseId" value="@Model.CourseId" />
            <input type="hidden" name="QuizVersion" value="@Model.QuizVersion" />
            @if (Model.Error is { } error)
            {
                <p id="final-quiz-error" class="ns-status ns-status--error" role="alert">@error</p>
            }
            else
            {
                <div asp-validation-summary="All" class="ns-status ns-status--error" role="alert"></div>
            }
            <p class="ns-final-quiz-rule">ตอบให้ครบ @Model.Questions.Count ข้อ ต้องตอบถูกอย่างน้อย @Model.RequiredCorrect ข้อเพื่อเรียนจบคอร์ส</p>
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];
                <fieldset class="ns-final-question">
                    <legend><span class="ns-final-question-number">@(index + 1).</span> @question.Prompt</legend>
                    @for (var choice = 0; choice < question.Choices.Count; choice++)
                    {
                        <label class="ns-final-choice">
                            <input type="radio" name="Answers[@index]" value="@choice" required />
                            <span dir="auto">@question.Choices[choice]</span>
                        </label>
                    }
                </fieldset>
            }
            <button id="final-quiz-submit" class="ns-button ns-button--primary" type="submit">ส่งคำตอบ</button>
        </form>
    }
</section>
