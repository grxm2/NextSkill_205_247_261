@using NextSkill_205_247_261.Services

<section class="form-group" aria-labelledby="course-lessons-heading">
    <h4 id="course-lessons-heading">บทเรียนในคอร์ส</h4>
    <p class="subtle">เพิ่มบทอ่านหรือวิดีโอในแต่ละบท แล้วไปที่คลังคำถามเพื่อเพิ่มคำถามรายบทและแบบทดสอบท้ายคอร์ส</p>
    <div id="course-lesson-editor" data-max-lessons="@AdminContentStore.CourseLessonLimit" data-max-readings="@AdminContentStore.CourseReadingSectionLimit"></div>
    <button type="button" id="course-add-lesson" class="ns-button ns-button--secondary ns-button--compact">เพิ่มบทเรียน</button>
</section>

<template id="course-lesson-template">
    <details class="outlined-card" data-lesson-editor>
        <summary data-lesson-heading></summary>
        <div class="admin-form-row">
            <label class="form-group">
                ชื่อบทเรียน
                <input type="text" data-lesson-field="title" maxlength="@AdminContentStore.CourseTitleLimit" />
            </label>
            <label class="form-group">
                เวลาอ่านโดยประมาณ (นาที)
                <input type="number" data-lesson-field="durationMinutes" min="1" max="720" value="@AdminContentStore.DefaultLessonMinutes" />
            </label>
        </div>
        <label class="form-group">
            สรุปบทเรียน
            <textarea data-lesson-field="summary" rows="2" maxlength="@AdminContentStore.CourseDescriptionLimit"></textarea>
        </label>
        <div class="admin-form-row">
            <label class="form-group">
                รหัสวิดีโอ YouTube (ไม่บังคับ)
                <input type="text" data-lesson-field="videoId" maxlength="11" />
            </label>
            <label class="form-group">
                ความยาววิดีโอ (วินาที)
                <input type="number" data-lesson-field="videoDurationSeconds" min="1" max="7200" />
            </label>
            <label class="form-group">
                ชื่อวิดีโอ
                <input type="text" data-lesson-field="videoTitle" maxlength="@AdminContentStore.CourseTitleLimit" />
            </label>
            <label class="form-group">
                เจ้าของวิดีโอ
                <input type="text" data-lesson-field="videoCreator" maxlength="@AdminContentStore.CourseInstructorLimit" />
            </label>
        </div>
        <div data-reading-list></div>
        <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-reading-add>เพิ่มหัวข้อบทอ่าน</button>
        <button type="button" class="ns-button ns-button--danger ns-button--compact" data-lesson-remove>นำบทเรียนออก</button>
    </details>
</template>

<template id="course-reading-template">
    <fieldset class="outlined-card" data-reading-entry>
        <legend>หัวข้อบทอ่าน</legend>
        <label class="form-group">
            ชื่อหัวข้อ
            <input type="text" data-reading-field="heading" maxlength="@AdminContentStore.CourseTitleLimit" />
        </label>
        <label class="form-group">
            เนื้อหา
            <textarea data-reading-field="text" rows="3" maxlength="@AdminContentStore.CourseDescriptionLimit"></textarea>
        </label>
        <label class="form-group">
            ตัวอย่าง (ไม่บังคับ)
            <textarea data-reading-field="example" rows="2" maxlength="@AdminContentStore.CourseDescriptionLimit"></textarea>
        </label>
        <button type="button" class="ns-button ns-button--danger ns-button--compact" data-reading-remove>นำหัวข้อนี้ออก</button>
    </fieldset>
</template>
