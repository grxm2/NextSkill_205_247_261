@model AdminDashboardModel
@{
    Layout = null;
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "A" : System.Globalization.StringInfo.GetNextTextElement(Model.FullName.Trim()).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ศูนย์ควบคุมผู้ดูแล NextSkill | NextSkill Admin</title>
    <link rel="icon" href="~/home-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/Prompt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/Prompt-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-game.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
</head>
<body class="ns-admin">
    <a class="skip-link" href="#main-content">ข้ามไปเนื้อหาหลัก</a>
    <div class="admin-shell">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <a class="brand" href="#dashboard" aria-label="NextSkill Admin">
                <div class="brand-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect width="24" height="24" rx="6" fill="#0284c7" />
                        <path d="M6 16V8h3l6 8V8h3v8h-3.5L8.5 10v6Z" fill="#fff" />
                    </svg>
                </div>
                <div class="brand-text-block">
                    <strong>NextSkill</strong>
                    <small>เก่งขึ้น ในเส้นทางของคุณ</small>
                </div>
            </a>

            <div class="admin-badge-pill">
                <span>⚙️</span> ศูนย์ควบคุมผู้ดูแลระบบ
            </div>

            <nav aria-label="Admin navigation" class="admin-nav">
                <a href="#dashboard" class="active" aria-current="page">
                    <span class="nav-icon">📊</span>
                    <span>ภาพรวม</span>
                    <small>Overview</small>
                </a>
                <a href="#courses">
                    <span class="nav-icon">📚</span>
                    <span>จัดการคอร์สเรียน</span>
                    <small>Courses (@Model.Courses.Count)</small>
                </a>
                <a href="#questions">
                    <span class="nav-icon">❓</span>
                    <span>แบบฝึกหัด &amp; คำถาม</span>
                    <small>Quiz Studio (@Model.TotalQuestions)</small>
                </a>
                <a href="#learners">
                    <span class="nav-icon">👥</span>
                    <span>รายชื่อผู้เรียน</span>
                    <small>Accounts (@(Model.Users + Model.Admins))</small>
                </a>
                <a href="#settings">
                    <span class="nav-icon">⚙️</span>
                    <span>โปรไฟล์ &amp; ตั้งค่า</span>
                    <small>Settings</small>
                </a>
            </nav>

            <div class="sidebar-account">
                <strong>@Model.FullName</strong>
                <span>@Model.Email</span>
                <form asp-action="Logout" method="post" style="margin-top: 14px;">
                    <button class="ns-button ns-button--secondary ns-button--compact" type="submit" style="width: 100%; justify-content: center;">
                        ออกจากระบบ ↗
                    </button>
                </form>
            </div>
            <div class="sidebar-bottom">
                NextSkill Admin · Upskill &amp; Reskill
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="workspace">
            <header class="topbar">
                <h1 id="page-title">ศูนย์ควบคุมผู้ดูแล NextSkill</h1>
                <div class="topbar-actions">
                    <a asp-controller="Home" asp-action="Index" class="ns-button ns-button--secondary ns-button--compact" target="_blank" title="เปิดหน้าเว็บผู้เรียนในแท็บใหม่">
                        <span>ดูหน้าบ้าน (ผู้เรียน) ↗</span>
                    </a>
                    <div class="admin-user-pill">
                        <span class="avatar">@initial</span>
                        <span class="admin-name-text">@Model.FullName</span>
                        <span class="admin-role-tag">Admin</span>
                    </div>
                </div>
            </header>

            <main id="main-content" tabindex="-1">
                <!-- ==============================================
                     PANEL 1: Dashboard Overview
                     ============================================== -->
                <section id="dashboard" class="admin-panel" data-title="ภาพรวมผู้ดูแลระบบ" aria-label="Dashboard overview">
                    <!-- Hero Banner Matching Home Screen -->
                    <div class="ocean-admin-hero">
                        <div class="hero-content">
                            <div class="hero-pill-badge">
                                <span class="star">★</span> NEXTSKILL · ADMIN CONTROL CENTER
                            </div>
                            <h2>ยินดีต้อนรับกลับ, คุณ @Model.FullName! 💙</h2>
                            <p>
                                จัดการคอร์สเรียน อัปโหลดเนื้อหาใหม่ และปรับแต่งแบบฝึกหัด เพื่อให้ผู้เรียนทุกคนสนุกและเก่งขึ้นในเส้นทางของตัวเองไปกับ Nimo
                            </p>
                            <div class="hero-quick-actions">
                                <button type="button" class="ns-button ns-button--primary" id="hero-btn-new-course">
                                    <span>+ สร้างคอร์สใหม่</span>
                                </button>
                                <button type="button" class="ns-button ns-button--secondary" id="hero-btn-upload-course">
                                    <span>⬆️ อัปโหลดไฟล์คอร์ส (JSON)</span>
                                </button>
                                <button type="button" class="ns-button ns-button--secondary" id="hero-btn-new-question">
                                    <span>+ เพิ่มคำถามแบบฝึกหัด</span>
                                </button>
                            </div>
                        </div>
                        <div class="hero-nimo-artwork" aria-hidden="true">
                            <img src="~/images/nimo-mascot.png" alt="Nimo มาสคอตเพื่อนร่วมทางการเรียนรู้" class="hero-nimo-img" />
                        </div>
                        <div class="ocean-waves-decor"></div>
                    </div>

                    <!-- Metrics Grid -->
                    <div class="metric-grid">
                        <article class="metric card-blue">
                            <div class="metric-header">
                                <h2>คอร์สเรียนทั้งหมด</h2>
                                <span class="metric-icon-badge">📚</span>
                            </div>
                            <strong id="metric-courses-count">@Model.Courses.Count</strong>
                            <p>พร้อมเปิดสอนในระบบ NextSkill</p>
                        </article>
                        <article class="metric card-green">
                            <div class="metric-header">
                                <h2>ด่าน &amp; เกาะบทเรียน</h2>
                                <span class="metric-icon-badge">🏝️</span>
                            </div>
                            <strong id="metric-lessons-count">@Model.TotalLessons</strong>
                            <p>เกาะการเรียนรู้ในทุกเส้นทาง</p>
                        </article>
                        <article class="metric card-yellow">
                            <div class="metric-header">
                                <h2>แบบฝึกหัด &amp; คำถาม</h2>
                                <span class="metric-icon-badge">❓</span>
                            </div>
                            <strong id="metric-questions-count">@Model.TotalQuestions</strong>
                            <p>ข้อสอบและคำถามฝึกกับ Nimo</p>
                        </article>
                        <article class="metric card-purple">
                            <div class="metric-header">
                                <h2>สมาชิกทั้งหมด</h2>
                                <span class="metric-icon-badge">👥</span>
                            </div>
                            <strong>@(Model.Users + Model.Admins)</strong>
                            <p>@Model.Users ผู้เรียน · @Model.Admins ผู้ดูแล</p>
                        </article>
                    </div>

                    <!-- Course Performance & Quick Tasks -->
                    <div class="overview-grid">
                        <section class="performance outlined-card" aria-labelledby="quick-courses-title" style="padding: 24px;">
                            <div class="section-heading">
                                <h2 id="quick-courses-title">คอร์สเรียนล่าสุด</h2>
                                <a href="#courses" class="ns-button ns-button--secondary ns-button--compact">ดูทั้งหมด (@Model.Courses.Count) →</a>
                            </div>
                            <div class="table-scroll">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>ชื่อคอร์ส</th>
                                            <th>หมวดหมู่</th>
                                            <th>ระดับ</th>
                                            <th>จำนวนด่าน</th>
                                            <th>ผู้สอน</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.Courses.Take(5))
                                        {
                                            <tr>
                                                <td><strong>@c.Title</strong></td>
                                                <td><span class="status-badge">@c.Category</span></td>
                                                <td>@c.Level</td>
                                                <td>@(c.Lessons?.Count ?? c.Units) ด่าน</td>
                                                <td>@c.Instructor</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section class="task-section outlined-card" aria-labelledby="admin-tasks-title" style="padding: 24px;">
                            <div class="section-heading">
                                <h2 id="admin-tasks-title">เมนูด่วนผู้ดูแล</h2>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                <a href="#courses" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>📚 จัดการคอร์สเรียน &amp; อัปโหลด</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                                <a href="#questions" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>❓ จัดการแบบฝึกหัด &amp; แก้คำถาม</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                                <a href="#learners" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>👥 ค้นหาและดูผู้เรียน (@Model.Users คน)</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                            </div>
                        </section>
                    </div>

                    <!-- Recent Activity -->
                    <section class="activity-section outlined-card" aria-labelledby="activity-title" style="padding: 24px; margin-top: 24px;">
                        <div class="section-heading">
                            <h2 id="activity-title">กิจกรรมล่าสุดในระบบ (Recent Activity)</h2>
                            <span class="subtle">การสมัครสมาชิกและการเข้าสู่ระบบ</span>
                        </div>
                        <div class="activity-card" style="padding: 0;">
                            @if (Model.Activities.Count == 0)
                            {
                                <p class="empty-message">ยังไม่มีบันทึกกิจกรรมล่าสุด</p>
                            }
                            @foreach (var item in Model.Activities)
                            {
                                <div class="activity-row">
                                    <time datetime="@item.OccurredAt.ToString("O")" data-local-time>@item.OccurredAt.ToString("dd MMM HH:mm") UTC</time>
                                    <p><strong>@item.FullName</strong> @item.Action</p>
                                    <span class="activity-tag">@item.Role</span>
                                </div>
                            }
                        </div>
                    </section>
                </section>

                <!-- ==============================================
                     PANEL 2: Course Library & Management
                     ============================================== -->
                <section id="courses" class="admin-panel" data-title="จัดการคอร์สเรียน &amp; อัปโหลด" aria-labelledby="courses-heading" hidden>
                    <div class="section-heading">
                        <div>
                            <h2 id="courses-heading">คลังคอร์สเรียน (Course Library)</h2>
                            <span class="subtle">มีทั้งหมด <strong id="course-total-badge">@Model.Courses.Count</strong> คอร์สในระบบ</span>
                        </div>
                        <div class="section-heading-actions">
                            <button type="button" class="ns-button ns-button--secondary ns-button--compact" id="btn-open-upload-modal">
                                <span>⬆️ อัปโหลดคอร์ส (JSON)</span>
                            </button>
                            <button type="button" class="ns-button ns-button--primary ns-button--compact" id="btn-open-course-modal">
                                <span>+ สร้างคอร์สใหม่</span>
                            </button>
                        </div>
                    </div>

                    <!-- Search and filters -->
                    <div class="outlined-card" style="margin-bottom: 20px; padding: 16px 20px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
                        <input type="search" id="course-search-input" placeholder="ค้นหาชื่อคอร์ส, ผู้สอน หรือหมวดหมู่..." style="flex: 1; min-width: 240px; padding: 9px 14px; border: 1.5px solid var(--nimo-sky-border); border-radius: 12px; font-size: 13.5px;" />
                        <select id="course-category-filter" style="padding: 9px 14px; border: 1.5px solid var(--nimo-sky-border); border-radius: 12px; font-size: 13.5px; background: white;">
                            <option value="">ทุกหมวดหมู่ (All Categories)</option>
                            <option value="Technology">Technology</option>
                            <option value="Design">Design</option>
                            <option value="Business">Business</option>
                            <option value="Languages">Languages</option>
                        </select>
                    </div>

                    <!-- Courses Table -->
                    <div class="outlined-card" style="padding: 0;">
                        <div class="table-scroll">
                            <table id="courses-main-table">
                                <thead>
                                    <tr>
                                        <th>รหัส</th>
                                        <th>ชื่อคอร์สเรียน</th>
                                        <th>หมวดหมู่</th>
                                        <th>ระดับ</th>
                                        <th>จำนวนด่าน</th>
                                        <th>ผู้สอน</th>
                                        <th>สถานะแนะนำ</th>
                                        <th style="text-align: right;">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody id="courses-table-body">
                                    @foreach (var course in Model.Courses)
                                    {
                                        <tr data-course-row data-id="@course.Id" data-category="@course.Category" data-title="@course.Title.ToLowerInvariant()" data-instructor="@course.Instructor.ToLowerInvariant()">
                                            <td><span class="status-badge">#@course.Id</span></td>
                                            <td>
                                                <strong style="font-size: 14px; color: var(--nimo-navy);">@course.Title</strong>
                                                <p style="margin: 3px 0 0; font-size: 12px; color: var(--nimo-muted); max-width: 320px; white-space: normal;">@course.Description</p>
                                            </td>
                                            <td><span class="status-badge published">@course.Category</span></td>
                                            <td>@course.Level</td>
                                            <td>@(course.Lessons?.Count ?? course.Units) ด่าน</td>
                                            <td>@course.Instructor</td>
                                            <td>
                                                @if (course.Featured)
                                                {
                                                    <span class="status-badge yellow">★ แนะนำ</span>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--nimo-muted); font-size: 12px;">ทั่วไป</span>
                                                }
                                            </td>
                                            <td style="text-align: right; white-space: nowrap;">
                                                <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-edit-course" data-id="@course.Id">✏️ แก้ไข</button>
                                                <button type="button" class="ns-button ns-button--danger ns-button--compact btn-delete-course" data-id="@course.Id" data-title="@course.Title">🗑️ ลบ</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- ==============================================
                     PANEL 3: Question & Quiz Studio
                     ============================================== -->
                <section id="questions" class="admin-panel" data-title="จัดการแบบฝึกหัด &amp; คำถาม" aria-labelledby="questions-heading" hidden>
                    <div class="section-heading">
                        <div>
                            <h2 id="questions-heading">คลังแบบฝึกหัด &amp; คำถาม (Quiz &amp; Question Studio)</h2>
                            <span class="subtle">มีทั้งหมด <strong id="question-total-badge">@Model.TotalQuestions</strong> ข้อในระบบ สำหรับฝึกคู่กับ Nimo</span>
                        </div>
                        <div class="section-heading-actions">
                            <button type="button" class="ns-button ns-button--primary ns-button--compact" id="btn-open-question-modal">
                                <span>+ เพิ่มคำถามใหม่</span>
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar -->
                    <div class="outlined-card" style="padding: 0; margin-bottom: 22px;">
                        <div class="quiz-filter-bar">
                            <span style="font-size: 13px; font-weight: 600; color: var(--nimo-slate);">เลือกคอร์ส:</span>
                            <select id="question-course-filter" style="min-width: 220px;">
                                <option value="0">ทุกคอร์ส (All Courses)</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.Title (@c.Category)</option>
                                }
                            </select>

                            <input type="search" id="question-search-input" placeholder="ค้นหาเนื้อหาคำถามหรือเฉลย..." style="flex: 1; min-width: 220px;" />
                        </div>

                        <!-- Questions Grid -->
                        <div class="quiz-cards-grid" id="questions-container">
                            @foreach (var q in Model.Questions)
                            {
                                <div class="question-studio-card" data-question-card data-id="@q.Id" data-course-id="@q.CourseId" data-prompt="@q.Prompt.ToLowerInvariant()">
                                    <div class="question-meta-row">
                                        <span class="question-course-tag">@q.CourseTitle · บทที่ @q.LessonId</span>
                                        <span style="font-size: 11px; color: var(--nimo-muted);">รหัส: @q.Id</span>
                                    </div>

                                    <h4 class="question-prompt">@q.Prompt</h4>

                                    <div class="question-choices-list">
                                        @for (int i = 0; i < q.Choices.Count; i++)
                                        {
                                            var isCorrect = i == q.CorrectChoice;
                                            <div class="choice-item @(isCorrect ? "correct" : "")">
                                                <span class="choice-letter">@((char)('A' + i))</span>
                                                <span>@q.Choices[i]</span>
                                                @if (isCorrect)
                                                {
                                                    <span style="margin-left: auto; font-size: 11px; font-weight: 700; color: #047857;">✓ คำตอบที่ถูกต้อง</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                    {
                                        <div class="question-note-box">
                                            <strong>💡 คำอธิบายเมื่อผู้เรียนตอบ:</strong>
                                            <span>@q.Explanation</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(q.Hint))
                                    {
                                        <div style="font-size: 12px; color: var(--nimo-muted); background: #fefce8; border: 1px solid #fef08a; padding: 7px 10px; border-radius: 8px;">
                                            <strong style="color: #b45309;">💬 คำใบ้จาก Nimo:</strong> @q.Hint
                                        </div>
                                    }

                                    <div class="question-card-footer">
                                        <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-test-quiz" data-id="@q.Id" style="font-size: 12px;">
                                            <span>🎮 ทดสอบตอบ</span>
                                        </button>
                                        <div style="display: flex; gap: 8px;">
                                            <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-edit-question" data-id="@q.Id">✏️ แก้ไข</button>
                                            <button type="button" class="ns-button ns-button--danger ns-button--compact btn-delete-question" data-id="@q.Id">🗑️ ลบ</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <!-- ==============================================
                     PANEL 4: Learners & Accounts Directory
                     ============================================== -->
                <section id="learners" class="admin-panel" data-title="รายชื่อผู้เรียน &amp; บัญชี" aria-labelledby="members-heading" hidden>
                    <div class="section-heading directory-heading">
                        <div>
                            <h2 id="members-heading">รายชื่อสมาชิกในระบบ (Account Directory)</h2>
                            <p class="subtle">มีผู้เรียน @Model.Users คน · ผู้ดูแล @Model.Admins คน · แสดงรายการล่าสุด 100 รายการ</p>
                        </div>
                        <div class="directory-controls">
                            <label for="member-search" class="sr-only">ค้นหา</label>
                            <input id="member-search" type="search" placeholder="ค้นหาชื่อหรืออีเมล..." />
                            <label for="member-role" class="sr-only">ประเภทบัญชี</label>
                            <select id="member-role">
                                <option value="all">ทุกประเภท (All)</option>
                                <option value="User">ผู้เรียน (User)</option>
                                <option value="Admin">ผู้ดูแลระบบ (Admin)</option>
                            </select>
                        </div>
                    </div>
                    <div class="outlined-card table-scroll" style="padding: 0;">
                        <table class="members-table">
                            <thead>
                                <tr>
                                    <th>ชื่อ-นามสกุล</th>
                                    <th>อีเมล (Email)</th>
                                    <th>สิทธิ์บัญชี</th>
                                    <th>วันที่เข้าร่วม</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members)
                                {
                                    <tr data-member data-role="@member.Role">
                                        <td><strong>@member.FullName</strong></td>
                                        <td>@member.Email</td>
                                        <td>
                                            <span class="status-badge @(member.Role == "Admin" ? "published" : "")">
                                                @(member.Role == "Admin" ? "⚙️ ผู้ดูแล" : "🎒 ผู้เรียน")
                                            </span>
                                        </td>
                                        <td><time datetime="@member.CreatedAt.ToString("O")" data-local-date>@member.CreatedAt.ToString("dd MMM yyyy")</time></td>
                                    </tr>
                                }
                                <tr id="no-members" hidden="@(Model.Members.Count > 0)">
                                    <td colspan="4" class="empty-message">ไม่พบบัญชีที่ตรงกับคำค้นหา</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="subtle" id="member-count" aria-live="polite" style="margin-top: 10px;">แสดง @Model.Members.Count บัญชี</p>
                </section>

                <!-- ==============================================
                     PANEL 5: Admin Profile & Settings
                     ============================================== -->
                <section id="settings" class="admin-panel" data-title="ข้อมูลบัญชีผู้ดูแล &amp; ตั้งค่า" aria-labelledby="settings-heading" hidden>
                    <div class="section-heading">
                        <h2 id="settings-heading">บัญชีผู้ดูแลระบบ (Admin Profile)</h2>
                    </div>
                    <div class="outlined-card settings-card" style="padding: 28px;">
                        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
                            <span class="avatar large-avatar" style="width: 56px; height: 56px; font-size: 22px;">@initial</span>
                            <div>
                                <h3 style="margin: 0 0 4px; font-size: 20px;">@Model.FullName</h3>
                                <span class="status-badge published">⚙️ ผู้ดูแลระบบ (System Administrator)</span>
                            </div>
                        </div>
                        <dl style="display: grid; grid-template-columns: 140px 1fr; gap: 14px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
                            <dt style="font-weight: 600; color: var(--nimo-muted);">อีเมลผู้ดูแล:</dt>
                            <dd style="margin: 0; font-weight: 500;">@Model.Email</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">สิทธิ์การใช้งาน:</dt>
                            <dd style="margin: 0; color: #047857; font-weight: 600;">เต็มรูปแบบ (Full Admin Access)</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">ระบบฐานข้อมูล:</dt>
                            <dd style="margin: 0;">NextSkill Database &amp; LocalDB MSSQL</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">สถานะระบบ:</dt>
                            <dd style="margin: 0; color: #047857; font-weight: 600;">● ปกติ (Online &amp; Active)</dd>
                        </dl>
                        <form asp-action="Logout" method="post" style="margin-top: 28px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
                            <button type="submit" class="ns-button ns-button--danger ns-button--compact" style="padding: 10px 22px; font-size: 13.5px;">ออกจากระบบ</button>
                        </form>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- ==============================================
         MODAL 1: Add / Edit Course Dialog
         ============================================== -->
    <dialog id="course-modal" class="nimo-modal">
        <div class="modal-header">
            <h3 id="course-modal-title">สร้างคอร์สเรียนใหม่</h3>
            <button type="button" class="modal-close-btn" data-close-modal="course-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="course-form" method="dialog">
            <input type="hidden" id="course-id" value="0" />
            <div class="modal-body">
                <div class="form-group">
                    <label for="course-title">ชื่อคอร์สเรียน (Title) <span>*</span></label>
                    <input type="text" id="course-title" required placeholder="เช่น Next.js 15 Fullstack Mastery" />
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group">
                        <label for="course-category">หมวดหมู่ (Category) <span>*</span></label>
                        <select id="course-category" required>
                            <option value="Technology">Technology</option>
                            <option value="Design">Design</option>
                            <option value="Business">Business</option>
                            <option value="Languages">Languages</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="course-level">ระดับความยาก (Level) <span>*</span></label>
                        <select id="course-level" required>
                            <option value="Beginner">Beginner (เบื้องต้น)</option>
                            <option value="Intermediate">Intermediate (ปานกลาง)</option>
                            <option value="Advanced">Advanced (ขั้นสูง)</option>
                        </select>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                    <div class="form-group">
                        <label for="course-instructor">ชื่อผู้สอน (Instructor) <span>*</span></label>
                        <input type="text" id="course-instructor" required placeholder="เช่น ดร. สมชาย พัฒนา" />
                    </div>
                    <div class="form-group">
                        <label for="course-units">จำนวนด่าน / บทเรียน (Units)</label>
                        <input type="number" id="course-units" min="1" max="50" value="4" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="course-description">คำอธิบายคอร์สเรียน (Description)</label>
                    <textarea id="course-description" rows="3" placeholder="ระบุเนื้อหาและประโยชน์ที่ผู้เรียนจะได้รับ"></textarea>
                </div>
                <div class="form-group">
                    <label for="course-skills">ทักษะที่ได้รับ (คั่นด้วยจุลภาค ,)</label>
                    <input type="text" id="course-skills" placeholder="เช่น React, Frontend, Web Design" />
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="course-featured" style="width: 18px; height: 18px; accent-color: var(--nimo-blue);" />
                    <label for="course-featured" style="margin: 0; cursor: pointer;">แสดงเป็นคอร์สแนะนำ (Featured Course) บนหน้าแรก</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="course-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-save-course">บันทึกข้อมูลคอร์ส</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 2: Upload Course (JSON / File) Dialog
         ============================================== -->
    <dialog id="course-upload-modal" class="nimo-modal">
        <div class="modal-header">
            <h3>อัปโหลดคอร์สเรียน (Course Import)</h3>
            <button type="button" class="modal-close-btn" data-close-modal="course-upload-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="course-upload-form" method="dialog">
            <div class="modal-body">
                <p style="font-size: 13.5px; color: var(--nimo-slate); margin-top: 0;">
                    คุณสามารถเลือกอัปโหลดไฟล์ <code>.json</code> หรือวางโค้ด JSON ของรายการคอร์สเรียนเพื่อเพิ่มเข้าสู่ระบบพร้อมกันได้ทันที
                </p>
                <div class="form-group">
                    <label for="upload-file-input">เลือกไฟล์ JSON จากเครื่องคอมพิวเตอร์:</label>
                    <input type="file" id="upload-file-input" accept=".json,application/json" style="padding: 8px; border: 1.5px dashed var(--nimo-sky-border); background: #f8fafc;" />
                </div>
                <div class="form-group">
                    <label for="upload-json-text">หรือวางโค้ด JSON ที่นี่:</label>
                    <textarea id="upload-json-text" rows="8" placeholder='[
  {
    "title": "Machine Learning 101",
    "category": "Technology",
    "level": "Beginner",
    "units": 5,
    "featured": true,
    "instructor": "AI Specialist",
    "description": "พื้นฐานปัญญาประดิษฐ์และการเรียนรู้ของเครื่อง",
    "skills": ["AI", "Python"]
  }
]' style="font-family: monospace; font-size: 12px;"></textarea>
                </div>
                <div id="upload-feedback" style="display: none; padding: 10px; border-radius: 8px; font-size: 13px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="course-upload-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-submit-upload">เริ่มนำเข้าข้อมูล</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 3: Add / Edit Question Dialog
         ============================================== -->
    <dialog id="question-modal" class="nimo-modal">
        <div class="modal-header">
            <h3 id="question-modal-title">เพิ่มคำถามแบบฝึกหัดใหม่</h3>
            <button type="button" class="modal-close-btn" data-close-modal="question-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="question-form" method="dialog">
            <input type="hidden" id="question-id" value="" />
            <div class="modal-body">
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 14px;">
                    <div class="form-group">
                        <label for="q-course-id">สังกัดคอร์สเรียน <span>*</span></label>
                        <select id="q-course-id" required>
                            @foreach (var c in Model.Courses)
                            {
                                <option value="@c.Id">@c.Title (@c.Category)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="q-lesson-id">บทเรียนที่ (Lesson)</label>
                        <input type="number" id="q-lesson-id" min="1" max="20" value="1" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="q-prompt">คำถาม (Question Prompt) <span>*</span></label>
                    <textarea id="q-prompt" rows="2" required placeholder="ระบุโจทย์หรือคำถามที่ต้องการให้ผู้เรียนฝึก"></textarea>
                </div>

                <div class="form-group">
                    <label>ตัวเลือกคำตอบ (Choices) &amp; เลือกคำตอบที่ถูกต้อง <span>*</span></label>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="0" id="correct-0" checked title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">A.</span>
                        <input type="text" id="q-choice-0" required placeholder="ตัวเลือกที่ 1" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="1" id="correct-1" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">B.</span>
                        <input type="text" id="q-choice-1" required placeholder="ตัวเลือกที่ 2" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="2" id="correct-2" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">C.</span>
                        <input type="text" id="q-choice-2" required placeholder="ตัวเลือกที่ 3" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="3" id="correct-3" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">D.</span>
                        <input type="text" id="q-choice-3" placeholder="ตัวเลือกที่ 4 (ไม่บังคับ)" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="q-explanation">คำอธิบายเฉลย (Explanation)</label>
                    <textarea id="q-explanation" rows="2" placeholder="อธิบายเหตุผลว่าทำไมข้อนี้จึงถูก เพื่อให้ผู้เรียนได้ความรู้"></textarea>
                </div>

                <div class="form-group">
                    <label for="q-hint">คำใบ้จาก Nimo (Hint for Learner)</label>
                    <input type="text" id="q-hint" placeholder="เช่น สังเกตที่คำบุพบท หรือจำคู่คำ V-ing" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="question-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-save-question">บันทึกคำถาม</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 4: Interactive Quiz Tester with Nimo
         ============================================== -->
    <dialog id="quiz-tester-modal" class="nimo-modal">
        <div class="modal-header">
            <h3>ทดสอบตอบคำถามคู่กับ Nimo 🎮</h3>
            <button type="button" class="modal-close-btn" data-close-modal="quiz-tester-modal" aria-label="ปิด">✕</button>
        </div>
        <div class="modal-body" style="text-align: center;">
            <div style="display: inline-block; position: relative; margin-bottom: 16px;">
                <img src="~/images/nimo-learning.png" alt="Nimo" style="width: 140px; height: 140px; object-fit: contain;" />
                <div id="tester-nimo-bubble" style="position: absolute; right: -70px; top: 10px; background: white; border: 1.5px solid #bae6fd; border-radius: 12px; padding: 6px 12px; font-size: 11.5px; font-weight: 600; color: #0284c7; box-shadow: 0 4px 12px rgba(2,132,199,0.15); white-space: nowrap;">
                    ลองตอบดูเลยนะ! ✨
                </div>
            </div>

            <h3 id="tester-prompt" style="font-size: 17px; margin: 0 0 18px; text-align: left; color: var(--nimo-navy);">คำถาม</h3>

            <div id="tester-choices" style="display: flex; flex-direction: column; gap: 10px; text-align: left;">
                <!-- Choice buttons injected by JS -->
            </div>

            <div id="tester-feedback" style="display: none; margin-top: 18px; padding: 14px; border-radius: 12px; text-align: left; font-size: 13px;">
                <strong id="tester-feedback-title" style="display: block; font-size: 14px; margin-bottom: 4px;"></strong>
                <p id="tester-feedback-text" style="margin: 0; line-height: 1.5;"></p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="quiz-tester-modal">ปิดหน้าต่างทดสอบ</button>
        </div>
    </dialog>

    <!-- Embedded Initial Data for fast interactive client features -->
    <script id="admin-courses-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Courses))</script>
    <script id="admin-questions-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Questions))</script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
</body>
</html>
