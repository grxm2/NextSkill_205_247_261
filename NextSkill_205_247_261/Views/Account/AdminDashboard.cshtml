@model AdminDashboardModel
@{
    Layout = null;
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "A" : System.Globalization.StringInfo.GetNextTextElement(Model.FullName.Trim()).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script>try { document.documentElement.dataset.theme = localStorage.getItem('nextskill.theme.v1') === 'dark' ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
    <title>ศูนย์ควบคุมผู้ดูแล NextSkill | NextSkill Admin</title>
    <link rel="icon" href="~/home-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/Prompt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/Prompt-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-game.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/journey-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-modern.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
</head>
<body class="ns-admin">
    <a class="skip-link" href="#main-content">ข้ามไปเนื้อหาหลัก</a>

    <!-- Living Ocean Ambient Bubbles Layer -->
    <div class="ocean-ambient-bubbles" aria-hidden="true">
        <div class="ocean-bubble"></div>
        <div class="ocean-bubble"></div>
        <div class="ocean-bubble"></div>
        <div class="ocean-bubble"></div>
        <div class="ocean-bubble"></div>
        <div class="ocean-bubble"></div>
    </div>

    <div class="admin-shell">
        <!-- Sidebar Navigation (Deep Ocean Glass) -->
        <aside class="sidebar">
            <a class="brand admin-brand" href="#dashboard" aria-label="NextSkill Admin">
                <img src="~/images/nextskill-navbar-logo.webp" asp-append-version="true" alt="NextSkill" class="admin-brand-logo-img" width="46" height="46" />
                <div class="admin-brand-content">
                    <div class="admin-brand-wordmark-row">
                        <span class="ns-navbar__wordmark admin-brand-wordmark" aria-hidden="true"><partial name="_NextSkillWordmark" /></span>
                        <span class="admin-brand-badge">ADMIN</span>
                    </div>
                    <small class="admin-brand-sub">Control Center · ผู้ดูแลระบบ</small>
                </div>
            </a>

            <div class="nav-section-title">MAIN</div>
            <nav aria-label="Admin navigation" class="admin-nav">
                <a href="#dashboard" class="active" aria-current="page">
                    <span class="nav-icon">
                        <svg class="admin-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                    </span>
                    <span>ภาพรวม</span>
                    <small>Overview</small>
                </a>
            </nav>

            <div class="nav-section-title">COURSES &amp; APPS</div>
            <nav class="admin-nav">
                <a href="#courses">
                    <span class="nav-icon">
                        <svg class="admin-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </span>
                    <span>จัดการคอร์สเรียน</span>
                    <small>@Model.Courses.Count</small>
                </a>
                <a href="#questions">
                    <span class="nav-icon">
                        <svg class="admin-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    </span>
                    <span>แบบฝึกหัด &amp; Quiz</span>
                    <small>@Model.TotalQuestions</small>
                </a>
                <a href="#learners">
                    <span class="nav-icon">
                        <svg class="admin-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </span>
                    <span>รายชื่อผู้เรียน</span>
                    <small>@(Model.Users + Model.Admins)</small>
                </a>
            </nav>

            <div class="nav-section-title">SYSTEM</div>
            <nav class="admin-nav">
                <a href="#settings">
                    <span class="nav-icon">
                        <svg class="admin-svg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                    </span>
                    <span>โปรไฟล์ &amp; ตั้งค่า</span>
                    <small>Settings</small>
                </a>
            </nav>

            <!-- System Quota Card (Matching Reference Screenshot) -->
            <div class="sidebar-quota-card">
                <div class="quota-header">
                    <span>โควตาระบบคอร์ส</span>
                    <strong id="quota-text">@Model.Courses.Count / 20</strong>
                </div>
                <div class="quota-progress-track">
                    <div class="quota-progress-fill" style="width: @(Math.Min(100, (Model.Courses.Count * 100) / 20))%;"></div>
                </div>
                <img src="~/images/nimo-pose-crouch.png" alt="Nimo" class="peeking-mascot" />
            </div>

            <div class="sidebar-account">
                <strong>@Model.FullName</strong>
                <span>@Model.Email</span>
                <form asp-action="Logout" method="post" style="margin-top: 12px;">
                    <button class="ns-button ns-button--secondary ns-button--compact" type="submit" style="width: 100%; justify-content: center;">
                        ออกจากระบบ ↗
                    </button>
                </form>
            </div>
            <div class="sidebar-bottom" style="margin-top: 12px; padding: 0 4px; font-size: 10px; color: #7dd3fc; opacity: 0.8;">
                NextSkill Admin · Upskill &amp; Reskill
            </div>
        </aside>

        <!-- Main Workspace -->
        <div class="workspace">
            <header class="topbar">
                <div class="topbar-search-wrap">
                    <span class="topbar-search-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input type="search" class="topbar-search-input" id="global-admin-search" placeholder="ค้นหาคอร์ส, ผู้เรียน, คำถาม, หรือสถิติ..." />
                    <kbd class="topbar-search-shortcut">Ctrl+K</kbd>
                </div>
                <div class="topbar-actions">
                    <a asp-controller="Home" asp-action="Index" class="admin-pill-btn secondary" target="_blank" title="เปิดหน้าเว็บผู้เรียนในแท็บใหม่" style="font-size: 12px; padding: 7px 14px;">
                        <span>ดูหน้าบ้าน (ผู้เรียน) ↗</span>
                    </a>
                    <button class="journey-theme-toggle admin-theme-toggle" type="button" data-theme-toggle aria-label="สลับธีมกลางคืน/กลางวัน" aria-pressed="false" title="เปิดธีมกลางคืน">
                        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
                        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.5 13.3A8.5 8.5 0 0 1 10.7 3.5a8.5 8.5 0 1 0 9.8 9.8Z"/></svg>
                    </button>
                    <button type="button" class="topbar-icon-btn mascot-btn" id="topbar-mascot-toggle" title="เพื่อนร่วมทาง Nimo">
                        <img src="~/images/nimo-pose-wave.png" alt="Nimo" />
                    </button>
                    <button type="button" class="topbar-icon-btn" id="topbar-bell-btn" title="การแจ้งเตือน">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span class="badge-dot"></span>
                    </button>
                    <div class="admin-user-pill">
                        <span class="avatar">@initial</span>
                        <span class="admin-name-text">@Model.FullName</span>
                        <span class="admin-role-tag">Admin / Owner</span>
                    </div>
                </div>
            </header>

            <!-- Floating Mascot Buddy (Nimo) -->
            <div class="floating-mascot-buddy" id="mascot-buddy-wrap">
                <div class="mascot-speech-bubble" id="mascot-speech" aria-live="polite">
                    สวัสดีครับกัปตัน แดชบอร์ดพร้อมทำงานแล้วครับ
                </div>
                <button type="button" class="mascot-avatar-trigger" id="mascot-trigger-btn" aria-label="เพื่อนร่วมทาง Nimo">
                    <img src="~/images/nimo-rowing.png" alt="Nimo" id="floating-mascot-img" />
                </button>
            </div>

            <main id="main-content" tabindex="-1">
                <!-- ==============================================
                     PANEL 1: Dashboard Overview (Dribbble/Modern Ocean Style)
                     ============================================== -->
                <section id="dashboard" class="admin-panel" data-title="ภาพรวมผู้ดูแลระบบ" aria-label="Dashboard overview">
                    
                    <!-- Dashboard Greeting Row (Matching Screenshot) -->
                    <div class="dashboard-header-row">
                        <div>
                            <h2 class="dashboard-greeting-title" id="greeting-title">
                                สวัสดีตอนบ่าย, คุณ @Model.FullName
                            </h2>
                            <p class="dashboard-greeting-sub">
                                <span id="current-date-th">วันพุธที่ 16 พฤศจิกายน</span> · 
                                <span class="attention-badge">4 รายการที่ต้องการการดูแล</span>
                            </p>
                        </div>
                        <div class="header-action-buttons">
                            <a href="#activity" class="admin-pill-btn secondary" id="btn-quick-activity" style="text-decoration: none;">
                                <span>บันทึกกิจกรรม (Activity log)</span>
                            </a>
                            <button type="button" class="admin-pill-btn primary" id="hero-btn-new-course">
                                <span>+ สร้างคอร์สใหม่</span>
                            </button>
                            <button type="button" class="admin-pill-btn secondary" id="hero-btn-upload-course">
                                <span>นำเข้า JSON</span>
                            </button>
                        </div>
                    </div>

                    <!-- TWO Big Analytics Cards (Matching Reference Screenshot) -->
                    <div class="analytics-main-grid">
                        <!-- Left Big Card: Agency commission / Learning Trends -->
                        <article class="analytics-glass-card">
                            <img src="~/images/nimo-learning.png" alt="Nimo" class="card-perched-mascot" />
                            <div class="chart-card-header">
                                <div class="chart-title-block">
                                    <h3>สถิติการเรียนรู้ &amp; การเติบโต (Learning Trends)</h3>
                                    <p id="chart-sub-text">1,240 ผู้เรียนและกิจกรรม ในช่วง 6 เดือนที่ผ่านมา</p>
                                </div>
                                <div class="chart-controls-wrap">
                                    <div class="chart-period-pill-group">
                                        <button type="button" class="chart-period-btn" data-period="3m">3 เดือน</button>
                                        <button type="button" class="chart-period-btn active" data-period="6m">6 เดือน</button>
                                        <button type="button" class="chart-period-btn" data-period="12m">12 เดือน</button>
                                    </div>
                                    <button type="button" class="admin-pill-btn primary" id="btn-chart-add-deal" style="padding: 6px 14px; font-size: 11.5px; margin-left: 6px;">
                                        <span>+ บันทึกข้อมูลคอร์ส</span>
                                    </button>
                                </div>
                            </div>

                            <div class="bar-chart-container">
                                <div class="chart-y-axis">
                                    <span>$30K</span>
                                    <span>$20K</span>
                                    <span>$10K</span>
                                    <span>$0</span>
                                </div>
                                <div class="chart-bars-wrap" id="chart-bars-container">
                                    <div class="chart-bar-col" data-month="Jun" data-val="$18,400">
                                        <div class="bar-pill" style="height: 48%;"></div>
                                    </div>
                                    <div class="chart-bar-col" data-month="Jul" data-val="$21,200">
                                        <div class="bar-pill" style="height: 56%;"></div>
                                    </div>
                                    <div class="chart-bar-col" data-month="Aug" data-val="$29,800">
                                        <div class="bar-pill" style="height: 78%;"></div>
                                    </div>
                                    <div class="chart-bar-col" data-month="Sep" data-val="$26,500">
                                        <div class="bar-pill" style="height: 70%;"></div>
                                    </div>
                                    <div class="chart-bar-col" data-month="Oct" data-val="$34,100">
                                        <div class="bar-pill" style="height: 88%;"></div>
                                    </div>
                                    <div class="chart-bar-col highlighted" data-month="Nov" data-val="$42,343">
                                        <div class="bar-highlight-tooltip">$42,343</div>
                                        <div class="bar-pill" style="height: 98%;"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="chart-x-labels">
                                <span>มิ.ย.</span>
                                <span>ก.ค.</span>
                                <span>ส.ค.</span>
                                <span>ก.ย.</span>
                                <span>ต.ค.</span>
                                <span>พ.ย.</span>
                            </div>
                        </article>

                        <!-- Right Card: Commission by office / Course Categories Share -->
                        <article class="analytics-glass-card">
                            <img src="~/images/nimo-pose-wave.png" alt="Nimo" class="card-perched-mascot" />
                            <div class="chart-card-header">
                                <div class="chart-title-block">
                                    <h3>สัดส่วนคอร์สตามหมวดหมู่</h3>
                                    <p>Last 6 months · สัดส่วนตามหมวดหมู่ในระบบ</p>
                                </div>
                            </div>

                            <div class="donut-chart-container">
                                <div class="donut-svg-wrap">
                                    <svg class="donut-svg" viewBox="0 0 100 100">
                                        <circle class="donut-circle-bg" cx="50" cy="50" r="38"></circle>
                                        <!-- Technology: 42% (dash: 100, gap: 138) -->
                                        <circle class="donut-segment" cx="50" cy="50" r="38" stroke="#0284c7" stroke-dasharray="100 138" stroke-dashoffset="0"></circle>
                                        <!-- Design: 28% (dash: 67, gap: 171) -->
                                        <circle class="donut-segment" cx="50" cy="50" r="38" stroke="#10b981" stroke-dasharray="67 171" stroke-dashoffset="-100"></circle>
                                        <!-- Business: 18% (dash: 43, gap: 195) -->
                                        <circle class="donut-segment" cx="50" cy="50" r="38" stroke="#f59e0b" stroke-dasharray="43 195" stroke-dashoffset="-167"></circle>
                                        <!-- Languages: 12% (dash: 28, gap: 210) -->
                                        <circle class="donut-segment" cx="50" cy="50" r="38" stroke="#8b5cf6" stroke-dasharray="28 210" stroke-dashoffset="-210"></circle>
                                    </svg>
                                    <div class="donut-center-info">
                                        <span class="donut-center-val" id="donut-center-num">@Model.Courses.Count</span>
                                        <span class="donut-center-label">คอร์สเรียน</span>
                                    </div>
                                </div>

                                <div class="category-legend-grid">
                                    <div class="legend-item">
                                        <span class="legend-name">
                                            <span class="legend-color-dot" style="background: #0284c7;"></span> Technology
                                        </span>
                                        <span class="legend-val">$43.2K · 42%</span>
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-name">
                                            <span class="legend-color-dot" style="background: #10b981;"></span> Design
                                        </span>
                                        <span class="legend-val">$28.5K · 28%</span>
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-name">
                                            <span class="legend-color-dot" style="background: #f59e0b;"></span> Business
                                        </span>
                                        <span class="legend-val">$19.1K · 18%</span>
                                    </div>
                                    <div class="legend-item">
                                        <span class="legend-name">
                                            <span class="legend-color-dot" style="background: #8b5cf6;"></span> Languages
                                        </span>
                                        <span class="legend-val">$12.4K · 12%</span>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>

                    <!-- 8 Metric Cards Grid (4x2 Frosted Cards matching Screenshot) -->
                    <div class="metric-grid-eight">
                        <!-- 1. Active Learners -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-learning.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold" data-count="11">11</strong>
                            <h4 class="metric-label-title">ผู้เรียนที่กำลังออนไลน์</h4>
                            <p class="metric-desc-sub">
                                <span class="live-pulse-dot"></span> 3 online right now
                            </p>
                        </article>

                        <!-- 2. Waiting for review -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-pose-jump.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon amber">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold" data-count="6">6</strong>
                            <h4 class="metric-label-title">รอการตรวจสอบ</h4>
                            <p class="metric-desc-sub">oldest sent 4 h ago</p>
                        </article>

                        <!-- 3. Open Units & Islands -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-rowing.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon teal">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold" id="metric-lessons-count" data-count="@Model.TotalLessons">@Model.TotalLessons</strong>
                            <h4 class="metric-label-title">ด่าน &amp; เกาะที่เปิดสอน</h4>
                            <p class="metric-desc-sub">ความรู้ในทะเล NextSkill</p>
                        </article>

                        <!-- 4. Total Platform Learning / Agency -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-mascot.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                                </span>
                                <span class="metric-trend-pill">↗ 7%</span>
                            </div>
                            <strong class="metric-number-bold">$42,343</strong>
                            <h4 class="metric-label-title">ยอดการฝึกทำบทเรียน</h4>
                            <p class="metric-desc-sub">7% more than last month</p>
                        </article>

                        <!-- 5. New Leads / Learners -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-pose-wave.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon purple">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                                </span>
                                <span class="metric-trend-pill">↗ +14%</span>
                            </div>
                            <strong class="metric-number-bold" data-count="@(Model.NewUsersThisMonth > 0 ? Model.NewUsersThisMonth : 108)">@(Model.NewUsersThisMonth > 0 ? Model.NewUsersThisMonth : 108)</strong>
                            <h4 class="metric-label-title">ผู้เรียนใหม่เดือนนี้</h4>
                            <p class="metric-desc-sub">last 7 days vs the 7 before</p>
                        </article>

                        <!-- 6. Island Completion Rate -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-learning.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon teal">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold">78.4%</strong>
                            <h4 class="metric-label-title">อัตราเรียนจบเกาะ</h4>
                            <p class="metric-desc-sub">820 ด่านสำเร็จใน 30 วัน</p>
                        </article>

                        <!-- 7. Quiz & Practice Questions -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-pose-jump.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon amber">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold" id="metric-questions-count" data-count="@Model.TotalQuestions">@Model.TotalQuestions</strong>
                            <h4 class="metric-label-title">แบบฝึกหัดในคลัง</h4>
                            <p class="metric-desc-sub">พร้อมฝึกตอบกับ Nimo</p>
                        </article>

                        <!-- 8. System Uptime -->
                        <article class="metric-card-modern">
                            <img src="~/images/nimo-mascot.png" alt="Nimo" class="metric-peek-mascot" />
                            <div class="metric-card-top">
                                <span class="metric-modern-icon green">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                                </span>
                            </div>
                            <strong class="metric-number-bold">99.98%</strong>
                            <h4 class="metric-label-title">ความพร้อมของระบบ</h4>
                            <p class="metric-desc-sub">LocalDB &amp; Web ปกติ</p>
                        </article>
                    </div>

                    <!-- Course Performance & Quick Tasks -->
                    <div class="overview-grid">
                        <section class="performance outlined-card" aria-labelledby="quick-courses-title" style="padding: 24px;">
                            <div class="section-heading">
                                <h2 id="quick-courses-title">คอร์สเรียนล่าสุด</h2>
                                <a href="#courses" class="ns-button ns-button--secondary ns-button--compact">ดูทั้งหมด (@Model.Courses.Count) →</a>
                            </div>
                            <div class="table-scroll">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>ชื่อคอร์ส</th>
                                            <th>หมวดหมู่</th>
                                            <th>ระดับ</th>
                                            <th>จำนวนด่าน</th>
                                            <th>ผู้สอน</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.Courses.Take(5))
                                        {
                                            <tr>
                                                <td><strong>@c.Title</strong></td>
                                                <td><span class="status-badge">@c.Category</span></td>
                                                <td>@c.Level</td>
                                                <td>@(c.Lessons?.Count ?? c.Units) ด่าน</td>
                                                <td>@c.Instructor</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </section>

                        <section class="task-section outlined-card" aria-labelledby="admin-tasks-title" style="padding: 24px;">
                            <div class="section-heading">
                                <h2 id="admin-tasks-title">เมนูด่วนผู้ดูแล</h2>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                <a href="#courses" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>จัดการคอร์สเรียนและนำเข้า</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                                <a href="#questions" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>จัดการแบบฝึกหัดและข้อสอบ</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                                <a href="#learners" class="ns-button ns-button--secondary ns-button--compact" style="justify-content: flex-start; padding: 12px 16px;">
                                    <span>รายชื่อและข้อมูลผู้เรียน (@Model.Users คน)</span>
                                    <span style="margin-left: auto;">↗</span>
                                </a>
                            </div>
                        </section>
                    </div>

                    <!-- Recent Activity -->
                    <section class="activity-section outlined-card" aria-labelledby="activity-title" style="padding: 24px; margin-top: 24px;">
                        <div class="section-heading">
                            <h2 id="activity-title">กิจกรรมล่าสุดในระบบ (Recent Activity)</h2>
                            <span class="subtle">การสมัครสมาชิกและการเข้าสู่ระบบ</span>
                        </div>
                        <div class="activity-card" style="padding: 0;">
                            @if (Model.Activities.Count == 0)
                            {
                                <p class="empty-message">ยังไม่มีบันทึกกิจกรรมล่าสุด</p>
                            }
                            @foreach (var item in Model.Activities)
                            {
                                <div class="activity-row">
                                    <time datetime="@item.OccurredAt.ToString("O")" data-local-time>@item.OccurredAt.ToString("dd MMM HH:mm") UTC</time>
                                    <p><strong>@item.FullName</strong> @item.Action</p>
                                    <span class="activity-tag">@item.Role</span>
                                </div>
                            }
                        </div>
                    </section>
                </section>

                <!-- ==============================================
                     PANEL 2: Course Library & Management
                     ============================================== -->
                <section id="courses" class="admin-panel" data-title="จัดการคอร์สเรียน &amp; อัปโหลด" aria-labelledby="courses-heading" hidden>
                    <div class="section-heading">
                        <div>
                            <h2 id="courses-heading">คลังคอร์สเรียน (Course Library)</h2>
                            <span class="subtle">มีทั้งหมด <strong id="course-total-badge">@Model.Courses.Count</strong> คอร์สในระบบ</span>
                        </div>
                        <div class="section-heading-actions">
                            <a href="/Home/Courses" target="_blank" class="ns-button ns-button--secondary ns-button--compact" title="เปิดดูหน้ารวมคอร์สของผู้เรียนในแท็บใหม่" style="text-decoration: none;">
                                <span>ดูคลังคอร์สผู้เรียน ↗</span>
                            </a>
                            <button type="button" class="ns-button ns-button--secondary ns-button--compact" id="btn-open-upload-modal">
                                <span>นำเข้าคอร์ส (JSON)</span>
                            </button>
                            <button type="button" class="ns-button ns-button--primary ns-button--compact" id="btn-open-course-modal">
                                <span>+ สร้างคอร์สใหม่</span>
                            </button>
                        </div>
                    </div>

                    <!-- Search and filters -->
                    <div class="outlined-card" style="margin-bottom: 20px; padding: 16px 20px; display: flex; flex-wrap: wrap; gap: 14px; align-items: center;">
                        <input type="search" id="course-search-input" placeholder="ค้นหาชื่อคอร์ส, ผู้สอน หรือหมวดหมู่..." style="padding: 9px 14px; border: 1.5px solid var(--nimo-sky-border); border-radius: 12px;" />
                        <select id="course-category-filter" style="padding: 9px 14px; border: 1.5px solid var(--nimo-sky-border); border-radius: 12px; font-size: 13.5px; background: white;">
                            <option value="">ทุกหมวดหมู่ (All Categories)</option>
                            <option value="Technology">Technology</option>
                            <option value="Design">Design</option>
                            <option value="Business">Business</option>
                            <option value="Languages">Languages</option>
                        </select>
                    </div>

                    <!-- Courses Table -->
                    <div class="outlined-card" style="padding: 0;">
                        <div class="table-scroll">
                            <table id="courses-main-table">
                                <thead>
                                    <tr>
                                        <th>รหัส</th>
                                        <th>ชื่อคอร์สเรียน</th>
                                        <th>หมวดหมู่</th>
                                        <th>ระดับ</th>
                                        <th>จำนวนด่าน</th>
                                        <th>ผู้สอน</th>
                                        <th>สถานะแนะนำ</th>
                                        <th style="text-align: right;">จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody id="courses-table-body">
                                    @foreach (var course in Model.Courses)
                                    {
                                        <tr data-course-row data-id="@course.Id" data-category="@course.Category" data-title="@course.Title.ToLowerInvariant()" data-instructor="@course.Instructor.ToLowerInvariant()">
                                            <td><span class="status-badge">#@course.Id</span></td>
                                            <td>
                                                <strong style="font-size: 14px; color: var(--nimo-navy);">@course.Title</strong>
                                                @if (!string.IsNullOrWhiteSpace(course.VideoUrl))
                                                {
                                                    <span class="status-badge" style="background: rgba(14, 165, 233, 0.15); color: #0284c7; border: 1px solid #bae6fd; font-size: 11px; margin-left: 6px;" title="มีสื่อวิดีโอการเรียนรู้">▶ มีวิดีโอ</span>
                                                }
                                                <p style="margin: 3px 0 0; font-size: 12px; color: var(--nimo-muted); max-width: 320px; white-space: normal;">@course.Description</p>
                                            </td>
                                            <td><span class="status-badge published">@course.Category</span></td>
                                            <td>@course.Level</td>
                                            <td>@(course.Lessons?.Count ?? course.Units) ด่าน</td>
                                            <td>@course.Instructor</td>
                                            <td>
                                                @if (course.Featured)
                                                {
                                                    <span class="status-badge yellow">แนะนำ</span>
                                                }
                                                else
                                                {
                                                    <span style="color: var(--nimo-muted); font-size: 12px;">ทั่วไป</span>
                                                }
                                            </td>
                                            <td style="text-align: right; white-space: nowrap;">
                                                <a href="/Home/Details/@course.Id" target="_blank" class="ns-button ns-button--secondary ns-button--compact" title="เปิดดูหน้ารายละเอียดคอร์สนี้ในมุมมองของผู้เรียน" style="text-decoration: none;">ดูหน้าจริง</a>
                                                <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-edit-course" data-id="@course.Id">แก้ไข</button>
                                                <button type="button" class="ns-button ns-button--danger ns-button--compact btn-delete-course" data-id="@course.Id" data-title="@course.Title">ลบ</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>

                <!-- ==============================================
                     PANEL 3: Question & Quiz Studio
                     ============================================== -->
                <section id="questions" class="admin-panel" data-title="จัดการแบบฝึกหัด &amp; คำถาม" aria-labelledby="questions-heading" hidden>
                    <div class="section-heading">
                        <div>
                            <h2 id="questions-heading">คลังแบบฝึกหัด &amp; คำถาม (Quiz &amp; Question Studio)</h2>
                            <span class="subtle">มีทั้งหมด <strong id="question-total-badge">@Model.TotalQuestions</strong> ข้อในระบบ สำหรับฝึกคู่กับ Nimo</span>
                        </div>
                        <div class="section-heading-actions">
                            <button type="button" class="ns-button ns-button--primary ns-button--compact" id="btn-open-question-modal">
                                <span>+ เพิ่มคำถามใหม่</span>
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar -->
                    <div class="outlined-card" style="padding: 0; margin-bottom: 22px;">
                        <div class="quiz-filter-bar">
                            <span style="font-size: 13px; font-weight: 600; color: var(--nimo-slate);">เลือกคอร์ส:</span>
                            <select id="question-course-filter">
                                <option value="0">ทุกคอร์ส (All Courses)</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option value="@c.Id">@c.Title (@c.Category)</option>
                                }
                            </select>

                            <input type="search" id="question-search-input" placeholder="ค้นหาเนื้อหาคำถามหรือเฉลย..." />
                        </div>

                        <!-- Questions Grid -->
                        <div class="quiz-cards-grid" id="questions-container">
                            @foreach (var q in Model.Questions)
                            {
                                <div class="question-studio-card" data-question-card data-id="@q.Id" data-course-id="@q.CourseId" data-prompt="@q.Prompt.ToLowerInvariant()">
                                    <div class="question-meta-row">
                                        <span class="question-course-tag">@q.CourseTitle · บทที่ @q.LessonId</span>
                                        <span style="font-size: 11px; color: var(--nimo-muted);">รหัส: @q.Id</span>
                                    </div>

                                    <h4 class="question-prompt">@q.Prompt</h4>

                                    <div class="question-choices-list">
                                        @for (int i = 0; i < q.Choices.Count; i++)
                                        {
                                            var isCorrect = i == q.CorrectChoice;
                                            <div class="choice-item @(isCorrect ? "correct" : "")">
                                                <span class="choice-letter">@((char)('A' + i))</span>
                                                <span>@q.Choices[i]</span>
                                                @if (isCorrect)
                                                {
                                                    <span style="margin-left: auto; font-size: 11px; font-weight: 700; color: #047857;">คำตอบที่ถูกต้อง</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(q.Explanation))
                                    {
                                        <div class="question-note-box">
                                            <strong>คำอธิบายเมื่อผู้เรียนตอบ:</strong>
                                            <span>@q.Explanation</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(q.Hint))
                                    {
                                        <div style="font-size: 12px; color: var(--nimo-muted); background: #fefce8; border: 1px solid #fef08a; padding: 7px 10px; border-radius: 8px;">
                                            <strong style="color: #b45309;">คำใบ้จาก Nimo:</strong> @q.Hint
                                        </div>
                                    }

                                    <div class="question-card-footer">
                                        <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-test-quiz" data-id="@q.Id" style="font-size: 12px;">
                                            <span>ทดสอบตอบ</span>
                                        </button>
                                        <div style="display: flex; gap: 8px;">
                                            <button type="button" class="ns-button ns-button--secondary ns-button--compact btn-edit-question" data-id="@q.Id">แก้ไข</button>
                                            <button type="button" class="ns-button ns-button--danger ns-button--compact btn-delete-question" data-id="@q.Id">ลบ</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </section>

                <!-- ==============================================
                     PANEL 4: Learners & Accounts Directory
                     ============================================== -->
                <section id="learners" class="admin-panel" data-title="รายชื่อผู้เรียน &amp; บัญชี" aria-labelledby="members-heading" hidden>
                    <div class="section-heading directory-heading">
                        <div>
                            <h2 id="members-heading">รายชื่อสมาชิกในระบบ (Account Directory)</h2>
                            <p class="subtle">มีผู้เรียน @Model.Users คน · ผู้ดูแล @Model.Admins คน · แสดงรายการล่าสุด 100 รายการ</p>
                        </div>
                        <div class="directory-controls">
                            <label for="member-search" class="sr-only">ค้นหา</label>
                            <input id="member-search" type="search" placeholder="ค้นหาชื่อหรืออีเมล..." />
                            <label for="member-role" class="sr-only">ประเภทบัญชี</label>
                            <select id="member-role">
                                <option value="all">ทุกประเภท (All)</option>
                                <option value="User">ผู้เรียน (User)</option>
                                <option value="Admin">ผู้ดูแลระบบ (Admin)</option>
                            </select>
                        </div>
                    </div>
                    <div class="outlined-card table-scroll" style="padding: 0;">
                        <table class="members-table">
                            <thead>
                                <tr>
                                    <th>ชื่อ-นามสกุล</th>
                                    <th>อีเมล (Email)</th>
                                    <th>สิทธิ์บัญชี</th>
                                    <th>วันที่เข้าร่วม</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members)
                                {
                                    <tr data-member data-role="@member.Role">
                                        <td><strong>@member.FullName</strong></td>
                                        <td>@member.Email</td>
                                        <td>
                                            <span class="status-badge @(member.Role == "Admin" ? "published" : "")">
                                                @(member.Role == "Admin" ? "ผู้ดูแล" : "ผู้เรียน")
                                            </span>
                                        </td>
                                        <td><time datetime="@member.CreatedAt.ToString("O")" data-local-date>@member.CreatedAt.ToString("dd MMM yyyy")</time></td>
                                    </tr>
                                }
                                <tr id="no-members" hidden="@(Model.Members.Count > 0)">
                                    <td colspan="4" class="empty-message">ไม่พบบัญชีที่ตรงกับคำค้นหา</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <p class="subtle" id="member-count" aria-live="polite" style="margin-top: 10px;">แสดง @Model.Members.Count บัญชี</p>
                </section>

                <!-- ==============================================
                     PANEL 5: Admin Profile & Settings
                     ============================================== -->
                <section id="settings" class="admin-panel" data-title="ข้อมูลบัญชีผู้ดูแล &amp; ตั้งค่า" aria-labelledby="settings-heading" hidden>
                    <div class="section-heading">
                        <h2 id="settings-heading">บัญชีผู้ดูแลระบบ (Admin Profile)</h2>
                    </div>
                    <div class="outlined-card settings-card" style="padding: 28px;">
                        <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 24px;">
                            <span class="avatar large-avatar" style="width: 56px; height: 56px; font-size: 22px;">@initial</span>
                            <div>
                                <h3 style="margin: 0 0 4px; font-size: 20px;">@Model.FullName</h3>
                                <span class="status-badge published">ผู้ดูแลระบบ (System Administrator)</span>
                            </div>
                        </div>
                        <dl style="border-top: 1px solid #f1f5f9; padding-top: 20px;">
                            <dt style="font-weight: 600; color: var(--nimo-muted);">อีเมลผู้ดูแล:</dt>
                            <dd style="margin: 0; font-weight: 500;">@Model.Email</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">สิทธิ์การใช้งาน:</dt>
                            <dd style="margin: 0; color: #047857; font-weight: 600;">เต็มรูปแบบ (Full Admin Access)</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">ระบบฐานข้อมูล:</dt>
                            <dd style="margin: 0;">NextSkill Database &amp; LocalDB MSSQL</dd>
                            <dt style="font-weight: 600; color: var(--nimo-muted);">สถานะระบบ:</dt>
                            <dd style="margin: 0; color: #047857; font-weight: 600;">● ปกติ (Online &amp; Active)</dd>
                        </dl>
                        <form asp-action="Logout" method="post" style="margin-top: 28px; border-top: 1px solid #f1f5f9; padding-top: 20px;">
                            <button type="submit" class="ns-button ns-button--danger ns-button--compact" style="padding: 10px 22px; font-size: 13.5px;">ออกจากระบบ</button>
                        </form>
                    </div>
                </section>
            </main>
        </div>
    </div>

    <!-- ==============================================
         MODAL 1: Add / Edit Course Dialog
         ============================================== -->
    <dialog id="course-modal" class="nimo-modal">
        <div class="modal-header">
            <h3 id="course-modal-title">สร้างคอร์สเรียนใหม่</h3>
            <button type="button" class="modal-close-btn" data-close-modal="course-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="course-form" method="dialog">
            <input type="hidden" id="course-id" value="0" />
            <div class="modal-body">
                <div class="form-group">
                    <label for="course-title">ชื่อคอร์สเรียน (Title) <span>*</span></label>
                    <input type="text" id="course-title" required placeholder="เช่น Next.js 15 Fullstack Mastery" />
                </div>
                <div class="admin-form-row">
                    <div class="form-group">
                        <label for="course-category">หมวดหมู่ (Category) <span>*</span></label>
                        <select id="course-category" required>
                            <option value="Technology">Technology</option>
                            <option value="Design">Design</option>
                            <option value="Business">Business</option>
                            <option value="Languages">Languages</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="course-level">ระดับความยาก (Level) <span>*</span></label>
                        <select id="course-level" required>
                            <option value="Beginner">Beginner (เบื้องต้น)</option>
                            <option value="Intermediate">Intermediate (ปานกลาง)</option>
                            <option value="Advanced">Advanced (ขั้นสูง)</option>
                        </select>
                    </div>
                </div>
                <div class="admin-form-row">
                    <div class="form-group">
                        <label for="course-instructor">ชื่อผู้สอน (Instructor) <span>*</span></label>
                        <input type="text" id="course-instructor" required placeholder="เช่น ดร. สมชาย พัฒนา" />
                    </div>
                    <div class="form-group">
                        <label for="course-units">จำนวนด่าน / บทเรียน (Units)</label>
                        <input type="number" id="course-units" min="1" max="50" value="4" />
                    </div>
                </div>
                <div class="form-group">
                    <label for="course-description">คำอธิบายคอร์สเรียน (Description)</label>
                    <textarea id="course-description" rows="3" placeholder="ระบุเนื้อหาและประโยชน์ที่ผู้เรียนจะได้รับ"></textarea>
                </div>
                <div class="form-group">
                    <label for="course-skills">ทักษะที่ได้รับ (คั่นด้วยจุลภาค ,)</label>
                    <input type="text" id="course-skills" placeholder="เช่น React, Frontend, Web Design" />
                </div>
                <div class="form-group">
                    <label for="course-video-url">
                        <span style="display: inline-flex; align-items: center; gap: 6px;">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                            สื่อการเรียนรู้วิดีโอ (Video URL / YouTube / MP4)
                        </span>
                    </label>
                    <input type="url" id="course-video-url" placeholder="เช่น https://www.youtube.com/watch?v=... หรือไฟล์วิดีโอ .mp4" />
                    <small style="color: var(--adm-accent-blue); font-size: 11.5px; display: block; margin-top: 5px;">
                        ใส่ลิงก์ YouTube, Vimeo หรือไฟล์ .mp4 เพื่อให้ผู้เรียนรับชมวิดีโอในหน้ารายละเอียดคอร์ส
                    </small>
                </div>
                <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="course-featured" style="width: 18px; height: 18px; accent-color: var(--nimo-blue);" />
                    <label for="course-featured" style="margin: 0; cursor: pointer;">แสดงเป็นคอร์สแนะนำ (Featured Course) บนหน้าแรก</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="course-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-save-course">บันทึกข้อมูลคอร์ส</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 2: Upload Course (JSON / File) Dialog
         ============================================== -->
    <dialog id="course-upload-modal" class="nimo-modal">
        <div class="modal-header">
            <h3>อัปโหลดคอร์สเรียน (Course Import)</h3>
            <button type="button" class="modal-close-btn" data-close-modal="course-upload-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="course-upload-form" method="dialog">
            <div class="modal-body">
                <p style="font-size: 13.5px; color: var(--nimo-slate); margin-top: 0;">
                    คุณสามารถเลือกอัปโหลดไฟล์ <code>.json</code> หรือวางโค้ด JSON ของรายการคอร์สเรียนเพื่อเพิ่มเข้าสู่ระบบพร้อมกันได้ทันที
                </p>
                <div class="form-group">
                    <label for="upload-file-input">เลือกไฟล์ JSON จากเครื่องคอมพิวเตอร์:</label>
                    <input type="file" id="upload-file-input" accept=".json,application/json" style="padding: 8px; border: 1.5px dashed var(--nimo-sky-border); background: #f8fafc;" />
                </div>
                <div class="form-group">
                    <label for="upload-json-text">หรือวางโค้ด JSON ที่นี่:</label>
                    <textarea id="upload-json-text" rows="8" placeholder='[
  {
    "title": "Machine Learning 101",
    "category": "Technology",
    "level": "Beginner",
    "units": 5,
    "featured": true,
    "instructor": "AI Specialist",
    "description": "พื้นฐานปัญญาประดิษฐ์และการเรียนรู้ของเครื่อง",
    "skills": ["AI", "Python"]
  }
]' style="font-family: monospace; font-size: 12px;"></textarea>
                </div>
                <div id="upload-feedback" style="display: none; padding: 10px; border-radius: 8px; font-size: 13px;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="course-upload-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-submit-upload">เริ่มนำเข้าข้อมูล</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 3: Add / Edit Question Dialog
         ============================================== -->
    <dialog id="question-modal" class="nimo-modal">
        <div class="modal-header">
            <h3 id="question-modal-title">เพิ่มคำถามแบบฝึกหัดใหม่</h3>
            <button type="button" class="modal-close-btn" data-close-modal="question-modal" aria-label="ปิด">✕</button>
        </div>
        <form id="question-form" method="dialog">
            <input type="hidden" id="question-id" value="" />
            <div class="modal-body">
                <div class="admin-form-row admin-form-row--wide-first">
                    <div class="form-group">
                        <label for="q-course-id">สังกัดคอร์สเรียน <span>*</span></label>
                        <select id="q-course-id" required>
                            @foreach (var c in Model.Courses)
                            {
                                <option value="@c.Id">@c.Title (@c.Category)</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="q-lesson-id">บทเรียนที่ (Lesson)</label>
                        <input type="number" id="q-lesson-id" min="1" max="20" value="1" required />
                    </div>
                </div>

                <div class="form-group">
                    <label for="q-prompt">คำถาม (Question Prompt) <span>*</span></label>
                    <textarea id="q-prompt" rows="2" required placeholder="ระบุโจทย์หรือคำถามที่ต้องการให้ผู้เรียนฝึก"></textarea>
                </div>

                <div class="form-group">
                    <label>ตัวเลือกคำตอบ (Choices) &amp; เลือกคำตอบที่ถูกต้อง <span>*</span></label>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="0" id="correct-0" checked title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">A.</span>
                        <input type="text" id="q-choice-0" required placeholder="ตัวเลือกที่ 1" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="1" id="correct-1" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">B.</span>
                        <input type="text" id="q-choice-1" required placeholder="ตัวเลือกที่ 2" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="2" id="correct-2" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">C.</span>
                        <input type="text" id="q-choice-2" required placeholder="ตัวเลือกที่ 3" />
                    </div>
                    <div class="choice-input-row">
                        <input type="radio" name="q-correct" value="3" id="correct-3" title="คำตอบที่ถูกต้อง" />
                        <span style="font-weight: 700; color: #64748b; width: 18px;">D.</span>
                        <input type="text" id="q-choice-3" placeholder="ตัวเลือกที่ 4 (ไม่บังคับ)" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="q-explanation">คำอธิบายเฉลย (Explanation)</label>
                    <textarea id="q-explanation" rows="2" placeholder="อธิบายเหตุผลว่าทำไมข้อนี้จึงถูก เพื่อให้ผู้เรียนได้ความรู้"></textarea>
                </div>

                <div class="form-group">
                    <label for="q-hint">คำใบ้จาก Nimo (Hint for Learner)</label>
                    <input type="text" id="q-hint" placeholder="เช่น สังเกตที่คำบุพบท หรือจำคู่คำ V-ing" />
                </div>

                <div class="form-group">
                    <label for="q-coaching">แนวคิดที่ Nimo ใช้ช่วยสอน</label>
                    <textarea id="q-coaching" rows="2" placeholder="อธิบายหลักคิดหรือยกตัวอย่างใกล้เคียง เพื่อให้ผู้เรียนลองหาคำตอบเอง"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="question-modal">ยกเลิก</button>
                <button type="submit" class="ns-button ns-button--primary ns-button--compact" id="btn-save-question">บันทึกคำถาม</button>
            </div>
        </form>
    </dialog>

    <!-- ==============================================
         MODAL 4: Interactive Quiz Tester with Nimo
         ============================================== -->
    <dialog id="quiz-tester-modal" class="nimo-modal">
        <div class="modal-header">
            <h3>ทดสอบตอบคำถามคู่กับ Nimo</h3>
            <button type="button" class="modal-close-btn" data-close-modal="quiz-tester-modal" aria-label="ปิด">✕</button>
        </div>
        <div class="modal-body" style="text-align: center;">
            <div style="display: inline-block; position: relative; margin-bottom: 16px;">
                <img src="~/images/nimo-learning.png" alt="Nimo" style="width: 140px; height: 140px; object-fit: contain;" />
                <div id="tester-nimo-bubble" style="position: absolute; right: -70px; top: 10px; background: white; border: 1.5px solid #bae6fd; border-radius: 12px; padding: 6px 12px; font-size: 11.5px; font-weight: 600; color: #0284c7; box-shadow: 0 4px 12px rgba(2,132,199,0.15); white-space: nowrap;">
                    ลองเลือกคำตอบที่ถูกต้องได้เลย
                </div>
            </div>

            <h3 id="tester-prompt" style="font-size: 17px; margin: 0 0 18px; text-align: left; color: var(--nimo-navy);">คำถาม</h3>

            <div id="tester-choices" style="display: flex; flex-direction: column; gap: 10px; text-align: left;">
                <!-- Choice buttons injected by JS -->
            </div>

            <div id="tester-feedback" style="display: none; margin-top: 18px; padding: 14px; border-radius: 12px; text-align: left; font-size: 13px;">
                <strong id="tester-feedback-title" style="display: block; font-size: 14px; margin-bottom: 4px;"></strong>
                <p id="tester-feedback-text" style="margin: 0; line-height: 1.5;"></p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="ns-button ns-button--secondary ns-button--compact" data-close-modal="quiz-tester-modal">ปิดหน้าต่างทดสอบ</button>
        </div>
    </dialog>

    <!-- Embedded Initial Data for fast interactive client features -->
    <script id="admin-courses-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Courses, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <script id="admin-questions-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Questions, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))</script>
    <script src="~/lib/gsap/gsap.min.js"></script>
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
</body>
</html>
