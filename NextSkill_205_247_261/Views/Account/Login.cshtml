@model LoginForm
@{
    Layout = "_AccountLayout";
    var admin = (string?)ViewData["Role"] == "Admin";
    ViewData["Title"] = admin ? "เข้าสู่ระบบผู้ดูแล" : "เข้าสู่ระบบผู้เรียน";
    ViewData["AccountPageClass"] = "ns-login-page";
    ViewData["CompactAccountStory"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/login-nimo.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/login-nimo.js" asp-append-version="true" defer></script>
}

<div class="auth-grid">
    <section class="auth-form nimo-auth-card" aria-labelledby="form-heading">
        <h2 id="form-heading">@ViewData["Title"]</h2>
        <p class="form-intro">@(admin ? "ใช้บัญชีผู้ดูแลเพื่อจัดการคอร์สและข้อสอบ" : "เข้าสู่ระบบเพื่อบันทึกความคืบหน้าและกลับมาเรียนต่อ")</p>
        
        <nav class="login-account-types" aria-label="ประเภทบัญชี">
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" aria-current="@(!admin ? "page" : null)">
                ผู้เรียน
            </a>
            <a asp-action="AdminLogin" asp-route-returnUrl="@Model.ReturnUrl" aria-current="@(admin ? "page" : null)">
                ผู้ดูแลระบบ
            </a>
        </nav>

        @if (TempData["Success"] is string success)
        { 
            <div class="success-message" role="status">
                <span class="success-icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
                <span>@success</span>
            </div> 
        }

        <form asp-controller="Account" asp-action="@(admin ? "AdminLogin" : "Login")" method="post" class="login-core-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
            
            <div class="field">
                <label asp-for="Email">อีเมล <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </span>
                    <input asp-for="Email" type="email" autocomplete="username" required maxlength="@RegisterForm.EmailMaximumLength" />
                </div>
            </div>

            <div class="field">
                <label asp-for="Password">รหัสผ่าน <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </span>
                    <input asp-for="Password" id="Password" type="password" autocomplete="current-password" required maxlength="@RegisterForm.PasswordMaximumLength" />
                    <button class="password-toggle-eye" type="button" data-target="Password" aria-label="แสดง/ซ่อนรหัสผ่าน" aria-pressed="false" title="แสดง/ซ่อนรหัสผ่าน">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="check-row">
                <input asp-for="RememberMe" id="RememberMe" />
                <label asp-for="RememberMe" for="RememberMe">จำการเข้าสู่ระบบในเบราว์เซอร์นี้</label>
            </div>

            <button type="submit" class="btn-auth-submit">
                <span>เข้าสู่ระบบ</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
        </form>

        <div class="guest-divider">
            <span>หรือ</span>
        </div>

        <a class="btn-skip-outline" asp-controller="Home" asp-action="Index">
            <span>กลับหน้าแรกโดยไม่เข้าสู่ระบบ</span>
            <span class="guest-arrow" aria-hidden="true">→</span>
        </a>

        <p class="switch-form">
            ยังไม่มีบัญชี
            <a asp-action="@(admin ? "AdminRegister" : "Register")" asp-route-returnUrl="@Model.ReturnUrl">
                @(admin ? "สมัครด้วยรหัสเชิญ" : "สมัครบัญชีผู้เรียน")
            </a>
        </p>
    </section>
    <partial name="_AccountStory" />
</div>
