@model LoginForm
@{
    Layout = "_AccountLayout";
    var admin = (string?)ViewData["Role"] == "Admin";
    ViewData["Title"] = admin ? "เข้าสู่ระบบผู้ดูแล (Admin)" : "เข้าสู่ระบบ";
}
<div class="auth-grid">
    <partial name="_AccountStory" />
    <section class="auth-form nimo-auth-card" aria-labelledby="form-heading">
        <div class="form-header-badge">
            <span class="badge-dot"></span>
            <span>@(admin ? "ADMIN ACCESS · ระบบผู้ดูแล" : "WELCOME BACK · ยินดีต้อนรับกลับ")</span>
        </div>
        <h2 id="form-heading">@(admin ? "เข้าสู่ระบบผู้ดูแล" : "ยินดีต้อนรับกลับมา")</h2>
        <p class="form-intro">@(admin ? "เข้าสู่ระบบเพื่อจัดการเนื้อหาและผู้เรียนใน NextSkill" : "เข้าสู่ระบบเพื่อออกเดินทางต่อในเส้นทางของคุณกับ Nimo")</p>
        
        <nav class="account-types" aria-label="ประเภทบัญชี">
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="@(!admin ? "active" : "")" aria-current="@(!admin ? "page" : null)">
                <span class="type-icon">🎒</span> ผู้เรียนทั่วไป (User)
            </a>
            <a asp-action="AdminLogin" asp-route-returnUrl="@Model.ReturnUrl" class="@(admin ? "active" : "")" aria-current="@(admin ? "page" : null)">
                <span class="type-icon">⚙️</span> ผู้ดูแลระบบ (Admin)
            </a>
        </nav>

        @if (TempData["Success"] is string success)
        { 
            <div class="success-message" role="status">
                <span class="success-icon">✓</span>
                <span>@success</span>
            </div> 
        }

        <form asp-controller="Account" asp-action="@(admin ? "AdminLogin" : "Login")" method="post" class="login-core-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
            
            <div class="field">
                <label asp-for="Email">อีเมล (Email) <span>*</span></label>
                <div class="input-wrap">
                    <input asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com" required maxlength="254" />
                </div>
            </div>

            <div class="field">
                <label asp-for="Password">รหัสผ่าน (Password) <span>*</span></label>
                <div class="password-wrap">
                    <input asp-for="Password" autocomplete="current-password" placeholder="กรอกรหัสผ่านของคุณ" required maxlength="128" />
                    <button class="password-toggle ns-button ns-button--icon ns-button--text" type="button" data-target="Password" aria-label="แสดงรหัสผ่าน" aria-pressed="false" title="แสดง/ซ่อนรหัสผ่าน">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="check-row">
                <input asp-for="RememberMe" id="RememberMe" />
                <label asp-for="RememberMe" for="RememberMe">จดจำฉันไว้ในเบราว์เซอร์นี้</label>
            </div>

            <button type="submit" class="ns-button ns-button--primary ns-button--block">
                <span>เข้าสู่ระบบ</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
        </form>

        <div class="guest-divider">
            <span>หรือ</span>
        </div>

        <a class="ns-button ns-button--secondary ns-button--block" asp-controller="Home" asp-action="Index" lang="th">
            <span>ข้ามไปก่อน · เริ่มสำรวจหน้าแรกเลย</span>
            <span class="guest-arrow" aria-hidden="true">↗</span>
        </a>

        <p class="switch-form">
            ยังไม่มีบัญชีใช่ไหม? 
            <a asp-action="@(admin ? "AdminRegister" : "Register")" asp-route-returnUrl="@Model.ReturnUrl">
                สมัครสมาชิกเพื่อเริ่มเรียน ↗
            </a>
        </p>
    </section>
</div>
