@model RegisterForm
@{
    Layout = "_AccountLayout";
    var admin = (string?)ViewData["Role"] == "Admin";
    const string emailHint = "กรอกอีเมลของคุณ เช่น name@example.com";
    ViewData["Title"] = admin ? "สร้างบัญชีผู้ดูแล" : "สมัครสมาชิกใหม่";
    ViewData["AccountPageClass"] = "ns-auth-page";
}

<div class="auth-grid">
    <section class="auth-form nimo-auth-card" aria-labelledby="form-heading">
        <h2 id="form-heading">@ViewData["Title"]</h2>
        <p class="form-intro">@(admin ? "สมัครด้วยรหัสเชิญจากผู้ดูแลระบบ" : "ใช้บัญชีนี้ลงทะเบียนคอร์สและบันทึกผลการเรียน")</p>
        
        <nav class="login-account-types" aria-label="ประเภทบัญชี">
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" aria-current="@(!admin ? "page" : null)">
                ผู้เรียน
            </a>
            <a asp-action="AdminRegister" asp-route-returnUrl="@Model.ReturnUrl" aria-current="@(admin ? "page" : null)">
                ผู้ดูแลระบบ
            </a>
        </nav>

        <form asp-controller="Account" asp-action="@(admin ? "AdminRegister" : "Register")" method="post" class="login-core-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
            
            <div class="field">
                <label asp-for="FullName">ชื่อที่แสดง <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    <input asp-for="FullName" autocomplete="name" placeholder="ระบุชื่อที่แสดงของคุณ" required minlength="@RegisterForm.NameMinimumLength" maxlength="@RegisterForm.NameMaximumLength" />
                </div>
            </div>

            <div class="field">
                <label asp-for="Email">อีเมล <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="20" height="16" x="2" y="4" rx="2"/>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                        </svg>
                    </span>
                    <input asp-for="Email" type="email" autocomplete="email" placeholder="@emailHint" aria-describedby="auth-email-hint" required maxlength="@RegisterForm.EmailMaximumLength" />
                </div>
                <small id="auth-email-hint" class="auth-field-placeholder">@emailHint</small>
            </div>

            <div class="field">
                <label asp-for="Password">รหัสผ่าน <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </span>
                    <input asp-for="Password" id="Password" type="password" autocomplete="new-password" placeholder="••••••••" required minlength="@RegisterForm.PasswordMinimumLength" maxlength="@RegisterForm.PasswordMaximumLength" aria-describedby="password-hint" />
                    <button class="password-toggle-eye" type="button" data-target="Password" aria-label="แสดง/ซ่อนรหัสผ่าน" aria-pressed="false" title="แสดง/ซ่อนรหัสผ่าน">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
                <small id="password-hint">ใช้อย่างน้อย @RegisterForm.PasswordMinimumLength ตัวอักษร</small>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword">ยืนยันรหัสผ่าน <span aria-hidden="true">*</span></label>
                <div class="input-icon-wrap">
                    <span class="input-leading-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                    </span>
                    <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" placeholder="กรอกรหัสผ่านอีกครั้ง" required maxlength="@RegisterForm.PasswordMaximumLength" />
                    <button class="password-toggle-eye" type="button" data-target="ConfirmPassword" aria-label="แสดง/ซ่อนรหัสผ่าน" aria-pressed="false" title="แสดง/ซ่อนรหัสผ่าน">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            @if (admin)
            {
                <div class="field">
                    <label asp-for="InvitationCode">รหัสเชิญจากผู้ดูแลระบบ <span aria-hidden="true">*</span></label>
                    <div class="input-icon-wrap">
                        <span class="input-leading-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="7.5" cy="15.5" r="5.5"/>
                                <path d="m21 2-9.6 9.6"/>
                                <path d="m15.5 7.5 3 3L22 7l-3-3"/>
                            </svg>
                        </span>
                        <input asp-for="InvitationCode" type="password" autocomplete="off" required maxlength="@RegisterForm.InvitationMaximumLength" aria-describedby="invitation-hint" />
                    </div>
                    <small id="invitation-hint">รหัสเชิญใช้ได้ครั้งเดียวและใช้ได้ก่อนวันหมดอายุ</small>
                </div>
            }

            <div class="check-row">
                <input asp-for="AcceptTerms" id="AcceptTerms" required />
                <label asp-for="AcceptTerms" for="AcceptTerms">ฉันยอมรับ <a asp-action="Terms" target="_blank" rel="noopener">เงื่อนไขการใช้งานและนโยบายความเป็นส่วนตัว</a></label>
            </div>

            <button type="submit" class="btn-auth-submit">
                <span>@(admin ? "สร้างบัญชีผู้ดูแล" : "สมัครสมาชิก")</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
            </button>
        </form>

        <p class="switch-form">
            มีบัญชี NextSkill แล้ว
            <a asp-action="@(admin ? "AdminLogin" : "Login")" asp-route-returnUrl="@Model.ReturnUrl">
                เข้าสู่ระบบ
            </a>
        </p>
    </section>
    <partial name="_AccountStory" />
</div>
