@model RegisterForm
@{
    Layout = "_AccountLayout";
    var admin = (string?)ViewData["Role"] == "Admin";
    ViewData["Title"] = admin ? "Create admin account" : "Create your account";
}
<div class="auth-grid">
    <partial name="_AccountStory" />
    <section class="auth-form" aria-labelledby="form-heading">
        <h2 id="form-heading">@(admin ? "Create admin account" : "Create your account")</h2>
        <p class="form-intro">@(admin ? "Manage the learning experience. Invitation required." : "Start learning and track your progress.")</p>
        <nav class="account-types" aria-label="Account type">
            <a asp-action="Register" class="@(!admin ? "active" : "")" aria-current="@(!admin ? "page" : null)">User</a>
            <a asp-action="AdminRegister" class="@(admin ? "active" : "")" aria-current="@(admin ? "page" : null)">Admin</a>
        </nav>
        <form asp-controller="Account" asp-action="@(admin ? "AdminRegister" : "Register")" method="post">
            <div asp-validation-summary="All" class="validation-summary" role="alert" tabindex="-1"></div>
            <div class="field">
                <label asp-for="FullName">Full name <span>*</span></label>
                <input asp-for="FullName" autocomplete="name" placeholder="Your full name" required minlength="2" maxlength="100" />
            </div>
            <div class="field">
                <label asp-for="Email">Email <span>*</span></label>
                <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" />
            </div>
            <div class="field">
                <label asp-for="Password">Password <span>*</span></label>
                <div class="password-wrap">
                    <input asp-for="Password" autocomplete="new-password" placeholder="Enter your password" required minlength="8" maxlength="128" aria-describedby="password-hint" />
                    <button class="password-toggle" type="button" data-target="Password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                </div>
                <small id="password-hint">Use at least 8 characters.</small>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword">Confirm password <span>*</span></label>
                <div class="password-wrap">
                    <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Re-enter your password" required maxlength="128" />
                    <button class="password-toggle" type="button" data-target="ConfirmPassword" aria-label="Show confirm password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg></button>
                </div>
            </div>
            @if (admin)
            {
                <div class="field">
                    <label asp-for="InvitationCode">Admin invitation code <span>*</span></label>
                    <input asp-for="InvitationCode" type="password" autocomplete="off" placeholder="Enter your invitation code" required maxlength="128" aria-describedby="invitation-hint" />
                    <small id="invitation-hint">Get a single-use invitation from your system owner.</small>
                </div>
            }
            <div class="check-row">
                <input asp-for="AcceptTerms" required />
                <label asp-for="AcceptTerms">I agree to the <a asp-action="Terms" target="_blank" rel="noopener">Terms of Use and Privacy Policy</a>.</label>
            </div>
            <button type="submit" class="primary-button">@(admin ? "Create admin account" : "Create account")</button>
        </form>
        <p class="switch-form">Already have an account? <a asp-action="@(admin ? "AdminLogin" : "Login")">Log in</a></p>
    </section>
</div>
