@model DashboardModel
@{ Layout = "_AccountLayout"; ViewData["Title"] = Model.Role + " dashboard"; }
<section class="content-page">
    <p class="eyebrow">@Model.Role.ToUpperInvariant() ACCOUNT</p>
    <h1>Welcome, @Model.FullName.</h1>
    <p>You are successfully logged in.</p>
    <dl class="account-details"><dt>Email</dt><dd>@Model.Email</dd><dt>Account type</dt><dd>@Model.Role</dd></dl>
    @if (Model.Role == "Admin")
    {
        <div class="stats"><article><strong>@Model.Users</strong><span>User accounts</span></article><article><strong>@Model.Admins</strong><span>Admin accounts</span></article></div>
        <p class="muted">User and admin accounts are stored separately.</p>
    }
    else
    {
        <a class="primary-button button-link" asp-controller="Home" asp-action="Courses">Explore courses</a>
    }
    <form asp-action="Logout" method="post"><button class="secondary-button" type="submit">Log out</button></form>
</section>
