@using System.Globalization
@model LearnerProfileViewModel
@{
    Layout = "_AccountLayout";
    ViewData["Title"] = "โปรไฟล์ของฉัน";
    ViewData["AccountPageClass"] = "ns-profile-page";
    var state = Model.Learning;
    var activity = state?.Activity;
    var courses = state?.Courses.Where(course => course.HasStarted || course.CompletedLessons.Count > 0)
        .OrderBy(course => course.CourseId != state.ActiveCourseId).ThenBy(course => course.IsComplete).ToArray() ?? [];
    var activeCourse = courses.FirstOrDefault(course => course.CourseId == state?.ActiveCourseId);
    var thai = CultureInfo.GetCultureInfo("th-TH");
    string ThaiDate(DateTime utc) => utc.AddHours(7).ToString("d MMM yyyy", thai);
    string IsoDate(DateTime utc) => utc.AddHours(7).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/learner-profile.css" asp-append-version="true" />
}

@section Backdrop {
    <div class="learning-celestial lp-scenery" data-journey-celestial aria-hidden="true">
        <div class="lp-shore"></div>
        <div class="lp-night-wash"></div>
        <partial name="_JourneyCelestial" />
    </div>
}

<div class="lp">
    <header class="lp-hero lp-glass" aria-labelledby="lp-name">
        <div class="lp-identity">
            <div class="lp-avatar" aria-hidden="true">
                <img src="~/images/nimo-learning.png" asp-append-version="true" width="88" height="88" alt="" />
            </div>
            <div class="lp-identity-copy">
                <p class="lp-muted">โปรไฟล์ของฉัน</p>
                <h1 id="lp-name" dir="auto">@Model.Account.FullName</h1>
                <p class="lp-member">เริ่มเรียนรู้กับ NextSkill <time datetime="@IsoDate(Model.Account.CreatedAt)">@ThaiDate(Model.Account.CreatedAt)</time></p>
            </div>
        </div>
        <div class="lp-hero-actions">
            <a class="lp-button" href="#profile-edit">แก้ไขโปรไฟล์</a>
            @if (activeCourse is not null)
            {
                <a class="lp-button lp-button--primary" asp-controller="Learning" asp-action="Island" asp-route-courseId="@activeCourse.CourseId">
                    @(activeCourse.IsComplete ? "กลับไปที่เกาะ" : "ไปเรียนต่อ") <span aria-hidden="true">→</span>
                </a>
            }
            else
            {
                <a class="lp-button lp-button--primary" asp-controller="Home" asp-action="Courses">สำรวจคอร์ส <span aria-hidden="true">→</span></a>
            }
        </div>
    </header>

    @if (state is null || activity is null)
    {
        <section class="lp-panel lp-glass" aria-labelledby="lp-learning-unavailable">
            <h2 id="lp-learning-unavailable">ความคืบหน้าของฉัน</h2>
            <p class="lp-muted">โหลดข้อมูลการเรียนไม่ได้ในขณะนี้</p>
            <a class="lp-button" asp-action="Dashboard">ลองอีกครั้ง</a>
        </section>
    }
    else
    {
        var levelXp = state.Xp % LearningState.XpPerLevel;
        var nextXp = LearningState.XpPerLevel - levelXp;
        var goals = LearningDailyGoals.All;
        var today = activity.Today;
        var completedGoals = goals.Count(goal => goal.IsComplete(today));
        var missionHistory = activity.RecentDays.OrderByDescending(entry => entry.Key)
            .Select(entry => (Date: entry.Key, Goals: goals.Where(goal => goal.IsComplete(entry.Value)).ToArray()))
            .Where(entry => entry.Goals.Length > 0).ToArray();
        <div class="lp-overview">
            <div class="lp-column">
                <section class="lp-panel lp-glass lp-level" aria-labelledby="lp-level-title">
                    <div class="lp-heading">
                        <span class="lp-icon lp-icon--xp" aria-hidden="true"></span>
                        <h2 id="lp-level-title">ความคืบหน้าของฉัน</h2>
                    </div>
                    <div class="lp-level-overview">
                        <p class="lp-level-value">เลเวล <strong>@state.Level</strong></p>
                        <div class="lp-level-meter">
                            <div class="lp-split">
                                <span>อีก @nextXp.ToString("N0") XP ถึงเลเวล @(state.Level + 1)</span>
                                <span class="lp-muted">@levelXp / @LearningState.XpPerLevel</span>
                            </div>
                            <progress class="lp-meter" value="@levelXp" max="@LearningState.XpPerLevel" aria-label="XP ในเลเวลปัจจุบัน"></progress>
                        </div>
                    </div>
                    <dl class="lp-stats">
                        <div><dt>XP สะสม</dt><dd>@state.Xp.ToString("N0")</dd></div>
                        <div><dt>เรียนต่อเนื่อง</dt><dd>@activity.StreakDays <small>วัน</small></dd></div>
                        <div><dt>จบแล้ว</dt><dd>@Model.Certificates.Count <small>คอร์ส</small></dd></div>
                    </dl>
                </section>

                <section class="lp-panel lp-glass" aria-labelledby="lp-courses-title">
                    <div class="lp-heading">
                        <span class="lp-icon lp-icon--book" aria-hidden="true"></span>
                        <h2 id="lp-courses-title">คอร์สของฉัน</h2>
                    </div>
                    @if (courses.Length == 0)
                    {
                        <p class="lp-muted lp-empty">เมื่อเริ่มคอร์สแรกแล้ว คุณจะติดตามบทเรียนและกลับไปเรียนต่อได้ที่นี่</p>
                    }
                    else
                    {
                        <ul class="lp-list lp-course-list">
                            @foreach (var course in courses)
                            {
                                <li>
                                    <a class="lp-course" asp-controller="Learning" asp-action="Island" asp-route-courseId="@course.CourseId">
                                        <span class="lp-course-main"><strong dir="auto">@course.Title</strong><span class="lp-muted">@(course.IsComplete ? "เรียนจบแล้ว" : $"{course.CompletedLessons.Count} / {course.TotalLessons} บทเรียน")</span></span>
                                        <span class="lp-course-meter">
                                            <progress class="lp-meter" value="@course.Progress" max="100" aria-label="ความคืบหน้า @course.Title"></progress>
                                            <span>@(course.Progress)%</span>
                                        </span>
                                        <span class="lp-course-arrow" aria-hidden="true">›</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>

            <div class="lp-column">
                <section class="lp-panel lp-glass" aria-labelledby="lp-awards-title">
                    <div class="lp-heading">
                        <span class="lp-icon lp-icon--trophy" aria-hidden="true"></span>
                        <h2 id="lp-awards-title">เหรียญความสำเร็จ</h2>
                        <span class="lp-count">@state.Awards.Count เหรียญ</span>
                    </div>
                    @if (state.Awards.Count == 0)
                    {
                        <p class="lp-muted lp-empty">ผ่านบทเรียนแรกเพื่อรับเหรียญแรกของคุณ</p>
                    }
                    else
                    {
                        <ul class="lp-list lp-awards">
                            @foreach (var award in state.Awards.Reverse())
                            {
                                <li>
                                    <span class="lp-medal @(award.Key == "first-lesson" ? "lp-medal--first" : "lp-medal--course")" aria-hidden="true"></span>
                                    <span><strong>@Model.AwardTitle(award.Key)</strong><time class="lp-muted" datetime="@IsoDate(award.EarnedAt)">@ThaiDate(award.EarnedAt)</time></span>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="lp-panel lp-glass" id="certificates" aria-labelledby="lp-certificates-title">
                    <div class="lp-heading">
                        <span class="lp-icon lp-icon--certificate" aria-hidden="true"></span>
                        <h2 id="lp-certificates-title">ใบประกาศของฉัน</h2>
                        <span class="lp-count">@Model.Certificates.Count ใบ</span>
                    </div>
                    @if (Model.Certificates.Count == 0)
                    {
                        <p class="lp-muted lp-empty">เรียนและผ่านแบบทดสอบครบทุกบทในคอร์สเพื่อรับใบประกาศ</p>
                    }
                    else
                    {
                        <ul class="lp-list lp-course-list lp-certificates">
                            @foreach (var certificate in Model.Certificates)
                            {
                                <li>
                                    <a class="lp-course" asp-action="Certificate" asp-route-courseId="@certificate.CourseId">
                                        <span class="lp-course-main">
                                            <strong dir="auto">@certificate.CourseTitle</strong>
                                            <time class="lp-muted" datetime="@IsoDate(certificate.EarnedAt)">@ThaiDate(certificate.EarnedAt)</time>
                                        </span>
                                        <span class="lp-certificate-link">เปิดใบประกาศ</span>
                                        <span class="lp-course-arrow" aria-hidden="true">›</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="lp-panel lp-glass" aria-labelledby="lp-goals-title">
                    <div class="lp-heading">
                        <span class="lp-icon lp-icon--check" aria-hidden="true"></span>
                        <h2 id="lp-goals-title">ภารกิจวันนี้</h2>
                        <span class="lp-count">@completedGoals / @goals.Count สำเร็จ</span>
                    </div>
                    <ul class="lp-list lp-goals">
                        @foreach (var goal in goals)
                        {
                            var progress = goal.ReadProgress(today);
                            var achieved = goal.IsComplete(today);
                            <li>
                                <span class="lp-goal-mark @(achieved ? "is-complete" : null)" aria-hidden="true"></span>
                                <span>@goal.Title</span>
                                <span class="@(achieved ? "lp-goal-complete" : "lp-muted")">@(achieved ? "สำเร็จ" : $"{progress} / {goal.Target}")</span>
                            </li>
                        }
                    </ul>
                    <details class="lp-mission-history">
                        <summary>ภารกิจที่สำเร็จใน @LearningDailyGoals.HistoryDays วันที่ผ่านมา</summary>
                        @if (missionHistory.Length == 0)
                        {
                            <p class="lp-muted">ยังไม่มีภารกิจที่สำเร็จในช่วงนี้</p>
                        }
                        else
                        {
                            <ul class="lp-list">
                                @foreach (var entry in missionHistory)
                                {
                                    <li>
                                        <time datetime="@entry.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@entry.Date.ToString("d MMM yyyy", thai)</time>
                                        <span class="lp-muted">@string.Join(" · ", entry.Goals.Select(goal => goal.Title))</span>
                                    </li>
                                }
                            </ul>
                        }
                    </details>
                </section>
            </div>
        </div>
    }

    <section class="lp-panel lp-glass lp-edit" id="profile-edit" aria-labelledby="lp-edit-title">
        <div>
            <h2 id="lp-edit-title">แก้ไขโปรไฟล์</h2>
            <p class="lp-muted">อีเมลนี้ใช้สำหรับเข้าสู่ระบบ</p>
        </div>
        <form class="lp-form" asp-action="UpdateProfile" asp-fragment="profile-edit" method="post">
            @if (TempData["ProfileSuccess"] is string success)
            {
                <p class="lp-success" role="status">@success</p>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="lp-validation" asp-validation-summary="ModelOnly" role="alert"></div>
            }
            <div class="lp-form-fields">
                <div class="lp-field">
                    <label asp-for="Edit.FullName">ชื่อที่แสดง</label>
                    <input asp-for="Edit.FullName" autocomplete="name" maxlength="100" aria-describedby="lp-name-error" required />
                    <span asp-validation-for="Edit.FullName" id="lp-name-error"></span>
                </div>
                <div class="lp-field">
                    <label asp-for="Edit.Email">อีเมล</label>
                    <input asp-for="Edit.Email" type="email" autocomplete="email" maxlength="254" aria-describedby="lp-email-error" required />
                    <span asp-validation-for="Edit.Email" id="lp-email-error"></span>
                </div>
                <div class="lp-field">
                    <label for="Edit_CurrentPassword">รหัสผ่านปัจจุบัน</label>
                    <input id="Edit_CurrentPassword" name="@Html.NameFor(m => m.Edit.CurrentPassword)" type="password" autocomplete="current-password" maxlength="128" aria-describedby="lp-password-hint lp-password-error" />
                    <small id="lp-password-hint" class="lp-muted">กรอกเฉพาะเมื่อเปลี่ยนอีเมล</small>
                    <span asp-validation-for="Edit.CurrentPassword" id="lp-password-error"></span>
                </div>
            </div>
            <button class="lp-button lp-button--primary" type="submit">บันทึกโปรไฟล์</button>
        </form>
    </section>
</div>
