@model LearningIslandViewModel
@{
    var learnerAccount = User.IsInRole("User");
}
<dialog id="course-award-dialog" class="course-award-dialog" data-course-id="@Model.Course.CourseId"
        aria-labelledby="course-award-title" aria-describedby="course-award-message"
        data-learner-account="@learnerAccount.ToString().ToLowerInvariant()">
    <header>
        <span class="certificate-seal" aria-hidden="true"></span>
        <h2 id="course-award-title"></h2>
        <p id="course-award-message"></p>
    </header>
    <article class="certificate-paper certificate-paper--compact" id="course-award-certificate" hidden>
        <p class="certificate-brand">NextSkill</p>
        <h3>ใบประกาศนียบัตร</h3>
        <strong class="certificate-recipient" dir="auto">@Model.LearnerName</strong>
        <p class="certificate-course" dir="auto">@Model.Course.Title</p>
    </article>
    <form class="course-award-actions" method="dialog">
        <button type="submit" class="ns-button ns-button--secondary" autofocus>ดูผลแบบทดสอบ</button>
        @if (learnerAccount)
        {
            <a id="course-award-certificate-link" class="ns-button ns-button--primary" asp-controller="Account"
               asp-action="Certificate" asp-route-courseId="@Model.Course.CourseId" hidden>เปิดใบประกาศ</a>
        }
    </form>
</dialog>
