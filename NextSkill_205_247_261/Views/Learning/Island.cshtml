@model LearningIslandViewModel
@{ 
    Layout = "_SmartJourneyLayout"; 
    ViewData["Title"] = Model.Course.Title; 
    ViewData["JourneyMode"] = "learn";
    var activeCourseMeta = NextSkill_205_247_261.Services.CourseCatalog.GetCourses().FirstOrDefault(c => c.Id == Model.Course.CourseId);
    var videoUrl = activeCourseMeta?.VideoUrl;
}
<main id="journey-main" class="sj-learn">
    <partial name="_LearningOceanWorld" />
    <div class="learning-celestial" aria-hidden="true"><partial name="_JourneyCelestial" /></div>
    <div class="sj-learn-top"><a asp-controller="Home" asp-action="Index">← หน้าแรก</a><span class="sj-saved" id="learning-save-status"><i></i> @(User.Identity?.IsAuthenticated == true ? "บันทึกกับบัญชีของคุณ" : "โหมดทดลอง · ความคืบหน้าแยกสำหรับเบราว์เซอร์นี้")</span></div>



<header class="learning-heading"><p class="sj-eyebrow" id="learner-greeting">ยินดีต้อนรับ, @Model.LearnerName</p><h1>@Model.Course.Title</h1></header><div class="learning-workspace">    <section class="sj-learning-map" aria-labelledby="lesson-map-title" id="lesson-map"><div class="sj-learning-map-heading"><div><h2 id="lesson-map-title">เกาะบทเรียน</h2></div><button type="button" class="sj-text-link" id="locate-current">กลับไปด่านปัจจุบัน <span aria-hidden="true">↑</span></button></div><div id="lesson-route" class="sj-lesson-route" aria-label="เกาะบทเรียนในคอร์ส"></div></section><aside class="learning-sidebar" aria-label="ข้อมูลการเรียน"><div class="learning-sidebar-inner"><div id="island-detail-slot"><section id="island-detail" class="island-detail" hidden aria-labelledby="detail-title"><button type="button" id="detail-back" class="sj-text-link">← กลับด่านปัจจุบัน</button><p class="sj-eyebrow" id="detail-number"></p><h2 id="detail-title"></h2><p id="detail-meta"></p><p id="detail-status"></p><button type="button" class="ns-button ns-button--primary" id="detail-start">เริ่มเรียน →</button></section></div>    <section class="sj-current-island glass" aria-labelledby="current-island-title"><div class="sj-current-copy"><p class="sj-eyebrow">ด่านปัจจุบันของคุณ</p><div class="sj-course-label"><span id="current-course-title">@Model.Course.Title</span><span id="current-island-number">ด่าน @Model.Course.CurrentIslandId / @Model.Course.TotalLessons</span></div><h2 id="current-island-title">@Model.Course.Lessons.FirstOrDefault(lesson => lesson.Id == Model.Course.LastLessonId)?.Title</h2><p class="sj-current-description" id="current-island-description">พร้อมเริ่มด่านแรกแล้ว</p><div class="sj-current-meta"><span><span class="icon icon-book" aria-hidden="true"></span><span id="current-lesson-minutes">บทเรียนสั้น พร้อมแบบฝึก</span></span><span><span class="icon icon-lightning" aria-hidden="true"></span><span id="current-lesson-xp">XP เมื่อผ่านบทเรียน</span></span></div><div class="sj-current-actions"><button type="button" class="ns-button ns-button--primary" id="resume-learning">เริ่มเรียน <span aria-hidden="true">→</span></button>@if (!string.IsNullOrWhiteSpace(videoUrl)){<button type="button" class="ns-button ns-button--secondary" onclick="document.getElementById('island-course-video-modal')?.showModal();" style="gap:6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg><span>วิดีโอคอร์ส</span></button>}<button type="button" class="ns-button ns-button--secondary" data-smart-action="choose-course">เปลี่ยนคอร์ส</button></div><div class="sj-course-progress"><div><span id="course-progress-caption">สำเร็จ @Model.Course.CompletedLessons.Count จาก @Model.Course.TotalLessons ด่าน</span><strong id="course-progress-value">@Model.Course.Progress%</strong></div><progress id="course-progress" max="@Model.Course.TotalLessons" value="@Model.Course.CompletedLessons.Count" aria-label="ความก้าวหน้าของคอร์ส"></progress></div></div><div class="sj-island-scene" data-scene="current-island"><span class="sj-scene-tag" id="island-status-tag"><i></i> เกาะปัจจุบันของคุณ</span><img src="~/images/journey/destination-island.svg" alt="" width="640" height="440" /><span class="sj-mascot-anchor sj-destination-anchor buddy-slot" data-buddy-anchor="arrival"></span><div class="sj-speech sj-island-speech"><strong data-buddy-name>Nimo</strong><span id="niko-learning-message">พร้อมเมื่อไร เรามาฝึกต่อกันนะ</span></div></div></section>    <section class="sj-learning-summary"><div><span class="icon icon-lightning" aria-hidden="true"></span><strong data-state-xp>@Model.State.Xp</strong><span>XP สะสม</span></div><div><span class="icon icon-star" aria-hidden="true"></span><strong data-state-level>@Model.State.Level</strong><span>ระดับผู้เรียน</span></div><div><span class="icon icon-trophy" aria-hidden="true"></span><strong id="achievement-count">@Model.State.Achievements.Count</strong><span>ความสำเร็จ</span></div><p id="achievement-description">ทักษะที่เพิ่มขึ้น อยู่กับคุณในทุกเส้นทาง</p></section></div></aside></div>@if (!string.IsNullOrWhiteSpace(videoUrl))
{
    var embedUrl = NextSkill_205_247_261.Models.CourseBrowseItem.ToEmbedUrl(videoUrl);
    var isDirect = NextSkill_205_247_261.Models.CourseBrowseItem.IsDirectVideo(videoUrl);
    <dialog id="island-course-video-modal" class="nimo-modal" style="max-width: 820px; width: 92vw; border-radius: 22px; padding: 22px; background: rgba(13, 34, 56, 0.96); backdrop-filter: blur(24px); border: 1.5px solid rgba(56, 189, 248, 0.35); box-shadow: 0 24px 60px rgba(0, 10, 25, 0.6); color: #fff;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="display: inline-flex; align-items: center; gap: 5px; background: linear-gradient(135deg, #0284c7, #06b6d4); color: white; padding: 4px 10px; border-radius: 8px; font-size: 11.5px; font-weight: 700; box-shadow: 0 3px 10px rgba(2, 132, 199, 0.35);">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    สื่อการเรียนรู้
                </span>
                <strong style="font-size: 17px; color: #fff;">@Model.Course.Title</strong>
            </div>
            <button type="button" onclick="document.getElementById('island-course-video-modal')?.close();" class="modal-close-btn" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 50%; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; color: #bae6fd; font-size: 18px; cursor: pointer; transition: all 0.2s ease;">✕</button>
        </div>
        <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 16px; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 1px solid rgba(56, 189, 248, 0.2);">
            @if (isDirect)
            {
                <video controls style="position: absolute; top:0; left:0; width:100%; height:100%; object-fit: contain;" playsinline>
                    <source src="@videoUrl" type="video/mp4" />
                    เบราว์เซอร์ไม่รองรับการเล่นวิดีโอ
                </video>
            }
            else
            {
                <iframe style="position: absolute; top:0; left:0; width:100%; height:100%; border:0;"
                        src="@embedUrl"
                        title="สื่อการเรียนรู้ @Model.Course.Title"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            }
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
            <span style="font-size: 12.5px; color: #94a3b8;">สามารถดูวิดีโอประกอบการเรียนรู้ได้ตลอดเวลาในขณะผจญภัยในเกาะ</span>
            <button type="button" onclick="document.getElementById('island-course-video-modal')?.close();" class="ns-button ns-button--secondary ns-button--compact" style="background: rgba(255, 255, 255, 0.08); color: #fff; border-color: rgba(56, 189, 248, 0.3);">ปิดหน้าต่าง</button>
        </div>
    </dialog>
}
<dialog id="island-detail-dialog" class="island-detail-dialog" aria-label="รายละเอียดเกาะ"><button type="button" id="detail-sheet-close" aria-label="ปิดรายละเอียด">✕</button></dialog></main>
<script type="application/json" id="learning-initial-state">@Json.Serialize(new { state = Model.State, course = Model.Course, learnerName = Model.LearnerName, initialLessonId = Model.InitialLessonId })</script>
