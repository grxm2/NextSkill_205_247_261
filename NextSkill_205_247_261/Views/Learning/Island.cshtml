@model LearningIslandViewModel
@{ 
    Layout = "_SmartJourneyLayout"; 
    ViewData["Title"] = Model.Course.Title; 
    ViewData["JourneyMode"] = "learn";
    var activeCourseMeta = NextSkill_205_247_261.Services.CourseCatalog.GetCourses().FirstOrDefault(c => c.Id == Model.Course.CourseId);
    var videoUrl = activeCourseMeta?.VideoUrl;
    var embedUrl = CourseBrowseItem.ToEmbedUrl(videoUrl);
    var isDirect = CourseBrowseItem.IsDirectVideo(videoUrl);
    var hasCourseVideo = isDirect || embedUrl is not null;
    var levelXp = Model.State.Xp % LearningState.XpPerLevel;
    var goalTargets = LearningDailyGoals.All.ToDictionary(goal => goal.Key, goal => goal.Target);
}
<main id="journey-main" class="sj-learn">
    <partial name="_LearningOceanWorld" />
    <div class="learning-celestial" data-journey-celestial aria-hidden="true"><partial name="_JourneyCelestial" /></div>
    <header class="learning-heading island-heading">
        <div class="island-course-switch">
            <h1 id="current-course-title">
                <button type="button" id="island-course-toggle" aria-expanded="false" aria-controls="island-course-menu"
                        aria-label="@($"{Model.Course.Title} · เปลี่ยนคอร์ส")">
                    @Model.Course.Title<span class="island-chevron" aria-hidden="true"></span>
                </button>
            </h1>
            <div class="island-course-menu" id="island-course-menu" hidden>
                @if (hasCourseVideo)
                {
                    <button id="island-video-open" type="button" aria-haspopup="dialog" aria-controls="island-course-video-modal">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 4.8a1 1 0 0 0-1.5.9v12.6a1 1 0 0 0 1.5.9l10.1-6.3a1 1 0 0 0 0-1.8L8 4.8Z"/></svg>
                        วิดีโอคอร์ส
                    </button>
                }
                <ul id="island-course-options" aria-label="คอร์สที่เลือกเรียนได้"><li>กำลังโหลดคอร์ส…</li></ul>
                <button class="island-text-button" id="island-course-all" type="button" data-smart-action="choose-course"
                        aria-haspopup="dialog" aria-controls="course-harbor-dialog">ดูคลังคอร์สทั้งหมด</button>
            </div>
        </div>
        <dl class="island-progress-strip" aria-label="สถิติการเรียน">
            <div class="island-progress-xp">
                <dt class="sr-only">XP ในเลเวลปัจจุบัน</dt>
                <dd>
                    <span class="icon icon-lightning" aria-hidden="true"></span><span id="island-level-xp">@($"{levelXp}/{LearningState.XpPerLevel} XP")</span>
                    <progress class="island-meter" id="island-level-meter" max="@LearningState.XpPerLevel" value="@levelXp"
                              aria-label="XP ถึงเลเวล @(Model.State.Level + 1)" title="ถึงเลเวล @(Model.State.Level + 1)"></progress>
                </dd>
            </div>
            @if (Model.State.Activity is { } activity)
            {
                var completedGoals = LearningDailyGoals.All.Count(goal => goal.IsComplete(activity.Today));
                <div>
                    <dt class="sr-only">เรียนต่อเนื่อง (วัน)</dt>
                    <dd title="@($"streak {activity.StreakDays} วัน")">
                        <span class="icon island-streak-icon" aria-hidden="true"></span><span id="island-streak-days">@activity.StreakDays</span>
                    </dd>
                </div>
                <div>
                    <dt class="sr-only">ภารกิจวันนี้</dt>
                    <dd title="@($"ภารกิจวันนี้ {completedGoals}/{LearningDailyGoals.All.Count}")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor"/>
                        </svg>
                        <span id="island-goals-total">@($"{completedGoals}/{LearningDailyGoals.All.Count}")</span>
                    </dd>
                </div>
            }
        </dl>
    </header>
    <div class="learning-workspace">
        <section class="sj-learning-map" aria-label="แผนที่บทเรียน" id="lesson-map">
            <div class="sj-learning-map-heading">
                <button type="button" class="ns-button ns-button--compact" id="locate-current">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <circle cx="12" cy="12" r="7"/><path d="M12 2v4m0 12v4M2 12h4m12 0h4"/><circle cx="12" cy="12" r="2" fill="currentColor" stroke="none"/>
                    </svg>
                    กลับไปด่านปัจจุบัน
                </button>
            </div>
            <div id="lesson-route" class="sj-lesson-route">
                <div class="island-underwater-route" role="group" aria-label="แผนที่บทเรียนในคอร์ส"></div>
            </div>
        </section>
        <partial name="_IslandDashboard" model="Model" />
    </div>

@if (hasCourseVideo)
{
    <dialog id="island-course-video-modal" class="nimo-modal island-course-video" aria-labelledby="island-video-title">
        <div class="island-course-video-header">
            <div class="island-course-video-title">
                <span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    สื่อการเรียนรู้
                </span>
                <strong id="island-video-title">@Model.Course.Title</strong>
            </div>
            <button type="button" onclick="document.getElementById('island-course-video-modal')?.close();" aria-label="ปิดวิดีโอ" autofocus class="modal-close-btn">✕</button>
        </div>
        <div class="island-course-video-player">
            @if (isDirect)
            {
                <video controls preload="none" playsinline>
                    <source src="@videoUrl" type="video/mp4" />
                    เบราว์เซอร์ไม่รองรับการเล่นวิดีโอ
                </video>
            }
            else
            {
                <iframe data-src="@embedUrl"
                        title="สื่อการเรียนรู้ @Model.Course.Title"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            }
        </div>
        <div class="island-course-video-footer">
            <span>สามารถดูวิดีโอประกอบการเรียนรู้ได้ตลอดเวลาในขณะผจญภัยในเกาะ</span>
            <button type="button" onclick="document.getElementById('island-course-video-modal')?.close();" class="ns-button ns-button--secondary ns-button--compact">ปิดหน้าต่าง</button>
        </div>
    </dialog>
}
<dialog id="island-detail-dialog" class="island-detail-dialog" aria-labelledby="detail-title"><button type="button" id="detail-sheet-close" aria-label="ปิดรายละเอียด">✕</button></dialog>
</main>
<script type="application/json" id="learning-initial-state">@Json.Serialize(new { state = Model.State, course = Model.Course, initialLessonId = Model.InitialLessonId, goalTargets })</script>
