@model LearningIslandViewModel
@{ Layout = "_SmartJourneyLayout"; ViewData["Title"] = Model.Course.Title; ViewData["JourneyMode"] = "learn"; }
<main id="journey-main" class="sj-learn">
    <div class="sj-learn-top"><a asp-controller="Home" asp-action="Index">หน้าแรก <span aria-hidden="true">/</span></a><span>@Model.Course.Title</span><span class="sj-saved" id="learning-save-status"><i></i> @(User.Identity?.IsAuthenticated == true ? "บันทึกกับบัญชีของคุณ" : "โหมดทดลอง · ความคืบหน้าแยกสำหรับเบราว์เซอร์นี้")</span></div>



<header class="learning-heading"><p class="sj-eyebrow" id="learner-greeting">ยินดีต้อนรับกลับ, @Model.LearnerName</p><h1>@Model.Course.Title</h1></header><div class="learning-workspace">    <section class="sj-learning-map" aria-labelledby="lesson-map-title" id="lesson-map"><div class="sj-learning-map-heading"><div><p class="sj-eyebrow">แผนที่การเรียน</p><h2 id="lesson-map-title">เกาะบทเรียน</h2><p>กดด่านที่ผ่านแล้วเพื่อทบทวน หรือไปต่อที่ด่านปัจจุบัน</p></div><button type="button" class="sj-text-link" id="locate-current">กลับไปด่านปัจจุบัน <span aria-hidden="true">↑</span></button></div><div id="lesson-route" class="sj-lesson-route" aria-label="เกาะบทเรียนในคอร์ส"></div></section><aside class="learning-sidebar" aria-label="ข้อมูลการเรียน"><div class="learning-sidebar-inner"><div id="island-detail-slot"><section id="island-detail" class="island-detail" hidden aria-labelledby="detail-title"><button type="button" id="detail-back" class="sj-text-link">← กลับด่านปัจจุบัน</button><p class="sj-eyebrow" id="detail-number"></p><h2 id="detail-title"></h2><p id="detail-meta"></p><p id="detail-status"></p><button type="button" class="sj-button" id="detail-start">เริ่มเรียน →</button></section></div>    <section class="sj-current-island" aria-labelledby="current-island-title"><div class="sj-current-copy"><p class="sj-eyebrow">ด่านปัจจุบันของคุณ</p><div class="sj-course-label"><span id="current-course-title">@Model.Course.Title</span><span id="current-island-number">เกาะ @Model.Course.CurrentIslandId / @Model.Course.TotalLessons</span></div><h2 id="current-island-title">@Model.Course.Lessons.FirstOrDefault(lesson => lesson.Id == Model.Course.LastLessonId)?.Title</h2><p class="sj-current-description" id="current-island-description">กลับมาเรียนต่อจากจุดเดิม พร้อมฝึกไปทีละก้าวกับ Niko</p><div class="sj-current-meta"><span><span class="icon icon-book" aria-hidden="true"></span><span id="current-lesson-minutes">บทเรียนสั้น พร้อมแบบฝึก</span></span><span><span class="icon icon-lightning" aria-hidden="true"></span><span id="current-lesson-xp">XP เมื่อผ่านบทเรียน</span></span></div><div class="sj-current-actions"><button type="button" class="sj-button" id="resume-learning">เรียนต่อ <span aria-hidden="true">→</span></button><button type="button" class="sj-secondary" data-smart-action="choose-course">เปลี่ยนคอร์ส</button></div><div class="sj-course-progress"><div><span id="course-progress-caption">สำเร็จ @Model.Course.CompletedLessons.Count จาก @Model.Course.TotalLessons เกาะ</span><strong id="course-progress-value">@Model.Course.Progress%</strong></div><progress id="course-progress" max="@Model.Course.TotalLessons" value="@Model.Course.CompletedLessons.Count" aria-label="ความก้าวหน้าของคอร์ส"></progress></div></div><div class="sj-island-scene" data-scene="current-island"><span class="sj-scene-tag" id="island-status-tag"><i></i> เกาะปัจจุบันของคุณ</span><img src="~/images/journey/destination-island.svg" alt="" width="640" height="440" /><span class="sj-mascot-anchor sj-destination-anchor buddy-slot" data-buddy-anchor="arrival"></span><div class="sj-speech sj-island-speech"><strong data-buddy-name>Niko</strong><span id="niko-learning-message">พร้อมเมื่อไร เรามาฝึกต่อกันนะ</span></div></div></section>    <section class="sj-learning-summary"><div><span class="icon icon-lightning" aria-hidden="true"></span><strong data-state-xp>@Model.State.Xp</strong><span>XP สะสม</span></div><div><span class="icon icon-star" aria-hidden="true"></span><strong data-state-level>@Model.State.Level</strong><span>ระดับผู้เรียน</span></div><div><span class="icon icon-trophy" aria-hidden="true"></span><strong id="achievement-count">@Model.State.Achievements.Count</strong><span>ความสำเร็จ</span></div><p id="achievement-description">ทักษะที่เพิ่มขึ้น อยู่กับคุณในทุกเส้นทาง</p></section></div></aside></div><dialog id="island-detail-dialog" class="island-detail-dialog" aria-label="รายละเอียดเกาะ"><button type="button" id="detail-sheet-close" aria-label="ปิดรายละเอียด">✕</button></dialog></main>
<script type="application/json" id="learning-initial-state">@Json.Serialize(new { state = Model.State, course = Model.Course, learnerName = Model.LearnerName, initialLessonId = Model.InitialLessonId })</script>
