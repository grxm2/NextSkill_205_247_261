@model LearningIslandViewModel
@{
    var course = Model.Course;
    var current = course.Lessons.First(lesson => lesson.Id == (course.LastLessonId ?? course.CurrentIslandId));
    var hasProgress = course.CompletedLessons.Count > 0;
    var action = course.IsComplete ? "ทบทวนบทเรียน" : hasProgress ? "เรียนต่อ" : "เริ่มเรียน";
}

<aside class="learning-sidebar island-dashboard" aria-label="ข้อมูลการเรียน">
    <div id="island-detail-slot">
        <section id="island-detail" class="island-detail" hidden aria-labelledby="detail-title">
            <button type="button" id="detail-back" class="island-text-button">กลับด่านปัจจุบัน</button>
            <p class="island-chapter" id="detail-number"></p>
            <h2 id="detail-title" tabindex="-1"></h2>
            <p id="detail-meta"></p>
            <p id="detail-status"></p>
            <button type="button" class="ns-button ns-button--primary" id="detail-start">เริ่มเรียน →</button>
        </section>
    </div>

    <section class="island-current-card" id="island-current-card" aria-label="ด่านปัจจุบันของคุณ">
        <div class="island-current-info">
            <p class="island-chapter" id="current-island-number">@(course.HasFinishedLessons ? $"ผ่านครบ {course.TotalLessons} ด่าน" : $"บทที่ {current.Id}")</p>
            <h2 id="current-island-title">@(course.IsComplete ? "เรียนจบคอร์สแล้ว" : course.FinalQuizReady ? "พร้อมสอบท้ายคอร์ส" : current.DisplayTitle)</h2>
            <p id="current-lesson-time" class="island-lesson-duration" hidden="@course.HasFinishedLessons">@current.Minutes นาที</p>
        </div>
        <div class="island-current-actions">
            <button class="ns-button ns-button--primary" id="resume-learning" type="button" hidden="@course.FinalQuizReady">
                <span id="resume-learning-label">@action</span><span aria-hidden="true">→</span>
            </button>
            <a class="ns-button ns-button--primary" id="island-final-quiz" asp-action="FinalQuiz" asp-route-courseId="@course.CourseId" hidden="@(!course.FinalQuizReady)">
                ทำแบบทดสอบท้ายคอร์ส <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>
</aside>
