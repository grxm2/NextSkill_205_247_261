@model HomeDashboardViewModel
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<section class="ow-intro learning-dashboard" data-home-dashboard data-mode="intro"
         data-status="@(signedIn ? "loading" : "guest")" aria-labelledby="home-hero-title">
    <header class="hd-hero" data-dashboard-hero>
        <h1 id="home-hero-title">ฝึกทักษะใหม่<br /><span id="hero-highlight">ทีละบทเรียน</span></h1>
        <p>เรียนภาษาอังกฤษ โค้ด UX/UI หรือการใช้ AI แล้วทำแบบทดสอบเพื่อไปต่อ</p>
    </header>
    <dl class="ns-stat-pills hd-stats" aria-label="สถิติรวมจากทุกคอร์ส" data-dashboard-stats hidden>
        <div data-dashboard-streak hidden><dt class="sr-only">เรียนต่อเนื่อง</dt><dd><span class="ns-stat-icon ns-stat-icon--fire" aria-hidden="true"></span><strong data-dashboard-stat="streak"></strong> วัน</dd></div>
        <div><dt class="sr-only">คอร์สที่เรียนจบ</dt><dd><span class="ns-stat-icon ns-stat-icon--trophy" aria-hidden="true"></span><strong data-dashboard-stat="complete"></strong> คอร์ส</dd></div>
        <div><dt class="sr-only">XP รวม</dt><dd><span class="ns-stat-icon ns-stat-icon--star" aria-hidden="true"></span><strong data-dashboard-stat="xp"></strong> XP</dd></div>
    </dl>
    <h1 class="hd-greeting" id="home-greeting-title" data-dashboard-greeting hidden>
        ยินดีต้อนรับกลับ
        @if (signedIn)
        {
            <bdi>@Model.LearnerName</bdi>
        }
    </h1>

    <a class="hd-start" asp-controller="Home" asp-action="Courses" data-catalog-voyage hidden="@signedIn">
        เริ่มเรียน<span class="hd-start-arrow" aria-hidden="true">→</span>
    </a>

    <div class="hd-overview" data-dashboard-overview hidden>
        <div class="hd-course-column">
            <section class="hd-current hd-glass" aria-label="คอร์สของคุณ" data-dashboard-active-course>
                <div class="hd-course-heading">
                    <h2><a class="hd-course-link" data-dashboard-active-title data-continue-voyage></a></h2>
                    <span class="hd-trial" data-dashboard-preview title="ผลทดลองแยกจากบัญชีและเปิดได้จากเบราว์เซอร์นี้" hidden>ทดลองเรียน</span>
                </div>
                <div class="hd-progress">
                    <div class="hd-ring" data-dashboard-ring aria-hidden="true"><strong data-dashboard-percent></strong></div>
                    <div class="hd-progress-copy">
                        <p data-dashboard-progress></p>
                        <progress class="hd-meter" data-dashboard-meter max="100" value="0" aria-label="ความคืบหน้าของคอร์สปัจจุบัน"></progress>
                        <p class="hd-next-lesson" data-dashboard-next hidden><span data-dashboard-next-label>บทถัดไป</span> <strong data-dashboard-next-title></strong></p>
                    </div>
                </div>
            </section>
            <div class="hd-actions" data-dashboard-actions hidden>
                <a class="ns-button ns-button--primary" data-dashboard-resume><span data-dashboard-resume-label>เรียนต่อ</span><span aria-hidden="true">→</span></a>
                <a class="ns-button ns-button--secondary" asp-controller="Home" asp-action="Courses" data-catalog-voyage>เลือกคอร์สใหม่</a>
                <button class="hd-missions-trigger" type="button" aria-haspopup="dialog" aria-controls="hd-mission-dialog" hidden>
                    <svg viewBox="0 0 32 26" fill="none" aria-hidden="true" focusable="false">
                        <path d="M4 12v8a3 3 0 0 0 3 3h18a3 3 0 0 0 3-3v-8Z" class="hd-chest-body" />
                        <path d="M4 12V9a6 6 0 0 1 6-6h12a6 6 0 0 1 6 6v3Z" class="hd-chest-lid" />
                        <path d="M9 5v6m14-6v6M9 15v5m14-5v5" class="hd-chest-bands" />
                        <rect x="13" y="10" width="6" height="6" rx="1.5" class="hd-chest-latch" />
                    </svg>
                    <span>ภารกิจ</span>
                </button>
            </div>
        </div>
        <section class="hd-mission hd-glass" id="hd-daily-goals" aria-labelledby="hd-mission-title" tabindex="-1" hidden>
            <div class="hd-mission-heading">
                <h2 id="hd-mission-title">ภารกิจวันนี้</h2>
                <span class="hd-mission-summary"><span class="sr-only">สำเร็จแล้ว </span><span data-dashboard-goal-summary></span></span>
            </div>
            <ul class="hd-missions">
                @foreach (var goal in LearningDailyGoals.All)
                {
                    <li data-dashboard-goal="@goal.Key">
                        <span>@goal.Title</span>
                        <span class="hd-goal-state">
                            <span class="hd-goal-check" aria-hidden="true" hidden></span><span data-dashboard-goal-count></span>
                        </span>
                    </li>
                }
            </ul>
        </section>
    </div>
    <dialog class="hd-mission-dialog hd-glass" id="hd-mission-dialog" aria-labelledby="hd-mission-title">
        <form method="dialog">
            <button type="submit" class="hd-mission-close" aria-label="ปิดภารกิจ" autofocus>✕</button>
        </form>
    </dialog>
</section>
