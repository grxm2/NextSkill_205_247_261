@model HomeDashboardViewModel
@{ Layout = "_SmartJourneyLayout"; ViewData["Title"] = "ออกเดินทางสู่ทักษะใหม่"; ViewData["JourneyMode"] = "home"; }
<link rel="preload" href="~/images/hero/sky-clouds.webp" as="image" type="image/webp" asp-append-version="true" />
<link rel="stylesheet" href="~/css/hero-sunset.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ocean-voyage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shooting-star.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home-ocean.css" asp-append-version="true" />
<link rel="preload" href="~/images/journey/home-ocean-painted-v2.webp" as="image" type="image/webp" />
<link rel="preload" href="~/images/journey/home-island-terrain-v2.webp" as="image" type="image/webp" />
<main id="journey-main" class="ocean-home">
<div class="ow-track">
<section id="ocean-journey" class="ow-scene cv-home" data-catalog-departure aria-label="เดินทางผ่านโลกทะเลกับ Nimo">
    <partial name="_OceanBirds" />
    <div class="ow-sky" aria-hidden="true"><div class="hero-sky-texture"></div><div class="journey-night-sky"></div><partial name="_JourneyCelestial" /></div>
    <div class="ow-distance" aria-hidden="true"><img src="~/images/journey/distant-coast.svg" asp-append-version="true" width="1200" height="140" alt="" /></div>
    <div class="ow-sea" aria-hidden="true"><div class="ow-water-detail"><div class="ow-water-surface"></div></div><div class="ow-sun-path"></div><div class="hero-water-glints" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="ow-swell ow-swell-0"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-1"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-2"><div class="ow-swell-drift"></div></div><div class="ow-water-lines"></div></div>
    <div class="ow-near-sea" aria-hidden="true"><div class="ow-swell ow-swell-3"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-4"><div class="ow-swell-drift"></div></div></div>
    <partial name="_OpenSeaAtmosphere" />
    <div class="ow-clouds" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="cv-depth-scene">
    <div class="ow-camera">
        <partial name="_OceanBackdrop" />
        <partial name="_OceanLife" />
        <figure class="ow-land ow-start-land"><partial name="_StartingIslandArt" /><span class="ow-island-mascot sj-mascot-anchor buddy-slot" data-buddy-anchor="shore" data-buddy-home="active"></span></figure>
        <div class="ow-harbor cv-departure-harbor" id="course-harbor" aria-hidden="true">
            <div class="ow-dock">
                <partial name="_KnowledgeSanctumArt" model="false" />
            </div>
        </div>
    </div>
    <div class="ow-vessel" aria-label="Nimo เดินทางบนเรือลำเดียวกัน"><div class="ow-arrival-motion"><partial name="_VesselWater" /><div class="ow-boat-idle"><span class="ow-boat-anchor sj-mascot-anchor buddy-slot" data-buddy-anchor="arrival"></span><img class="ow-boat-art" asp-append-version="true" src="~/images/journey/rowing-hull-waterline.svg" width="480" height="280" alt="เรือของ Nimo" /><img class="voyage-oar" src="~/images/journey/rowing-oar.svg" alt="" /></div><partial name="_VesselWaterContact" /></div></div>
    </div>
    <div class="ow-intro"><p class="cv-eyebrow">โลกแห่งการเรียนรู้รอคุณอยู่</p><h1><span id="hero-highlight">ทักษะใหม่</span>ของคุณ<br /><em>เริ่มที่เกาะนี้</em></h1><p>ฝึกภาษา ออกแบบ และเขียนโค้ด<br />ออกเดินทางไปกับ Nimo ในจังหวะของคุณ</p><div class="ow-intro-actions"><a class="ns-button ns-button--primary" asp-controller="Home" asp-action="Courses" data-catalog-voyage>ออกเดินทางเลือกคอร์ส <span aria-hidden="true">→</span></a></div></div>
</section>
</div>
<noscript><p>เลือกคอร์สได้ที่ <a href="/Home/Courses">รายการคอร์สทั้งหมด</a></p></noscript>
</main>
