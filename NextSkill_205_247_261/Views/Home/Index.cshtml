@model HomeDashboardViewModel
@{ Layout = "_SmartJourneyLayout"; ViewData["Title"] = "ออกเดินทางสู่ทักษะใหม่"; ViewData["JourneyMode"] = "home"; }
<link rel="preload" href="~/images/hero/sky-clouds.webp" as="image" type="image/webp" asp-append-version="true" />
<link rel="stylesheet" href="~/css/hero-sunset.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/shooting-star.css" asp-append-version="true" />
<main id="journey-main" class="ocean-home">
<div class="ow-track">
<section id="ocean-journey" class="ow-scene" aria-label="เดินทางผ่านโลกทะเลกับ Nimo">
    <partial name="_OceanBirds" />
    <div class="ow-sky" aria-hidden="true"><div class="hero-sky-texture"></div><div class="journey-night-sky"></div><partial name="_JourneyCelestial" /></div>
    <div class="ow-distance" aria-hidden="true"><img src="~/images/journey/distant-coast.svg" asp-append-version="true" width="1200" height="140" alt="" /></div>
    <div class="ow-sea" aria-hidden="true"><div class="ow-sun-path"></div><div class="hero-water-glints" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="ow-swell ow-swell-0"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-1"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-2"><div class="ow-swell-drift"></div></div><div class="ow-water-lines"></div></div>
    <div class="ow-near-sea" aria-hidden="true"><div class="ow-swell ow-swell-3"><div class="ow-swell-drift"></div></div><div class="ow-swell ow-swell-4"><div class="ow-swell-drift"></div></div></div>
    <div class="ow-clouds" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="ow-camera">
        <partial name="_OceanBackdrop" />
        <partial name="_OceanLife" />
        <figure class="ow-land ow-start-land"><partial name="_StartingIslandArt" /><span class="ow-island-mascot sj-mascot-anchor buddy-slot" data-buddy-anchor="shore" data-buddy-home="active"></span></figure>
        <div class="ow-harbor" id="course-harbor"><div class="ow-dock"><img src="~/images/journey/course-container.svg" width="800" height="560" alt="ตู้คอนเทนเนอร์คลังเส้นทางการเรียน" /><button class="ow-container-button" type="button" data-smart-action="choose-course">เปิดคลังคอร์ส ↗</button></div><div class="ow-harbor-board"><p class="sj-eyebrow">ท่าเรือแห่งทักษะ</p><h2>เลือกเส้นทางที่อยากไป</h2><p>เลือกคอร์สก่อน แล้วผ่านเมฆไปยังเกาะบทเรียนของคุณ</p><div id="harbor-course-list" data-course-grid="featured" class="sj-featured-courses"><p>กำลังเปิดคลังคอร์ส…</p></div><button type="button" class="sj-text-link" data-smart-action="choose-course">ค้นหาคอร์สทั้งหมด ↗</button></div></div>
    </div>
    <div class="ow-vessel" aria-label="Nimo เดินทางบนเรือลำเดียวกัน"><div class="ow-arrival-motion"><div class="ow-wake" aria-hidden="true"></div><div class="ow-boat-idle"><span class="ow-boat-anchor sj-mascot-anchor buddy-slot" data-buddy-anchor="arrival"></span><img class="ow-boat-art" src="~/images/journey/rowing-hull.svg" width="480" height="280" alt="เรือของ Nimo" /><img class="voyage-oar" src="~/images/journey/rowing-oar.svg" alt="" /></div></div></div>
    <div class="ow-intro"><h1><span id="hero-highlight">ทักษะใหม่</span>ของคุณ<br /><em>เริ่มที่เกาะนี้</em></h1><p>ฝึกภาษา ออกแบบ และเขียนโค้ด<br />ออกเดินทางไปกับ Nimo ในจังหวะของคุณ</p><div class="ow-intro-actions"><button type="button" class="ns-button ns-button--primary" data-ocean-go="0.2">เลือกคอร์สทันที →</button></div></div>
</section>
</div>
<noscript><p>เลือกคอร์สได้ที่ <a href="/Home/Courses">รายการคอร์สทั้งหมด</a></p></noscript>
</main>
