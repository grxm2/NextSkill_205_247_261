@model IEnumerable<NextSkill_205_247_261.Models.Course>
@{
    ViewData["Title"] = "Courses";
    var q = ViewBag.Query as string ?? string.Empty;
    var tag = ViewBag.Tag as string ?? "All";
    var sort = ViewBag.Sort as string ?? "Recommended";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
    int pageSize = ViewBag.PageSize ?? 9;
}

<div class="course-catalog container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Find your next course</h2>
        <div class="text-muted small">Sort:</div>
    </div>

    <p class="text-muted">Browse by topic, level, or learning time.</p>

    <form method="get" class="mb-3">
        <div class="row g-2">
            <div class="col-md-8">
                <div class="input-group">
                    <input name="q" value="@q" class="form-control search-input" placeholder="Search courses, skills, or instructors" />
                    <button class="btn btn-outline-secondary" type="submit">Search</button>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex">
                    <select name="sort" class="form-select" onchange="this.form.submit()">
                        @if (sort == "Recommended")
                        {
                            <option value="Recommended" selected>Recommended</option>
                        }
                        else
                        {
                            <option value="Recommended">Recommended</option>
                        }

                        @if (sort == "A-Z")
                        {
                            <option value="A-Z" selected>A–Z</option>
                        }
                        else
                        {
                            <option value="A-Z">A–Z</option>
                        }

                        @if (sort == "Recently")
                        {
                            <option value="Recently" selected>Recently added</option>
                        }
                        else
                        {
                            <option value="Recently">Recently added</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </form>

    <div class="mb-4 tags">
        <a class="btn btn-outline-secondary btn-sm @(tag=="All"?"active":"")" href="?q=@q&tag=All">All</a>
        <a class="btn btn-outline-secondary btn-sm @(tag=="Design"?"active":"")" href="?q=@q&tag=Design">Design</a>
        <a class="btn btn-outline-secondary btn-sm @(tag=="Business"?"active":"")" href="?q=@q&tag=Business">Business</a>
        <a class="btn btn-outline-secondary btn-sm @(tag=="Technology"?"active":"")" href="?q=@q&tag=Technology">Technology</a>
        <a class="btn btn-outline-secondary btn-sm @(tag=="Short"?"active":"")" href="?q=@q&tag=Short">Short courses</a>
    </div>

    <div class="mb-2 text-muted">@totalCount courses</div>

    @if (!Model?.Any() ?? true)
    {
        <div class="alert alert-light">No courses found</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in (Model ?? Enumerable.Empty<NextSkill_205_247_261.Models.Course>()))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="course-card p-3" data-course-id="@item.Id" data-total-lessons="@(item.Lessons?.Count ?? 0)">
                        @if (item.Featured)
                        {
                            <div class="card-badge">FEATURED</div>
                        }
                        <div class="card-media mb-2"></div>
                        <h5>@item.Title</h5>
                        <div class="text-muted small">@item.Level · @item.Units units</div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <div class="progress w-75">
                                <div class="progress-bar" role="progressbar" style="width:0%"></div>
                            </div>
                            <div class="percent text-end small ms-2">0%</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="status small text-muted">Not started</div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark start-link" data-course-id="@item.Id">View course</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-rounded">
                <li class="page-item @(page<=1?"disabled":"")"><a class="page-link" href="?q=@q&tag=@tag&sort=@sort&page=@(page-1)">Prev</a></li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p==page?"active":"")"><a class="page-link" href="?q=@q&tag=@tag&sort=@sort&page=@p">@p</a></li>
                }
                <li class="page-item @(page>=totalPages?"disabled":"")"><a class="page-link" href="?q=@q&tag=@tag&sort=@sort&page=@(page+1)">Next</a></li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts{
    <script src="~/js/catalog.js"></script>
}
