@* Distant ocean details share the island camera and never block controls. *@
<div class="ocean-backdrop" aria-hidden="true">
    @for (var ship = 1; ship <= 7; ship++)
    {
        <div class="ocean-backdrop-boat-track ocean-backdrop-boat-track--@ship">
            <svg class="ocean-backdrop-boat" viewBox="0 0 150 82" focusable="false">
                <path d="M12 75c12 2 22 3 30 2m61 0c12 0 22-2 32-4" fill="none" stroke="#d6f2ed" stroke-width="2" stroke-linecap="round" opacity=".65" />
                @if (ship == 2 || ship == 5)
                {
                    @* A small sailing boat. *@
                    <path d="M22 61h106l-12 12H49c-11 0-20-5-27-12Z" fill="var(--ship-hull, #a7754f)" stroke="#77553f" stroke-width="2"/>
                    <path d="M72 12v49M34 60h76" fill="none" stroke="#6b7270" stroke-width="2"/>
                    <path d="M68 16c-7 15-16 26-30 40h30Z" fill="#fff4db" stroke="#c7cec5" stroke-width="1.2"/>
                    <path d="M76 22c5 12 13 24 25 34H76Z" fill="var(--ship-accent, #d6e8df)" stroke="#aac6c6" stroke-width="1.2"/>
                    <g class="ocean-ship-lights" fill="#fff0a8"><circle cx="72" cy="12" r="2.3"/><circle cx="80" cy="61" r="2.2"/></g>
                }
                else if (ship == 3)
                {
                    @* A low ferry, distinct from the fishing boats. *@
                    <path d="M13 60h124l-10 12H38c-10 0-18-5-25-12Z" fill="var(--ship-hull, #467b8a)" stroke="#345d6f" stroke-width="2"/>
                    <path d="M35 59V44h76v15M49 44V33h44v11" fill="#e2eee5" stroke="#658c92" stroke-width="2"/>
                    <path d="M59 37h12v6H59zm17 0h12v6H76z" fill="#78a8af"/>
                    <path d="M71 33V19m-6 5h12" stroke="#6e898b" stroke-width="2"/>
                    <g class="ocean-ship-lights" fill="#fff0a8"><circle cx="44" cy="52" r="2.4"/><circle cx="57" cy="52" r="2.4"/><circle cx="70" cy="52" r="2.4"/><circle cx="83" cy="52" r="2.4"/><circle cx="96" cy="52" r="2.4"/></g>
                }
                else if (ship == 6)
                {
                    @* A small tug with a tall wheelhouse. *@
                    <path d="M24 57h104l-12 15H51c-11 0-20-5-27-15Z" fill="var(--ship-hull, #b76e60)" stroke="#755a54" stroke-width="2"/>
                    <path d="M53 55V38h35V26h20v29" fill="#e9e4d2" stroke="#789392" stroke-width="2"/>
                    <path d="M91 31h11v9H91z" fill="#709da3"/><path d="M72 38V21h7v17" fill="var(--ship-accent, #d7ab69)"/>
                    <g class="ocean-ship-lights" fill="#fff0a8"><circle cx="61" cy="50" r="2.4"/><circle cx="73" cy="50" r="2.4"/><circle cx="97" cy="26" r="2.3"/></g>
                }
                else if (ship == 7)
                {
                    @* A two-masted coastal boat. *@
                    <path d="M19 61h115l-14 12H48c-12 0-22-5-29-12Z" fill="var(--ship-hull, #6b8c78)" stroke="#59756d" stroke-width="2"/>
                    <path d="M53 60V24m44 36V15" stroke="#728582" stroke-width="2"/>
                    <path d="M49 28 29 57h20ZM93 19 64 57h29Z" fill="var(--ship-accent, #e5d8b5)" stroke="#c5cabc" stroke-width="1.2"/>
                    <g class="ocean-ship-lights" fill="#fff0a8"><circle cx="97" cy="15" r="2.3"/><circle cx="75" cy="61" r="2.2"/></g>
                }
                else
                {
                    @* A compact fishing boat. *@
                    <path d="M17 54h115l-10 14c-3 4-8 6-14 6H47c-11 0-22-7-30-20Z" fill="var(--ship-hull, #356779)" stroke="#2c586b" stroke-width="2" stroke-linejoin="round" />
                    <path d="M26 60h94" stroke="#b9d9d5" stroke-width="1.5" opacity=".75" />
                    <path d="M39 52V42h20l8-12h26l8 12h12v10" fill="#dce8dc" stroke="#557a81" stroke-width="2" stroke-linejoin="round" />
                    <path d="M68 39h21v9H68z" fill="#638d96"/><path d="M76 30V13m-8 6h16" stroke="#58757a" stroke-width="2" stroke-linecap="round"/>
                    <path d="M42 52h68" stroke="#edc89c" stroke-width="2"/>
                    <g class="ocean-ship-lights" fill="#fff0a8"><circle cx="48" cy="47" r="2.4"/><circle cx="59" cy="47" r="2.4"/><circle cx="100" cy="47" r="2.4"/><circle cx="76" cy="14" r="2.2"/></g>
                }
            </svg>
        </div>
    }
    <div class="ocean-backdrop-buoy">
        <img src="~/images/journey/sea-buoy.svg" width="100" height="160" alt="" draggable="false" />
    </div>
    <div class="ocean-backdrop-whale-water">
        <div class="ocean-backdrop-whale">
            <svg viewBox="0 0 180 100" focusable="false">
                <path d="M14 78c16 3 33 4 50 3m55 0c17-1 32-3 47-7" fill="none" stroke="#bfe8e6" stroke-width="2.5" stroke-linecap="round" opacity=".75" />
                <path d="M24 76c10-20 27-31 51-32 24-2 42 8 55 24 5-9 13-14 24-16-5 6-8 14-8 20l11 5c-13 4-25 5-36 3-36 5-71 5-97-4Z" fill="#568b9e" />
                <path d="M35 68c9-9 23-14 38-14" fill="none" stroke="#99c6cb" stroke-width="2" stroke-linecap="round" opacity=".7" />
                <path d="M102 63c5 3 10 4 15 4-5 6-12 7-19 3Z" fill="#487b91" />
                <circle cx="48" cy="66" r="1.7" fill="#315e70" />
            </svg>
            <svg class="ocean-backdrop-spout" viewBox="0 0 30 31" focusable="false">
                <path d="M15 28c0-9-1-15-7-20m7 17c0-10 1-16 6-22" fill="none" stroke="#d4f1ef" stroke-width="2" stroke-linecap="round" />
            </svg>
        </div>
    </div>
</div>
