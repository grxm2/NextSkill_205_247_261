@model HomeDashboardViewModel
<aside class="buddy-coach" id="buddy-coach" aria-labelledby="coach-title" hidden>
    <button type="button" class="coach-close" id="coach-close" aria-label="ปิดการพาชม">×</button>
    <div class="coach-character" aria-hidden="true"><span class="buddy-slot" data-buddy-anchor="coach"></span></div>
    <div class="coach-bubble"><div class="coach-meta"><span><span data-buddy-name>Niko</span> · คู่หูแนะนำการเรียน</span><span id="coach-count">1 / 3</span></div><h2 id="coach-title">มาเริ่มกันทีละก้าว</h2><p id="coach-caption" lang="th" aria-live="polite"></p><div class="coach-voice-row"><button type="button" id="coach-voice" aria-pressed="false">เปิดเสียงบรรยาย</button><button type="button" id="coach-replay" hidden>ฟังอีกครั้ง</button></div><p class="coach-audio-status" id="coach-audio-status" role="status">อ่านคำแนะนำได้เลย หรือเปิดเสียงเพื่อฟัง</p><div class="coach-actions"><button type="button" id="coach-back">ย้อนกลับ</button><button type="button" class="button button-primary" id="coach-next">ถัดไป <span aria-hidden="true">→</span></button></div></div>
</aside>
