@model Course
@{
    var thumbnail = Model.Category == "Technology" ? "sea-coding-study.webp" : "sea-design-study.webp";
}
<article class="sea-course">
    <a class="sea-course-art" asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" tabindex="-1" aria-hidden="true">
        <img src="~/images/@thumbnail" alt="" width="768" height="512" loading="lazy" />
    </a>
    <div class="sea-course-info">
        <span class="sea-category">@Model.Category</span>
        <h3><a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
        <p>@Model.Description</p>
        <div class="sea-course-bottom">
            <span><span class="icon icon-book" aria-hidden="true"></span>@Model.Lessons.Count บทเรียน</span>
            <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.Id" aria-label="ดูรายละเอียด @Model.Title"><span class="icon icon-arrow-right" aria-hidden="true"></span></a>
        </div>
    </div>
</article>
