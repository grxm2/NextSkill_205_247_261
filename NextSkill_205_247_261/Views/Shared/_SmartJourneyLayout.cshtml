@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment JourneyEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration JourneyConfiguration
<!DOCTYPE html>
<html lang="th">
<head>
    <script>try { const m=JSON.parse(sessionStorage.getItem('nextskill.journey-arrival')); if(location.pathname.toLowerCase()==='/learning/island' && m && Number(new URLSearchParams(location.search).get('courseId'))===m.courseId && Date.now()-m.at<900000) document.documentElement.classList.add('journey-arrival-prepaint'); } catch {}</script>
    <style>.journey-arrival-prepaint:before{content:'';position:fixed;inset:0;z-index:2147483647;background:#ccefff url('/images/journey/clouds-reference-v1.png') center/cover no-repeat}</style>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#d8f4ff" />
    <meta name="description" content="NextSkill — เลือกทักษะที่อยากเรียน ออกเดินทางกับ Nimo และกลับมาเรียนต่อจากเกาะเดิมได้ทันที" />
    <title>@ViewData["Title"] — NextSkill</title>
    <link rel="icon" href="~/home-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/Prompt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-character.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/companion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-agent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-expressions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/smart-journey.css" asp-append-version="true" />
@if (ViewData["JourneyMode"]?.ToString() == "home") { <link rel="stylesheet" href="~/css/ocean-world.css" asp-append-version="true" /> }
<link rel="preload" href="~/images/journey/clouds-reference-v1.png" as="image" />
<link rel="stylesheet" href="~/css/journey-clouds.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/archipelago.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/learning-workspace.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/niko-voyage.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/lesson-experience.css" asp-append-version="true" />
@if (ViewData["JourneyMode"]?.ToString() == "home") {
    <link rel="stylesheet" href="~/css/ocean-life.css" asp-append-version="true" />
}
    <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
</head>
<body data-guest-preview="@((JourneyEnvironment.EnvironmentName == "Development" && JourneyConfiguration.GetValue("Learning:GuestPreview", true)).ToString().ToLowerInvariant())" id="nextskill-home" class="smart-journey" data-companion-theme="learning-club" data-journey-mode="@ViewData["JourneyMode"]" data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    <a class="skip-link" href="#journey-main">ข้ามไปเนื้อหา</a>
    <partial name="_Navbar" />
    <partial name="_LearningStatus" />
    @RenderBody()
    <footer class="sj-footer"><a asp-controller="Home" asp-action="Index" class="sj-footer-brand">NextSkill<span>ทักษะใหม่ เริ่มจากก้าวที่คุณเลือก</span></a><div><a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a><a asp-controller="Account" asp-action="Terms">เงื่อนไขการใช้งาน</a><button type="button" id="sj-motion" aria-pressed="false">พักการเคลื่อนไหว</button></div></footer>
    <div class="map-guide" data-motion="active" hidden><button type="button" id="buddy-motion" hidden>พักการเคลื่อนไหว</button></div>
    <button type="button" id="studio-launch" data-open-dialog="companion-dialog" hidden>แต่งตัว Nimo</button>
    <button type="button" id="niko-practice-start" hidden>เรียนต่อกับ Nimo</button>
    <button type="button" id="buddy-tour-start" hidden>วิธีสำรวจ</button>
    <div id="smart-antiforgery" hidden>@Html.AntiForgeryToken()</div>
    <div id="home-status" class="sr-only" role="status" aria-live="polite"></div>
    <div id="buddy-status" class="sr-only" role="status" aria-live="polite"></div>
    <dialog id="journey-cloud-transition" aria-label="กำลังเดินทางสู่เกาะของคุณ"><div class="jc-core"></div><div class="jc-bank jc-bank-top"></div><div class="jc-bank jc-bank-bottom"></div><div class="jc-near jc-near-left"></div><div class="jc-near jc-near-right"></div><p class="jc-label">กำลังเดินทางสู่เกาะของคุณ</p></dialog>
    <partial name="_SmartJourneyDialogs" />
    <partial name="_CompanionStudio" />
    <partial name="_FloatingBuddy" />
    <script src="~/js/motion-state.js" asp-append-version="true" defer></script>
    <script src="~/js/buddy-agent.js" asp-append-version="true" defer></script>
    <script src="~/js/buddy-motion.js" asp-append-version="true" defer></script>
    <script src="~/js/home.js" asp-append-version="true" defer></script>
    <script src="~/js/companion.js" asp-append-version="true" defer></script>
    <script src="~/js/niko-voyage.js" asp-append-version="true" defer></script>
    <script src="~/js/journey-clouds.js" asp-append-version="true" defer></script>
    <script src="~/js/island-details.js" asp-append-version="true" defer></script>
    <script src="~/js/archipelago.js" asp-append-version="true" defer></script>
    <script src="~/js/smart-journey.js" asp-append-version="true" defer></script>
@if (ViewData["JourneyMode"]?.ToString() == "learn") { <script src="~/js/island-water-motion.js" asp-append-version="true" defer></script><script src="~/js/underwater-journey.js" asp-append-version="true" defer></script> }
@if (ViewData["JourneyMode"]?.ToString() == "home") {
<script src="~/lib/gsap/gsap.min.js" defer></script><script src="~/lib/gsap/ScrollTrigger.min.js" defer></script><script src="~/js/ocean-world.js" asp-append-version="true" defer></script>
<script src="~/js/ocean-life.js" asp-append-version="true" defer></script>
}
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/navbar.js" asp-append-version="true" defer></script>
</body>
</html>
