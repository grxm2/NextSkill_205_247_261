@using Microsoft.Extensions.Hosting
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment SiteEnvironment
@{
    var oceanCatalog = ViewData["OceanCatalog"] is true;
    var hasBackdrop = IsSectionDefined("Backdrop");
    var useCatalogBundle = false;
    if (oceanCatalog && !SiteEnvironment.IsDevelopment())
    {
        var catalogBundle = SiteEnvironment.WebRootFileProvider.GetFileInfo("css/catalog.bundle.css");
        useCatalogBundle = catalogBundle.Exists && catalogBundle.Length > 0;
    }
    ViewData["JourneyMode"] ??= "site";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] · NextSkill</title>
    <script>try { document.documentElement.dataset.theme = localStorage.getItem('nextskill.theme.v1') === 'dark' ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
    <partial name="_JourneyArrivalPrepaint" />
    @if (oceanCatalog)
    {
        <link rel="preload" href="~/images/journey/underwater-journey-background-v1.webp" as="image" type="image/webp" fetchpriority="high" />
        <link rel="preload" href="~/images/journey/sanctum-submerged-rocks.svg" as="image" type="image/svg+xml" fetchpriority="high" />
        <partial name="_CatalogVoyagePrepaint" />
        <meta name="theme-color" content="#9bddec" />
        <meta name="description" content="ค้นหาคอร์สภาษา ออกแบบ เทคโนโลยี และธุรกิจ เลือกเส้นทางที่ชอบ แล้วฝึกทักษะใหม่ไปกับ Nimo ที่ NextSkill" />
    }
    <link rel="preload" href="~/fonts/Prompt-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/Prompt-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NextSkill_205_247_261.styles.css" asp-append-version="true" />
    @if (useCatalogBundle)
    {
        <link rel="stylesheet" href="~/css/catalog.bundle.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/buddy-character.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/companion.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/buddy-motion.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/buddy-agent.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/buddy-expressions.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/adventure-theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/ocean-theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/dashboard-polish.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/course-pages.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site-shell.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/footer-glass.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/journey-clouds.css" asp-append-version="true" />
        @if (oceanCatalog)
        {
            <link rel="stylesheet" href="~/css/course-harbor.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/catalog-ocean.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/catalog-voyage.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/catalog-layout.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/shared-ocean.css" asp-append-version="true" />
        }
        <link rel="stylesheet" href="~/css/journey-theme.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/nimo-speech.css" asp-append-version="true" />
        @if (oceanCatalog)
        {
            <link rel="stylesheet" href="~/css/favorites.css" asp-append-version="true" />
        }
    }
    <script src="~/js/footer-bubbles.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ocean-theme ns-site-shell @(oceanCatalog ? "ns-catalog-shell" : null) @(hasBackdrop ? "ns-site-shell--scenic" : null)">
    @await RenderSectionAsync("Backdrop", required: false)
    <partial name="_Navbar" />
    <div class="@(oceanCatalog ? "ns-catalog-main" : "container ns-site-main")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="ns-site-footer">
        <div class="ns-site-footer-inner">
            <span class="ns-site-footer-brand">NextSkill · เก่งขึ้นทีละก้าว ไปด้วยกันกับ Nimo</span>
            <div><a asp-area="" asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a><a asp-controller="Account" asp-action="Terms">เงื่อนไขการใช้งาน</a></div>
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    }
    <partial name="_FloatingBuddy" />
    @if (oceanCatalog) { <partial name="_CatalogVoyage" /> }
    <partial name="_JourneyCloudTransition" />
    <script src="~/js/motion-state.js" asp-append-version="true" defer></script>
    <script src="~/js/journey-theme.js" asp-append-version="true" defer></script>
    <script src="~/js/buddy-agent.js" asp-append-version="true" defer></script>
    <script src="~/js/buddy-motion.js" asp-append-version="true" defer></script>
    @if (oceanCatalog) { <script src="~/js/island-water-motion.js" asp-append-version="true" defer></script> }
    @await RenderSectionAsync("Scripts", required: false)
    @if (oceanCatalog) { <script src="~/js/catalog-voyage.js" asp-append-version="true" defer></script> }
    <script src="~/js/journey-clouds.js" asp-append-version="true" defer></script>
    <script src="~/js/course-island-voyage.js" asp-append-version="true" defer></script>
    <script src="~/js/navbar.js" asp-append-version="true" defer></script>
    <script src="~/js/nimo-speech.js" asp-append-version="true" defer></script>
</body>
</html>
