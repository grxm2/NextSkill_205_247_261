<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NextSkill_205_247_261</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NextSkill_205_247_261.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-character.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/companion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-agent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buddy-expressions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/adventure-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ocean-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-polish.css" asp-append-version="true" />
</head>
<body class="ocean-theme">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">NextSkill_205_247_261</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2569 - NextSkill_205_247_261 - <a asp-area="" asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_FloatingBuddy" />
    <script src="~/js/buddy-agent.js" asp-append-version="true" defer></script>
    <script src="~/js/buddy-motion.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
