<aside class="story-card nimo-story-card nimo-island-tea-card" aria-label="เรื่องราวการเรียนรู้กับ NextSkill">
    <!-- Headline -->
    <h1>เรียนสนุก<br />ไปด้วยกันนะ!</h1>
    
    <!-- Subtitle -->
    <p class="story-intro">
        ฝึกโค้ดดิ้ง ออกแบบ UX/UI AI และภาษาในบรรยากาศเกาะสุดชิลกับ Nimo เรียนฟรีพร้อมแบบฝึกหัดและเกียรติบัตร
    </p>

    <!-- Center Mascot Scene: Nimo Lounging on a Beach Chair with Study Books -->
    <div class="hero-mascot-scene nimo-tea-island-diorama">
        <div class="mascot-ambient-aura" aria-hidden="true"></div>

        <!-- Sandy Island Beach Base with Stack of Textbooks & Graduation Cap Beside Nimo's Chair -->
        <svg class="nimo-study-beach-base-svg" viewBox="0 0 380 86" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- Soft Turquoise Shallow Water Ring -->
            <ellipse cx="190" cy="64" rx="172" ry="18" fill="#38bdf8" fill-opacity="0.22" />
            <!-- Warm Golden Sand Island Base -->
            <ellipse cx="190" cy="60" rx="154" ry="16" fill="url(#storySandGrad)" />
            <ellipse cx="190" cy="58" rx="115" ry="10" fill="#d97706" fill-opacity="0.18" />

            <!-- Left Stack of Colorful Study Textbooks on the Sand -->
            <g class="beach-study-books" transform="translate(36, 28)">
                <!-- Bottom Blue Book -->
                <rect x="0" y="22" width="44" height="10" rx="3" fill="#0284c7" stroke="#0369a1" stroke-width="1.5" />
                <rect x="3" y="24" width="38" height="6" rx="1.5" fill="#f0f9ff" />
                <!-- Middle Emerald Book -->
                <rect x="4" y="13" width="40" height="9" rx="2.5" fill="#10b981" stroke="#047857" stroke-width="1.5" />
                <rect x="7" y="15" width="34" height="5" rx="1.2" fill="#ecfdf5" />
                <!-- Top Amber Book with Bookmark -->
                <rect x="2" y="5" width="38" height="8" rx="2.5" fill="#f59e0b" stroke="#b45309" stroke-width="1.5" />
                <path d="M16 11V19L19 17L22 19V11" fill="#ef4444" />
            </g>

            <!-- Right Mini Graduation Cap on the Sand Beside Chair -->
            <g class="beach-grad-cap" transform="translate(298, 30) rotate(8)">
                <polygon points="22,2 44,11 22,20 0,11" fill="#1e293b" stroke="#0f172a" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M10 15V24C10 27 34 27 34 24V15" fill="#334155" />
                <path d="M38 13V25" stroke="#fbbf24" stroke-width="2" stroke-linecap="round" />
                <circle cx="38" cy="26" r="2.2" fill="#fbbf24" />
            </g>

            <defs>
                <linearGradient id="storySandGrad" x1="190" y1="44" x2="190" y2="76" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#fef3c7" />
                    <stop offset="100%" stop-color="#fcd34d" />
                </linearGradient>
            </defs>
        </svg>

        <partial name="_LoginNimo" />
    </div>

    <a asp-controller="Home" asp-action="Courses" class="login-course-link">
        ดูคอร์สเรียนทั้งหมด <span aria-hidden="true">→</span>
    </a>

    <!-- Animated Multi-Layer Island Ocean Wave Arc at Bottom of Card -->
    <div class="story-wave-decor" aria-hidden="true">
        <svg viewBox="0 0 500 60" preserveAspectRatio="none">
            <path class="story-wave-path-1" d="M0,25 C150,55 350,0 500,28 L500,60 L0,60 Z" fill="rgba(56,189,248,0.18)"></path>
            <path class="story-wave-path-2" d="M0,35 C180,10 320,50 500,32 L500,60 L0,60 Z" fill="rgba(14,165,233,0.26)"></path>
        </svg>
    </div>
</aside>
