@{
    var compact = ViewData["CompactAccountStory"] is true;
}

<aside class="story-card nimo-story-card" aria-label="เรื่องราวการเรียนรู้กับ NextSkill">
    <!-- Star sparkle decorations -->
    <div class="story-stars-decor" aria-hidden="true">
        <span class="star-sparkle s-1">✦</span>
        <span class="star-sparkle s-2">★</span>
        <span class="star-sparkle s-3">✦</span>
    </div>

    <!-- Top Badge -->
    <div class="hero-rmooc-pill">
        <span class="star-gold" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        </span>
        <span>RMOOC · เรียนออนไลน์จากการเรียนรู้</span>
    </div>

    <!-- Headline -->
    <h1>เรียนสนุก<br />ไปด้วยกันนะ!</h1>
    
    <!-- Subtitle -->
    <p class="story-intro">
        เป็นเพื่อนร่วมทางการเรียนรู้ พัฒนาทักษะที่ใช่ ไปสู่อนาคตที่ดีกว่า ไปกับ NextSkill
    </p>

    <!-- Center Mascot Scene: High-Resolution Studio Nimo (Duolingo Style Lively Character) -->
    <div class="hero-mascot-scene">
        <div class="mascot-ambient-aura" aria-hidden="true"></div>
        <div class="story-sparkles-orbit" aria-hidden="true">
            <span class="duo-sparkle sp-1">✦</span>
            <span class="duo-sparkle sp-2">★</span>
            <span class="duo-sparkle sp-3">✦</span>
        </div>
        <div class="mascot-cloud-pedestal" aria-hidden="true"></div>
        @if (compact)
        {
            <partial name="_LoginNimo" />
        }
        else
        {
            <div class="mascot-character-art mascot-fly-in-entrance" id="nimoInteractiveMascot" role="button" tabindex="0" title="คลิกเพื่อทักทายนิโม!" aria-label="มาสคอตนิโม คลิกเพื่อเล่น">
                <img src="~/images/nimo-pose-wave.png" asp-append-version="true" alt="Nimo (นิโม) มาสคอตเพื่อนร่วมทางการเรียนรู้ กำลังโบกมือทักทาย" class="main-mascot-img" id="nimoMascotImg" width="220" height="220" />

                <div class="mascot-speech-pill" id="nimoSpeechBubble" aria-live="polite">
                    <span id="nimoSpeechText">ไปเรียนด้วยกันนะ!</span>
                    <span class="speech-tail" aria-hidden="true"></span>
                </div>
            </div>
        }
    </div>

    @if (compact)
    {
        <a asp-controller="Home" asp-action="Courses" class="login-course-link">
            ดูคอร์สเรียน <span aria-hidden="true">→</span>
        </a>
    }
    else
    {
        <!-- Feature Tags Row -->
        <div class="hero-features-pill-row">
            <span class="feature-tag-pill">
                <svg class="tag-svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                <span>คอร์สออนไลน์</span>
            </span>
            <span class="feature-tag-pill">
                <svg class="tag-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline></svg>
                <span>พัฒนาทักษะ</span>
            </span>
            <span class="feature-tag-pill">
                <svg class="tag-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
                <span>ก้าวสู่อนาคต</span>
            </span>
        </div>

        <!-- Bottom Sub-Banner -->
        <a asp-controller="Home" asp-action="Courses" class="hero-bottom-sub-banner" title="สำรวจคอร์สเรียนทั้งหมด">
            <div class="sub-banner-content">
                <span class="sub-banner-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"></path><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path></svg>
                </span>
                <div class="sub-banner-text">
                    <strong>ออกแบบการเรียนรู้ที่เหมาะกับคุณ</strong>
                    <small>เรียนได้ทุกที่ ทุกเวลา บนแพลตฟอร์ม NextSkill</small>
                </div>
            </div>
            <div class="sub-banner-arrow" aria-hidden="true">→</div>
        </a>
    }

    <!-- Subtle Duolingo Island Ocean Wave Arc -->
    <div class="story-wave-decor" aria-hidden="true">
        <svg viewBox="0 0 500 60" preserveAspectRatio="none">
            <path d="M0,25 C150,55 350,0 500,28 L500,60 L0,60 Z" fill="rgba(255,255,255,0.06)"></path>
            <path d="M0,35 C180,10 320,50 500,32 L500,60 L0,60 Z" fill="rgba(255,255,255,0.12)"></path>
        </svg>
    </div>
</aside>
