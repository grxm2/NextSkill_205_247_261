<dialog id="companion-dialog" class="home-dialog companion-dialog" aria-labelledby="companion-title">
    <form method="dialog"><button class="dialog-close" aria-label="ปิดหน้าคู่หู">×</button></form>
    <header class="companion-header"><p class="eyebrow">คู่หูช่วยเรียน</p><h2 id="companion-title">มาเรียนไปด้วยกัน</h2><p>มีเพื่อนให้กำลังใจ แล้วไปต่อทีละก้าว</p></header>
    <div class="companion-layout">
        <section class="companion-stage" aria-label="คู่หูของคุณ">
            <span class="companion-level" data-companion-level>ระดับ 1 · เพื่อนใหม่</span>
            <div class="companion-portrait" aria-hidden="true"><span class="portrait-orbit"></span><span class="buddy-slot" data-buddy-anchor="studio"></span></div>
            <h3 data-buddy-name>Nimo</h3><p class="companion-emotion" id="companion-emotion">พร้อมเรียนไปด้วยกัน</p>
            <div class="companion-stage-actions"><button type="button" class="button button-primary" id="companion-high-five">ส่งกำลังใจ <span class="icon icon-star" aria-hidden="true"></span></button><button type="button" class="companion-rest" id="companion-motion">พักการเคลื่อนไหว</button></div>
            <button type="button" class="buddy-read-button" data-buddy-pose="read">อ่านหนังสือด้วยกัน <span class="icon icon-book" aria-hidden="true"></span></button>
            <p class="companion-activity" id="companion-activity">พร้อมเริ่มเรียน</p>
            <div class="companion-speech" id="companion-speech">ไปด้วยกันทีละก้าว</div>
            <details class="buddy-break"><summary>พักสักครู่</summary><div class="companion-pose-buttons" role="group" aria-label="เล่นกับคู่หู"><button type="button" data-buddy-pose="walk">โยกตัวเล่น</button><button type="button" data-buddy-pose="dance">โยกตามจังหวะ</button><button type="button" data-buddy-pose="celebrate">กระโดดดีใจ</button><button type="button" data-buddy-pose="stretch">ขยับพักสักนิด</button></div></details>
        </section>
        <div class="companion-content">
            <div class="companion-tabs" role="tablist" aria-label="กิจกรรมคู่หู"><button type="button" role="tab" id="companion-tab-buddy" aria-controls="companion-panel-buddy" aria-selected="true" tabindex="0">คู่หูของฉัน</button><button type="button" role="tab" id="companion-tab-style" aria-controls="companion-panel-style" aria-selected="false" tabindex="-1">แต่งตัว</button><button type="button" role="tab" id="companion-tab-play" aria-controls="companion-panel-play" aria-selected="false" tabindex="-1">เล่นเกม</button></div>
            <section id="companion-panel-buddy" class="companion-panel" role="tabpanel" aria-labelledby="companion-tab-buddy">
                <p class="companion-kicker">เริ่มจากก้าวเล็ก ๆ</p><h3>ค่อย ๆ เพิ่มความมั่นใจ</h3><p>วันนี้ลองฝึกแค่หนึ่งประโยคก็เป็นก้าวที่ดีแล้ว</p>
                <div class="buddy-study-card"><span class="companion-kicker">บทเรียนถัดไป</span><h4 id="buddy-study-title">Feedback patterns</h4><p>ลองเริ่มบทสนทนาด้วยประโยคนี้</p><blockquote>“Could we try a different approach?”</blockquote><p class="buddy-study-meaning">ลองเสนอทางเลือกอย่างสุภาพ แทนการบอกว่าอีกฝ่ายทำผิด</p><button type="button" class="button button-primary" id="buddy-continue-study">เปิดตัวอย่างบทเรียน <span class="icon icon-arrow-right" aria-hidden="true"></span></button><button type="button" class="buddy-encourage" id="buddy-encourage">ขอกำลังใจหน่อย</button><p class="buddy-study-note">ตัวอย่างบทเรียน ยังไม่บันทึกผลการเรียน</p></div>
                <div class="bond-card"><div class="bond-heading"><span>ความสนิทกับคู่หู</span><strong id="companion-stars">0 ดาว</strong></div><progress id="companion-bond" value="0" max="3" aria-label="ความก้าวหน้าระดับคู่หู">0 / 3</progress><p id="companion-next-level">อีก 3 ดาวเพื่อขึ้นระดับ 2</p></div>
                <div class="companion-next-unlock"><span class="icon icon-star" aria-hidden="true"></span><div><strong id="companion-next-unlock">ของแต่งชิ้นแรก: เข็มกลัดดาว</strong><span id="companion-unlock-hint">เล่นเกมเพื่อสะสม 1 ดาว</span></div></div>
                <label class="companion-field-label" for="companion-name">ตั้งชื่อคู่หู</label><form id="companion-name-form" class="companion-name-form"><input id="companion-name" name="companionName" maxlength="18" autocomplete="off" required aria-describedby="companion-name-hint" /><button type="submit" class="companion-small-button">บันทึกชื่อ</button></form><p class="companion-field-hint" id="companion-name-hint">ตั้งชื่อได้ไม่เกิน 18 ตัวอักษร</p>
                <button type="button" class="text-button companion-play-link" data-companion-tab="play">ลองเล่นรอบแรก <span class="icon icon-arrow-right" aria-hidden="true"></span></button>
            </section>
            <section id="companion-panel-style" class="companion-panel" role="tabpanel" aria-labelledby="companion-tab-style" hidden>
                <p class="companion-kicker">สไตล์ของคู่หู</p><h3>ลุคประจำตัวของ Nimo</h3><p id="companion-art-note">ตอนนี้ Nimo ใช้ลุคประจำตัว การเปลี่ยนสีและของแต่งยังไม่เปิดใช้งาน ตัวเลือกที่เคยบันทึกไว้ยังอยู่ครบ</p>
                <h4 class="companion-field-label">สี</h4><div class="companion-colours" role="group" aria-label="สีคู่หู"><button type="button" class="companion-swatch swatch-sprout" data-companion-colour="sprout" aria-pressed="true" aria-label="สีเขียว"><span></span>เขียว</button><button type="button" class="companion-swatch swatch-sky" data-companion-colour="sky" aria-pressed="false" aria-label="สีฟ้า"><span></span>ฟ้า</button><button type="button" class="companion-swatch swatch-sunshine" data-companion-colour="sunshine" aria-pressed="false" aria-label="สีเหลือง"><span></span>เหลือง</button><button type="button" class="companion-swatch swatch-berry" data-companion-colour="berry" aria-pressed="false" aria-label="สีม่วง"><span></span>ม่วง</button></div>
                <h4 class="companion-field-label">ของแต่ง</h4><div class="companion-accessories" role="group" aria-label="ของแต่งคู่หู"><button type="button" data-companion-accessory="none" aria-pressed="true"><span class="accessory-art accessory-plain" aria-hidden="true">n↗</span><strong>ไม่ใส่ของแต่ง</strong><small>เลือกได้เสมอ</small></button><button type="button" data-companion-accessory="star" aria-pressed="false" disabled><span class="accessory-art accessory-star" aria-hidden="true"><span class="icon icon-star"></span></span><strong>เข็มกลัดดาว</strong><small>1 ดาวคู่หู</small></button><button type="button" data-companion-accessory="scarf" aria-pressed="false" disabled><span class="accessory-art accessory-scarf" aria-hidden="true"></span><strong>ผ้าพันคอ</strong><small>3 ดาวคู่หู</small></button></div>
                <p class="companion-field-hint">ดาวคู่หูจากเกมพักสมองยังสะสมได้ แยกจาก XP การเรียน</p>
            </section>
            <section id="companion-panel-play" class="companion-panel" role="tabpanel" aria-labelledby="companion-tab-play" hidden>
                <p class="companion-kicker">พักสมองสักนิด</p><h3>เกมจำสัญลักษณ์</h3><p>จำสัญลักษณ์ 3 ตัว แล้วเลือกตามลำดับ ไม่ต้องรีบ</p>
                <div class="signal-game" id="signal-game" data-phase="idle"><div class="signal-game-heading"><span id="signal-instruction">พร้อมเมื่อไรก็เริ่มได้</span><span class="signal-reward">+1 ดาวคู่หู</span></div><div id="signal-sequence" class="signal-sequence" aria-label="ลำดับสัญลักษณ์"><span class="signal-card">?</span><span class="signal-card">?</span><span class="signal-card">?</span></div><div class="signal-inputs" role="group" aria-label="เลือกตามลำดับ"><button type="button" data-signal-choice="book" disabled><span class="icon icon-book" aria-hidden="true"></span>หนังสือ</button><button type="button" data-signal-choice="bolt" disabled><span class="icon icon-lightning" aria-hidden="true"></span>สายฟ้า</button><button type="button" data-signal-choice="star" disabled><span class="icon icon-star" aria-hidden="true"></span>ดาว</button></div><button type="button" class="button button-primary signal-action" id="signal-action">เริ่มรอบใหม่ <span class="icon icon-arrow-right" aria-hidden="true"></span></button><p class="signal-result" id="signal-result" role="status" aria-live="polite"></p></div>
                <p class="companion-field-hint">ดาวคู่หูใช้ปลดล็อกของแต่ง แยกจาก XP และผลการเรียน</p>
            </section>
        </div>
    </div>
    <footer class="companion-storage-note" id="companion-storage-note">ข้อมูลคู่หูเก็บในเบราว์เซอร์นี้ แยกจากผลการเรียน</footer>
    <div class="sr-only" id="companion-status" role="status" aria-live="polite"></div>
</dialog>
