@model HomeDashboardViewModel
@{
    var courses = ViewContext.RouteData.Values["controller"]?.ToString() == "Courses";
    var homeUrl = Url.Action("Index", "Home");
}
<header class="app-sidebar">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="หน้าแรก NextSkill"><span class="brand-mark" aria-hidden="true">n<span>↗</span></span>nextskill<span class="brand-period">.</span></a>
    <p class="sidebar-caption">พื้นที่ของคุณ</p>
    <nav class="desktop-nav" aria-label="เมนูหลัก">
        <a class="nav-link @(!courses ? "active" : "")" title="เส้นทางเรียน" href="@(courses ? homeUrl + "#learning-path" : "#learning-path")" aria-current="@(!courses ? "page" : null)"><span class="icon icon-book" aria-hidden="true"></span><span class="nav-label">เรียนรู้</span>@if (!courses) { <span class="nav-dot" aria-hidden="true"></span> }</a>
        <a class="nav-link @(courses ? "active" : "")" title="คอร์สเรียน" asp-controller="Courses" asp-action="Enrollment" aria-current="@(courses ? "page" : null)"><span class="icon icon-grid" aria-hidden="true"></span><span class="nav-label">คอร์สเรียน</span>@if (courses) { <span class="nav-dot" aria-hidden="true"></span> }</a>
        <a class="nav-link" title="ภารกิจวันนี้" href="@(courses ? homeUrl + "#daily-quests" : "#daily-quests")"><span class="icon icon-lightning" aria-hidden="true"></span><span class="nav-label">ภารกิจวันนี้</span></a>
        <button class="nav-link" title="อันดับของฉัน" data-open-dialog="league-dialog"><span class="icon icon-trophy" aria-hidden="true"></span><span class="nav-label">อันดับของฉัน</span></button>
        <button class="nav-link" title="คู่หูของฉัน" data-open-dialog="companion-dialog"><span class="icon icon-star" aria-hidden="true"></span><span class="nav-label">คู่หูของฉัน</span></button>
    </nav>
    <div class="sidebar-bottom"><div class="sidebar-note"><span class="icon icon-book" aria-hidden="true"></span><p>เรียนทีละนิด<br><strong>ไปได้ไกลกว่าที่คิด</strong></p></div><div class="sidebar-profile"><span class="avatar" aria-hidden="true">G</span><div><strong>@Model.LearnerName</strong><span>สมาชิก Learning Club</span></div><span class="profile-spark" aria-hidden="true">↗</span></div></div>
</header>
