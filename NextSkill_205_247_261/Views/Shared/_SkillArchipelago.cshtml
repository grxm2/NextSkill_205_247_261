@model HomeDashboardViewModel
@{
    string[] lessonNames = ["แนะนำตัวให้รู้จัก", "คุยเรื่องงาน", "ให้ฟีดแบ็กอย่างสร้างสรรค์", "นำเสนออย่างมั่นใจ", "เจรจาธุรกิจ", "เขียนอีเมลให้ชัดเจน", "ประชุมให้ได้ข้อสรุป", "ทำงานเป็นทีม", "แก้ปัญหาร่วมกัน", "แบ่งปันไอเดีย", "พูดคุยกับลูกค้า", "รับมือความเห็นต่าง", "เล่าเรื่องให้เข้าใจ", "นำวงสนทนา", "นำเสนอโปรเจกต์", "ภารกิจในที่ทำงาน"];
    var skills = new[] {
        new { Key = "english", Number = "01", Name = "เกาะภาษา", Course = "English for Business", Category = "ภาษาและการสื่อสาร", Description = "ฝึกอังกฤษที่ได้ใช้จริง ตั้งแต่คุยกับทีมจนถึงนำเสนอไอเดียในที่ทำงาน", Count = 16, Link = "#island-english" },
        new { Key = "ux", Number = "02", Name = "เกาะนักออกแบบ", Course = "UX Research", Category = "การออกแบบและเข้าใจผู้ใช้", Description = "ตั้งคำถามให้ตรงจุด ฟังสิ่งที่ผู้ใช้ต้องการ แล้วเปลี่ยนสิ่งที่พบเป็นแนวทางออกแบบ", Count = 3, Link = "/Home/Details/1" },
        new { Key = "javascript", Number = "03", Name = "เกาะนักพัฒนา", Course = "JavaScript Basics", Category = "เทคโนโลยีและการเขียนโค้ด", Description = "ต่อยอดจากงานออกแบบ สู่หน้าเว็บที่โต้ตอบได้ ลองเขียนโค้ดทีละแนวคิดไปกับ Niko", Count = 10, Link = "/Home/Details/5" }
    };
}
<partial name="_ArchipelagoIslands" />
<div class="map-guide" data-learner="@Model.LearnerName" data-motion="active" hidden><button type="button" id="buddy-motion" hidden>พักการเคลื่อนไหวคู่หู</button></div>
<section class="island-expedition" id="sea-workspace" aria-labelledby="island-journey-title">
    <header class="island-expedition-header" id="learning-path">
        <div><p class="island-eyebrow">Journey ของคุณ</p><h2 id="island-journey-title">หมู่เกาะทักษะของคุณ</h2><p>ล่องเรือไปทีละเกาะ เรียนรู้ทีละสกิล พร้อม Niko คู่หูของคุณ</p></div>
        <div class="island-expedition-stats" aria-label="สถิติการเรียนตัวอย่าง"><span><span class="icon icon-fire" aria-hidden="true"></span><strong>@Model.StreakDays</strong> วัน</span><span><span class="icon icon-lightning" aria-hidden="true"></span><strong>@Model.TotalXp.ToString("N0")</strong> XP</span><button type="button" id="arch-locate"><span class="icon icon-compass" aria-hidden="true"></span> เรียนต่อ</button></div>
    </header>
    <nav class="island-ports" aria-label="ไปยังเกาะทักษะ">
        @foreach (var skill in skills)
        { <button type="button" data-select-island="@skill.Key" aria-pressed="@(skill.Key == "english" ? "true" : "false")"><span>@skill.Number</span>@skill.Name<span class="icon @(skill.Key == "english" ? "icon-compass" : "icon-lock")" aria-hidden="true"></span></button> }
        <span><strong id="arch-open-count">1</strong> / 3 เกาะที่เปิดเส้นทาง</span>
    </nav>
    <section class="island-mission" id="daily-quests" aria-labelledby="arch-voyage-title"><span class="island-mission-icon"><span class="icon icon-compass" aria-hidden="true"></span></span><div><h3 id="arch-voyage-title">จากภาษา สู่การออกแบบ</h3><p id="arch-voyage-description">ฝึกฟีดแบ็กกับ Niko ครบ 3 สถานการณ์ เพื่อเปิดหมอกไปยังเกาะ UX</p></div><button type="button" id="arch-voyage-action">เริ่มภารกิจเปิดเส้นทาง <span aria-hidden="true">→</span></button></section>
    <div class="island-chart" id="arch-chart" role="group" aria-label="เส้นทางหมู่เกาะทักษะ เรียงจากเกาะภาษาลงไปเกาะนักออกแบบและเกาะนักพัฒนา">
        <div class="island-ocean-rings" aria-hidden="true"></div>
        <svg class="island-sea-routes" aria-hidden="true"><path class="route-ux route-border"/><path class="route-ux route-line"/><path class="route-javascript route-border"/><path class="route-javascript route-line"/></svg>
        @foreach (var skill in skills)
        {
            <article class="island-stop stop-@skill.Key @(skill.Key == "english" ? "is-selected" : "is-fogged")" id="island-@skill.Key" data-stop="@skill.Key" aria-labelledby="island-title-@skill.Key">
                <div class="island-stop-art">
                    <button type="button" class="arch-island island-@skill.Key @(skill.Key == "english" ? "is-selected" : "is-fogged")" data-island="@skill.Key" aria-pressed="@(skill.Key == "english" ? "true" : "false")" aria-label="สำรวจ@skill.Name">
                        @if (skill.Key == "english") { <span class="arch-pin">คุณอยู่ที่นี่</span> }
                        <svg viewBox="0 0 360 290" aria-hidden="true"><use href="#arch-island-@skill.Key"/></svg>
                        @if (skill.Key != "english") { <span class="arch-fog" aria-hidden="true"><svg viewBox="0 0 240 100"><use href="#arch-cloud"/></svg><svg viewBox="0 0 240 100"><use href="#arch-cloud"/></svg></span> }
                        <span class="arch-island-label"><span class="arch-island-number">@skill.Number</span><span><strong>@skill.Name</strong><small>@skill.Course</small></span><span class="arch-island-state" data-island-state="@skill.Key">@(skill.Key == "english" ? "2/16" : "รอสำรวจ")</span></span>
                    </button>
                </div>
                <section class="island-stop-content" aria-labelledby="island-title-@skill.Key">
                    <div class="island-stop-meta"><span>เกาะ @skill.Number · @skill.Category</span><span class="island-stop-state" data-stop-state="@skill.Key">@(skill.Key == "english" ? "กำลังเรียน" : "ยังมีหมอกบัง")</span></div>
                    <h3 id="island-title-@skill.Key">@skill.Name</h3><p class="island-course-title">@skill.Course</p><p class="island-description">@skill.Description</p>
                    <div class="island-progress"><div><span data-progress-caption="@skill.Key">สำรวจแล้ว @(skill.Key == "english" ? "2" : "0") จาก @skill.Count ด่าน</span><strong data-progress-value="@skill.Key">@(skill.Key == "english" ? "13%" : "0%")</strong></div><progress data-progress="@skill.Key" max="@skill.Count" value="@(skill.Key == "english" ? 2 : 0)" aria-label="ความก้าวหน้าของ@skill.Name"></progress></div>
                    <p class="island-next" data-next-lesson="@skill.Key">@(skill.Key == "english" ? "ด่านถัดไป · ให้ฟีดแบ็กอย่างสร้างสรรค์" : skill.Key == "ux" ? "เปิดเส้นทางเมื่อฝึกฟีดแบ็กกับ Niko ครบ 3 สถานการณ์" : "เปิดเส้นทางเมื่อผ่านแบบฝึก UX ทั้ง 3 ด่าน")</p>
                    <div class="island-stop-actions"><button type="button" class="arch-button" data-start-island="@skill.Key">@(skill.Key == "english" ? "เรียนต่อกับ Niko" : "ไปเปิดเส้นทาง") <span aria-hidden="true">→</span></button><a href="@skill.Link" class="island-course-link" data-course-link="@skill.Key">@(skill.Key == "english" ? "เลือกด่าน" : "รายละเอียดคอร์ส ↗")</a></div>
                    <details class="island-lesson-picker" data-lessons-for="@skill.Key"><summary><span>ด่านบนเกาะนี้</span><span data-lesson-count="@skill.Key">@skill.Count ด่าน</span></summary><div class="island-lesson-list" data-lesson-list="@skill.Key" aria-label="ด่านบน@skill.Name"></div><p class="island-lesson-hint">สีฟ้าคือด่านปัจจุบัน · สีเขียวกลับมาทบทวนได้</p></details>
                </section>
            </article>
        }
        <div class="arch-vessel" id="arch-vessel" aria-label="Niko ล่องเรือไปกับคุณ"><div class="arch-vessel-inner"><span class="arch-vessel-wake" aria-hidden="true"></span><div class="arch-captain"><span class="buddy-slot" data-buddy-anchor="harbor" id="arch-map-buddy"></span></div><svg class="arch-boat" viewBox="0 0 150 85" aria-hidden="true"><path d="m14 34 23-10 74 4 26 13-24 24-67 4Z" fill="#cfa274"/><path d="m14 34 32 20 67-5 24-8-24 24-67 4Z" fill="#aa785b"/><path d="m15 34 31 17 67-5 24-5" fill="none" stroke="#ffdc9c" stroke-width="5"/><path d="M77 31V1" stroke="#a57b5b" stroke-width="3"/><path d="m79 2 24 10-24 8Z" fill="#fff8dd"/><path d="m49 61 56-3" stroke="#e8bd85" stroke-width="3"/></svg><span class="arch-captain-name" data-buddy-name>Niko</span></div></div>
        <svg class="island-drift-cloud drift-one" data-cloud-depth="0.065" viewBox="0 0 240 100" aria-hidden="true"><use href="#arch-cloud"/></svg><svg class="island-drift-cloud drift-two" data-cloud-depth="-0.075" viewBox="0 0 240 100" aria-hidden="true"><use href="#arch-cloud"/></svg><svg class="island-drift-cloud drift-three" data-cloud-depth="0.085" viewBox="0 0 240 100" aria-hidden="true"><use href="#arch-cloud"/></svg><svg class="island-drift-cloud drift-four" data-cloud-depth="-0.05" viewBox="0 0 240 100" aria-hidden="true"><use href="#arch-cloud"/></svg>
        <span class="island-sea-note sea-note-one" aria-hidden="true">จากการสื่อสาร สู่ความเข้าใจผู้ใช้</span><span class="island-sea-note sea-note-two" aria-hidden="true">จากไอเดีย สู่สิ่งที่สร้างได้จริง</span>
    </div>
    <footer class="island-expedition-footer"><p><span class="icon icon-compass" aria-hidden="true"></span> ทุกเกาะเชื่อมต่อกันด้วยทักษะที่คุณเรียนรู้</p><div><button type="button" id="buddy-tour-start">ให้ Niko แนะนำ <span aria-hidden="true">↗</span></button><button type="button" id="arch-motion" aria-pressed="false"><span class="icon icon-pause" aria-hidden="true"></span><span>พักการเคลื่อนไหว</span></button><button type="button" id="arch-reset">เริ่มแผนที่ตัวอย่างใหม่</button></div><span class="island-preview-note">แผนที่และสถิติเริ่มต้นเป็นข้อมูลตัวอย่าง · การเปิดเกาะบันทึกในเบราว์เซอร์นี้ แยกจากผลเรียนและ XP จริง</span></footer>
</section>
<dialog id="arch-challenge" class="home-dialog arch-challenge" aria-labelledby="arch-challenge-title"><form method="dialog"><button class="dialog-close" aria-label="ปิดแบบฝึก">×</button></form><div class="arch-challenge-character"><span class="buddy-slot" data-buddy-anchor="challenge"></span></div><p class="arch-eyebrow" id="arch-challenge-island">เกาะนักออกแบบ · แบบฝึกเปิดเส้นทาง</p><h2 id="arch-challenge-title" tabindex="-1">เริ่มจากเข้าใจผู้ใช้</h2><p id="arch-challenge-question"></p><div id="arch-challenge-options" class="arch-challenge-options"></div><p id="arch-challenge-feedback" role="status" aria-live="polite"></p><button type="button" class="arch-button" id="arch-challenge-next" hidden>ข้อต่อไป →</button><p class="arch-small-note">แบบฝึกตัวอย่าง · บันทึกเฉพาะแผนที่ในเบราว์เซอร์นี้ ไม่คิด XP และไม่ใช้หัวใจ</p></dialog>
<dialog id="arch-reset-dialog" class="home-dialog" aria-labelledby="arch-reset-title"><form method="dialog"><button class="dialog-close" aria-label="ปิด">×</button></form><h2 id="arch-reset-title">เริ่มสำรวจแผนที่ใหม่?</h2><p>รีเซ็ตเฉพาะการเปิดเกาะและแบบฝึกตัวอย่างของแผนที่นี้ ชื่อ สี และของแต่ง Niko จะยังอยู่</p><div class="arch-reset-actions"><form method="dialog"><button class="arch-secondary-button">เก็บความก้าวหน้าไว้</button></form><button class="arch-button" type="button" id="arch-reset-confirm">เริ่มแผนที่ใหม่</button></div></dialog>
<dialog id="arch-tour-dialog" class="home-dialog arch-tour" aria-labelledby="arch-tour-title"><form method="dialog"><button class="dialog-close" aria-label="ปิดวิธีสำรวจ">×</button></form><div class="arch-challenge-character"><span class="buddy-slot" data-buddy-anchor="tour"></span></div><p class="arch-eyebrow">ออกเดินทางกับ <span data-buddy-name>Niko</span></p><h2 id="arch-tour-title">สามเกาะ ทักษะที่ต่อยอดกัน</h2><ol><li><strong>เลือกเกาะที่อยากสำรวจ</strong><p>กดที่เกาะเพื่อดูทักษะ จำนวนด่าน และสิ่งที่จะได้ฝึก แผนที่แสดงความก้าวหน้าในที่เดียว</p></li><li><strong>เริ่มที่ด่านสีฟ้า</strong><p>เลื่อนลงมาที่ Journey หรือกดเรียนต่อกับ Niko ฝึกทีละเรื่อง และกลับมาทบทวนด่านที่ผ่านแล้วได้เสมอ</p></li><li><strong>เปิดหมอก แล้วล่องเรือไปเกาะใหม่</strong><p>ฝึกฟีดแบ็กครบ 3 สถานการณ์เพื่อไปเกาะ UX จากนั้นผ่านแบบฝึก UX ทั้ง 3 ด่านเพื่อไป JavaScript</p></li></ol><p class="arch-small-note">นี่คือแผนที่ตัวอย่าง การเปิดเกาะบันทึกในเบราว์เซอร์นี้ แยกจากผลการเรียนและ XP จริง</p><form method="dialog"><button class="arch-button">พร้อมออกเดินทาง →</button></form></dialog>
<script type="application/json" id="arch-data">@Json.Serialize(new { lessons = Model.Lessons.Select(lesson => new { number = lesson.Number, title = lesson.Title, status = lesson.Status }), lessonNames })</script>

