@{
    var courses = ViewContext.RouteData.Values["controller"]?.ToString() == "Courses";
    var homeUrl = Url.Action("Index", "Home");
}
<nav class="mobile-nav" aria-label="เมนูสำหรับมือถือ">
    <a href="@(courses ? homeUrl + "#learning-path" : "#learning-path")" aria-current="@(!courses ? "page" : null)"><span class="icon icon-book" aria-hidden="true"></span>เรียนรู้</a>
    <a asp-controller="Courses" asp-action="Enrollment" aria-current="@(courses ? "page" : null)"><span class="icon icon-grid" aria-hidden="true"></span>คอร์ส</a>
    <a href="@(courses ? homeUrl + "#daily-quests" : "#daily-quests")"><span class="icon icon-lightning" aria-hidden="true"></span>ภารกิจ</a>
    <button data-open-dialog="league-dialog"><span class="icon icon-trophy" aria-hidden="true"></span>อันดับ</button>
    <button type="button" data-open-dialog="companion-dialog"><span class="icon icon-star" aria-hidden="true"></span>คู่หู</button>
</nav>
