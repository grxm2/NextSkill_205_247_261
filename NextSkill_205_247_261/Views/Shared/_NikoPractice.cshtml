@model HomeDashboardViewModel
<dialog id="niko-practice-dialog" class="home-dialog niko-practice-dialog" aria-labelledby="niko-practice-title" aria-describedby="niko-practice-description">
    <form method="dialog"><button class="dialog-close" aria-label="ปิดแบบฝึกกับ Niko">×</button></form>
    <header class="niko-practice-header"><div><p class="eyebrow">Feedback patterns · ฝึกสั้นกับคู่หู</p><h2 id="niko-practice-title">ค่อย ๆ ฝึกไปกับ <span data-buddy-name>Niko</span></h2><p id="niko-practice-description">ลองเลือกประโยคที่ให้ฟีดแบ็กอย่างสุภาพ</p></div><div class="niko-practice-character"><span class="buddy-slot" data-buddy-anchor="practice"></span></div></header>
    <div class="niko-practice-progress"><span id="niko-question-count">สถานการณ์ 1 / 3</span><progress id="niko-question-progress" value="0" max="3" aria-label="ความก้าวหน้าของแบบฝึก">0 / 3</progress></div>
    <section id="niko-question-panel" aria-labelledby="niko-question-title"><h3 id="niko-question-title" tabindex="-1">เลือกประโยคที่เหมาะกับสถานการณ์</h3><div class="niko-answer-options" id="niko-answer-options" role="group" aria-labelledby="niko-question-title"></div><button type="button" class="niko-hint-button" id="niko-show-hint">ขอคำใบ้จาก <span data-buddy-name>Niko</span></button><p class="niko-hint" id="niko-hint" hidden></p></section>
    <div class="niko-practice-feedback" id="niko-practice-feedback" role="status" aria-live="polite" hidden><strong id="niko-feedback-title"></strong><p id="niko-feedback-text"></p></div>
    <div class="niko-question-actions"><button type="button" id="niko-listen" class="niko-listen-button" aria-pressed="false" hidden>ฟังประโยคแล้วลองพูดตาม</button><button type="button" id="niko-next-question" class="button button-primary" hidden>สถานการณ์ถัดไป <span aria-hidden="true">→</span></button></div>
    <p class="niko-audio-status" id="niko-audio-status" role="status"></p>
    <section id="niko-practice-summary" class="niko-practice-summary" aria-labelledby="niko-summary-title" hidden><div class="niko-summary-heading"><span class="niko-summary-score" aria-label="ฝึกครบ 3 จาก 3 สถานการณ์">3/3</span><div><h3 id="niko-summary-title" tabindex="-1">พร้อมใช้ฟีดแบ็กอย่างมั่นใจขึ้นแล้ว</h3><p>จำ 3 ก้าวนี้ไว้ แล้วลองใช้ในบทเรียนต่อได้เลย</p></div></div><ol class="niko-summary-phrases"><li><strong>“One thing that worked well was…”</strong><span>เริ่มจากสิ่งที่ทำได้ดี</span></li><li><strong>“Could we try a different approach?”</strong><span>เสนอทางเลือกอย่างสุภาพ</span></li><li><strong>“How does that sound to you?”</strong><span>เปิดโอกาสให้อีกฝ่ายร่วมตัดสินใจ</span></li></ol><div class="niko-summary-actions"><button type="button" id="niko-continue-lesson" class="button button-primary">เปิดบทเรียนนี้ต่อ <span class="icon icon-arrow-right" aria-hidden="true"></span></button><button type="button" id="niko-restart-practice" class="niko-hint-button">ฝึกอีกครั้ง</button></div></section>
    <p class="niko-practice-note">แบบฝึกเสริม ไม่ใช้หัวใจและไม่คิด XP · จำความก้าวหน้าในเบราว์เซอร์นี้</p>
</dialog>
