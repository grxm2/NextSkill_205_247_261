@* One ocean camera and artwork for course discovery and the learning islands. *@
<div class="island-water-motion ocean-surface-world is-paused" data-sea-world aria-hidden="true">
    <span class="ocean-horizon-anchor"></span>
    <div class="underwater-surface">
        <div class="surface-ocean-waves"><div class="surface-ocean-wave surface-ocean-wave--far"></div><div class="surface-ocean-wave surface-ocean-wave--near"></div></div>
    </div>
    <div class="island-water-layer island-water-layer--far"><div class="island-water-drift"></div></div>
    <div class="island-water-layer island-water-layer--near"><div class="island-water-drift"></div></div>
</div>
