@model HomeDashboardViewModel
@{
    var currentLesson = Model.Lessons.FirstOrDefault(lesson => lesson.Status == "current");
    var accountAction = User.Identity?.IsAuthenticated == true
        ? (User.IsInRole("Admin") ? "AdminDashboard" : "Dashboard") : "Login";
}
<header class="sea-nav">
    <a class="sea-brand" asp-controller="Home" asp-action="Index" aria-label="SeaLearn หน้าแรก">
        <svg class="sea-brand-symbol" viewBox="0 0 56 44" fill="none" aria-hidden="true"><path d="M3 17C14 17 14 5 26 5S39 17 53 8C44 27 33 19 25 16S12 14 3 17Z" fill="url(#sea-wave)"/><path d="M3 34C14 34 16 22 28 24S40 36 53 25C45 45 33 38 25 34S12 31 3 34Z" fill="url(#sea-wave)"/><defs><linearGradient id="sea-wave" x1="12" y1="8" x2="42" y2="39" gradientUnits="userSpaceOnUse"><stop stop-color="#89edff"/><stop offset="1" stop-color="#0789dc"/></linearGradient></defs></svg>
        <span>SeaLearn<small>LEARN · PLAY · GROW</small></span>
    </a>
    <button class="sea-menu-button" type="button" aria-expanded="false" aria-controls="sea-menu">
        เมนู <span aria-hidden="true">☰</span>
    </button>
    <nav id="sea-menu" class="sea-glass" aria-label="เมนู SeaLearn">
        <a href="#sea-home" aria-current="page"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="m12 3 10 9h-3v9h-5v-6h-4v6H5v-9H2Z"/></svg>หน้าแรก</a>
        <a asp-controller="Home" asp-action="Courses">คอร์สเรียน</a>
        <a href="#learning-path">เส้นทางเรียน</a>
        <a href="#daily-quests">ภารกิจ</a>
        <details class="sea-more">
            <summary>เพิ่มเติม</summary>
            <div class="sea-glass">
                <a href="#sea-community">ชุมชน</a>
                <a asp-controller="Courses" asp-action="Enrollment">จัดการคอร์สเรียน</a>
                <button type="button" data-open-dialog="companion-dialog">คู่หูของฉัน</button>
                <button type="button" data-open-dialog="league-dialog">อันดับของฉัน</button>
                <a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
            </div>
        </details>
    </nav>
    <form class="sea-search" asp-controller="Home" asp-action="Courses" method="get" role="search">
        <label class="sr-only" for="sea-query">ค้นหาคอร์สที่อยากเรียน</label>
        <input id="sea-query" type="search" name="q" placeholder="ค้นหาคอร์สที่สนใจ..." maxlength="200" />
        <button type="submit" aria-label="ค้นหาคอร์ส"><span class="icon icon-arrow-right" aria-hidden="true"></span></button>
    </form>
    <a class="sea-account" asp-controller="Account" asp-action="@accountAction">
        <span class="sea-avatar" aria-hidden="true">@(User.Identity?.IsAuthenticated == true ? Model.LearnerName.FirstOrDefault().ToString() : "↗")</span>
        <span>@(User.Identity?.IsAuthenticated == true ? "บัญชีของฉัน" : "เข้าสู่ระบบ")</span>
    </a>
</header>
<main class="sea-landing" id="sea-home" tabindex="-1">
    <section class="sea-hero" aria-labelledby="sea-title">
        <div class="sea-world" aria-hidden="true">
            <img class="sea-landscape" data-sea-depth="0.45" src="~/images/sea-home-academy.webp" width="1660" height="948" fetchpriority="high" alt="" />
            <div class="sea-cloud sea-cloud-one" data-sea-depth="0.8"></div>
            <div class="sea-cloud sea-cloud-two" data-sea-depth="1.2"></div>
            <div class="sea-mist" data-sea-depth="1.5"></div>
        </div>
        <div class="sea-hero-inner">
            <div class="sea-hero-copy">
                <p class="sea-kicker"><span class="icon icon-star" aria-hidden="true"></span> LEARN · EXPLORE · LEVEL UP</p>
<<<<<<< Updated upstream
                <h1 id="sea-title">เรียนรู้วันนี้<br /><span>เพื่อเวอร์ชันที่ดีกว่าในอนาคต</span></h1>
                <p class="sea-subtitle">เปลี่ยนการเรียนรู้ให้เป็นการผจญภัย<br />ค้นพบสกิลใหม่ ในจังหวะของคุณ</p>
                <div class="sea-actions">
                    <button type="button" class="sea-button sea-primary" data-sea-practice aria-haspopup="dialog"><span class="icon icon-lightning" aria-hidden="true"></span> <span data-sea-practice-label>เริ่มภารกิจ</span> <span class="icon icon-arrow-right" aria-hidden="true"></span></button>
                    <a class="sea-button sea-secondary" href="#learning-path"><span class="icon icon-grid" aria-hidden="true"></span> แผนที่การผจญภัย</a>
                </div>
                <div class="sea-active-quest">
                    <span class="sea-quest-mark"><span class="icon icon-book" aria-hidden="true"></span></span>
                    <div><p>ภารกิจปัจจุบัน · แบบฝึกกับ Niko</p><strong>@currentLesson?.Title</strong><span>3 สถานการณ์ · ไม่ใช้หัวใจ · ไม่คิด XP</span></div>
                    <span class="sea-quest-direction" aria-hidden="true">›</span>
                </div>
            </div>
            <aside class="sea-progress sea-glass" aria-labelledby="sea-progress-title">
                <div class="sea-panel-heading">
                    <h2 id="sea-progress-title">บันทึกนักผจญภัย</h2>
                    <span class="sea-level">LV. @Model.CurrentLevel</span>
                </div>
                <div class="sea-player">
                    <img src="~/images/sea-compass-emblem.webp" alt="" width="128" height="128" />
                    <div><strong>@Model.LearnerName</strong><span>English for Business</span></div>
                    <span class="sea-player-hearts"><span class="icon icon-heart" aria-hidden="true"></span>@Model.Hearts/@Model.MaxHearts</span>
                </div>
                <div class="sea-progress-main">
                    <div class="sea-ring" style="--sea-progress: @Model.CourseProgress" role="img" aria-label="ความคืบหน้าตัวอย่าง @Model.CourseProgress เปอร์เซ็นต์">
                        <strong>@Model.CourseProgress<small>%</small></strong>
                    </div>
                    <div><p>เรียนไปแล้ว</p><strong>@Model.CompletedLessons จาก @Model.Lessons.Count ด่าน</strong><a href="#learning-path">เรียนต่อ <span aria-hidden="true">→</span></a></div>
                </div>
                <div class="sea-rewards">
                    <span><span class="icon icon-lightning" aria-hidden="true"></span><strong>@Model.TotalXp.ToString("N0")</strong> XP</span>
                    <span><span class="icon icon-grid" aria-hidden="true"></span>ปลดล็อก @Model.UnlockedIslands เกาะ</span>
                </div>
                <nav class="sea-mini-map" aria-label="ด่านเรียนใกล้คุณ">
                    @foreach (var lesson in Model.Lessons.Take(4))
                    {
                        @if (lesson.Status == "locked")
                        {
                            <span class="sea-map-stop is-locked"><span class="icon icon-lock" aria-hidden="true"></span><small>ด่าน @lesson.Number</small><span class="sr-only">ยังไม่ปลดล็อก</span></span>
                        }
                        else
                        {
                            <a class="sea-map-stop is-@lesson.Status" href="#lesson-@lesson.Number" aria-label="@(lesson.Status == "completed" ? "ทบทวน" : "ไปยัง") ด่าน @lesson.Number @lesson.Title"><span class="icon @(lesson.Status == "completed" ? "icon-check" : "icon-book")" aria-hidden="true"></span><small>ด่าน @lesson.Number</small></a>
                        }
                    }
                </nav>
                @if (Model.IsProgressPreview)
                {
                    <p class="sea-preview">ข้อมูลตัวอย่าง · ยังไม่บันทึกผลการเรียน</p>
                }
            </aside>
