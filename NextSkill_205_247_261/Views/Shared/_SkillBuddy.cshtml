<div class="skill-buddy nimo-buddy" data-character="nimo" data-colour="sky" aria-hidden="true">
    <div class="buddy-travel">
        <div class="buddy-rig">
            <div class="buddy-illustration-wrapper">
                <img src="/images/nimo-learning.png" alt="Nimo" class="buddy-avatar-img buddy-avatar-idle" />
                <img src="/images/nimo-rowing.png" alt="Nimo กำลังพายเรือ" class="buddy-avatar-img buddy-avatar-rowing" />
            </div>
            <!-- Structural elements preserved for script / query compatibility -->
            <div class="buddy-upper" style="opacity: 0; pointer-events: none; position: absolute; width: 0; height: 0; overflow: hidden;" aria-hidden="true">
                <div class="buddy-backpack"></div>
                <div class="buddy-tail"></div>
                <div class="buddy-antenna"><span class="star-tip">★</span></div>
                <div class="buddy-ear ear-left"></div><div class="buddy-ear ear-right"></div>
                <div class="buddy-body">
                    <div class="buddy-belly"></div>
                    <div class="buddy-face">
                        <span class="buddy-brow brow-left"></span><span class="buddy-brow brow-right"></span>
                        <span class="buddy-eye"><span class="buddy-pupil"><span class="eye-twinkle"></span></span></span>
                        <span class="buddy-eye"><span class="buddy-pupil"><span class="eye-twinkle"></span></span></span>
                        <span class="buddy-smile"></span>
                        <span class="buddy-cheek cheek-left"></span><span class="buddy-cheek cheek-right"></span>
                        <span class="buddy-tear"></span>
                    </div>
                    <span class="buddy-badge">n<span>↗</span></span>
                    <span class="buddy-star-pin"><span class="icon icon-star"></span></span>
                    <span class="buddy-scarf"><span></span></span>
                </div>
                <div class="buddy-book"><span class="book-page page-left"></span><span class="book-page page-right"></span><span class="book-page page-turn"></span><span class="book-hand hand-left"></span><span class="book-hand hand-right"></span></div>
                <span class="buddy-arm arm-left"></span><span class="buddy-arm arm-right"></span>
                <span class="buddy-mood-mark"></span>
            </div>
            <span class="buddy-leg leg-left" style="display:none;"></span><span class="buddy-leg leg-right" style="display:none;"></span>
            <span class="buddy-foot foot-left" style="display:none;"></span><span class="buddy-foot foot-right" style="display:none;"></span>
        </div>
        <span class="buddy-shadow"></span>
    </div>
</div>
