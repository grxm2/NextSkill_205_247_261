<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — NextSkill</title>
    <link rel="icon" href="~/home-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/Prompt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/Prompt-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-game.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
</head>
<body class="nimo-account-theme ns-site-shell">
    <partial name="_Navbar" />
    <main class="account-main">@RenderBody()</main>
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand-copy">
                <span>NextSkill · Upskill &amp; Reskill</span>
                <span class="footer-tagline">เก่งขึ้นทีละก้าว ไปด้วยกันกับ Nimo 💙</span>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
                <span aria-hidden="true">·</span>
                <a asp-controller="Account" asp-action="Terms">เงื่อนไขการใช้งาน</a>
            </div>
        </div>
    </footer>
    <script src="~/js/account.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
    <script src="~/js/navbar.js" asp-append-version="true" defer></script>
</body>
</html>
