<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — NextSkill</title>
    <link rel="icon" href="~/home-favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/Prompt-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="~/fonts/Prompt-SemiBold.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-game.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/nextskill-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/glass.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-modern.css" asp-append-version="true" />
</head>
<body class="nimo-account-theme ns-site-shell">
    <!-- Ambient Modern Glassmorphic Floating Decor -->
    <div class="account-ambient-decor" aria-hidden="true">
        <!-- Duolingo Daylight Floating Clouds -->
        <div class="duo-clouds-container">
            <div class="duo-cloud duo-cloud-1"></div>
            <div class="duo-cloud duo-cloud-2"></div>
            <div class="duo-cloud duo-cloud-3"></div>
        </div>

        <!-- Soft glowing aurora orbs -->
        <div class="ambient-glow-orb orb-1"></div>
        <div class="ambient-glow-orb orb-2"></div>
        <div class="ambient-glow-orb orb-3"></div>
        <div class="bg-dot-matrix dot-top-left"></div>
        <div class="bg-dot-matrix dot-mid-right"></div>
        
        <!-- Floating Glassmorphic Milestone Badges (Duolingo Tactile Style) -->
        <div class="ambient-float-card float-card-top-right duo-interactive-badge" role="button" tabindex="0" title="NextSkill Certified">
            <div class="float-card-icon-wrap icon-grad">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
            </div>
            <div class="float-card-info">
                <div class="badge-title-row">
                    <strong>NextSkill Certified</strong>
                    <span class="duo-mini-pill cyan">PRO</span>
                </div>
                <small>พัฒนาทักษะสู่มืออาชีพ</small>
            </div>
        </div>

        <div class="ambient-float-card float-card-mid-left duo-interactive-badge" role="button" tabindex="0" title="XP Booster">
            <div class="float-card-icon-wrap icon-xp">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            </div>
            <div class="float-card-info">
                <div class="badge-title-row">
                    <strong>เรียนสนุก +150 XP</strong>
                    <span class="duo-mini-pill gold">STREAK</span>
                </div>
                <small>สะสมความรู้ทุกวัน</small>
            </div>
        </div>

        <div class="ambient-float-card float-card-bot-left duo-interactive-badge" role="button" tabindex="0" title="Skill Roadmap">
            <div class="float-card-icon-wrap icon-rocket">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            </div>
            <div class="float-card-info">
                <div class="badge-title-row">
                    <strong>ก้าวสู่อนาคต</strong>
                    <span class="duo-mini-pill green">LVL UP</span>
                </div>
                <small>เริ่มต้นเส้นทางของคุณ</small>
            </div>
        </div>
    </div>

    <!-- Floating Modern Pill Navbar matching reference design -->
    <header class="site-header" role="banner">
        <a asp-controller="Home" asp-action="Index" class="account-brand" aria-label="NextSkill กลับหน้าแรก">
            <div class="brand-symbol-wrap" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4v16l8-10 8 10V4" />
                </svg>
            </div>
            <div class="brand-text-row">
                <strong>NextSkill</strong>
                <span class="brand-divider">|</span>
                <small>ก้าวต่อไปในเส้นทางของคุณ</small>
            </div>
        </a>

        <nav class="account-nav-center" aria-label="เมนูหลัก">
            <a asp-controller="Home" asp-action="Index">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                <span>หน้าแรก</span>
            </a>
            <a asp-controller="Home" asp-action="Courses">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                <span>คอร์สเรียน</span>
            </a>
            <a asp-controller="Learning" asp-action="Island">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
                <span>เส้นทางอาชีพ</span>
            </a>
        </nav>

        <div class="account-nav-right">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Account" asp-action="@(User.IsInRole("Admin") ? "AdminDashboard" : "Dashboard")" class="account-nav-action">
                    <span>@(User.IsInRole("Admin") ? "แอดมินแดชบอร์ด" : "ห้องเรียนของฉัน")</span>
                    <span aria-hidden="true">→</span>
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="account-nav-action">
                    เข้าสู่ระบบ
                </a>
            }
        </div>
    </header>

    <main class="account-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand-copy">
                <span>NextSkill · Upskill &amp; Reskill</span>
                <span class="footer-tagline">เก่งขึ้นทีละก้าว ไปด้วยกันกับ Nimo</span>
            </div>
            <div class="footer-links">
                <a asp-controller="Home" asp-action="Privacy">ความเป็นส่วนตัว</a>
                <span aria-hidden="true">·</span>
                <a asp-controller="Account" asp-action="Terms">เงื่อนไขการใช้งาน</a>
            </div>
        </div>
    </footer>

    <!-- ==========================================
         CINEMATIC FULL-SCREEN DUOLINGO MASCOT LOADING SCREEN
         ========================================== -->
    <div id="nimoLoginLoadingOverlay" class="nimo-loading-overlay full-screen-mode" aria-hidden="true" role="dialog" aria-modal="true" aria-label="กำลังเข้าสู่ระบบ">
        <!-- Daylight Atmosphere Sky Canvas -->
        <div class="fs-loading-sky" aria-hidden="true">
            <!-- Floating Daylight Fluffy Clouds across the screen -->
            <div class="fs-cloud fs-c1"></div>
            <div class="fs-cloud fs-c2"></div>
            <div class="fs-cloud fs-c3"></div>
            <div class="fs-cloud fs-c4"></div>

            <!-- Soft Radiant Aurora Glow Orbs -->
            <div class="fs-aurora-orb fs-orb-top"></div>
            <div class="fs-aurora-orb fs-orb-center"></div>

            <!-- Floating 3D Learning Artifacts (Book, Grad Cap, Play Cube) -->
            <div class="fs-float-prop prop-cap">
                <img src="~/images/float-grad-cap.png" asp-append-version="true" alt="" width="95" height="102" />
            </div>
            <div class="fs-float-prop prop-book">
                <img src="~/images/float-book.png" asp-append-version="true" alt="" width="90" height="75" />
            </div>
            <div class="fs-float-prop prop-cube">
                <img src="~/images/float-play-cube.png" asp-append-version="true" alt="" width="52" height="56" />
            </div>

            <!-- Ambient Twinkling Golden XP Stars -->
            <span class="fs-xp-star xps-1">✦</span>
            <span class="fs-xp-star xps-2">★</span>
            <span class="fs-xp-star xps-3">✦</span>
            <span class="fs-xp-star xps-4">★</span>
            <span class="fs-xp-star xps-5">✦</span>
        </div>

        <!-- Full-Screen Content Container -->
        <div class="fs-loading-content">
            <!-- Top Branding Capsule Pill -->
            <div class="fs-top-brand-pill">
                <span class="fs-brand-symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                        <path d="M4 4v16l8-10 8 10V4" />
                    </svg>
                </span>
                <strong>NextSkill</strong>
                <span class="fs-brand-divider">|</span>
                <span>ก้าวสู่โลกแห่งการเรียนรู้</span>
            </div>

            <!-- Center Mascot Reading Stage -->
            <div class="fs-mascot-stage">
                <!-- Large Radiant Portal Aura -->
                <div class="fs-portal-aura" aria-hidden="true"></div>

                <!-- Floating Star Sparkles Rising from the Book -->
                <div class="fs-book-sparkles" aria-hidden="true">
                    <span class="fb-spark fb-1">✦</span>
                    <span class="fb-spark fb-2">★</span>
                    <span class="fb-spark fb-3">✦</span>
                    <span class="fb-spark fb-4">★</span>
                </div>

                <!-- Center High-Res Nimo Reading Book -->
                <div class="fs-nimo-hero">
                    <img src="~/images/nimo-learning.png" asp-append-version="true" alt="มาสคอตนิโมกำลังอ่านหนังสือเตรียมความพร้อม" class="fs-nimo-img" id="loadingNimoImg" width="260" height="260" />
                </div>

                <!-- Elegant Duolingo Motivational Speech Bubble -->
                <div class="fs-speech-bubble" id="loadingSpeechBubble">
                    <div class="fs-speech-inner">
                        <span class="fs-quote-mark" aria-hidden="true">“</span>
                        <p class="fs-quote-text" id="loadingQuoteText">ความพยายามอยู่ที่ไหน ความสำเร็จอยู่ที่นั่น</p>
                        <span class="fs-quote-mark-end" aria-hidden="true">”</span>
                    </div>
                    <span class="fs-speech-tail" aria-hidden="true"></span>
                </div>
            </div>

            <!-- Bottom Progress & Gamified Console -->
            <div class="fs-progress-console">
                <div class="fs-progress-meta">
                    <div class="fs-status-box">
                        <span class="fs-status-dot" aria-hidden="true"></span>
                        <span class="fs-stage-label" id="loadingStageLabel">กำลังเชื่อมต่อระบบบัญชี NextSkill...</span>
                    </div>
                    <div class="fs-percent-box">
                        <span class="fs-percent-number" id="loadingPercentNumber">0%</span>
                    </div>
                </div>

                <!-- 3D Chunky Progress Bar Track -->
                <div class="fs-progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                    <div class="fs-progress-fill" id="loadingProgressFill" style="width: 0%;">
                        <span class="fs-progress-glow-tip" aria-hidden="true"></span>
                        <span class="fs-progress-star-tip" aria-hidden="true">★</span>
                    </div>
                </div>

                <!-- Inspiring Learner Tip -->
                <div class="fs-tip-capsule">
                    <span class="tip-bulb" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path><path d="M9 18h6"></path><path d="M10 22h4"></path></svg>
                    </span>
                    <span id="loadingSubTip">เรียนรู้วันละนิด สะสมทักษะชีวิตทีละก้าวไปกับ NextSkill</span>
                </div>
            </div>
        </div>

        <!-- Stylized Bottom Ocean Island Waves -->
        <div class="fs-waves-landscape" aria-hidden="true">
            <svg class="fs-wave-svg wave-back" viewBox="0 0 1440 120" preserveAspectRatio="none">
                <path d="M0,45 C320,85 480,15 760,50 C1040,85 1200,20 1440,48 L1440,120 L0,120 Z" fill="rgba(255,255,255,0.2)"></path>
            </svg>
            <svg class="fs-wave-svg wave-front" viewBox="0 0 1440 120" preserveAspectRatio="none">
                <path d="M0,60 C360,20 540,90 880,55 C1180,25 1320,70 1440,58 L1440,120 L0,120 Z" fill="rgba(255,255,255,0.45)"></path>
            </svg>
        </div>
    </div>

    <script src="~/js/account.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
</body>
</html>
