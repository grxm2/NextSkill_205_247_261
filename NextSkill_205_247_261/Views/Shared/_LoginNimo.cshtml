<div class="mascot-character-art login-nimo login-nimo-beach-mode" data-login-nimo data-mood="idle" data-shades="on" data-speech-visible="false" role="button" tabindex="0" title="คลิกให้นิโมถอดแว่นพูดคำคมการเรียนรู้!">
    <span class="login-nimo-motion" aria-hidden="true">
        <span class="login-nimo-dance-stage" data-nimo-stage>
            <span class="login-nimo-front nimo-shades-layered-rig" data-nimo-pose="wave">
                <img src="~/images/nimo-beach-no-shades.webp" asp-append-version="true" alt="Nimo นั่งเก้าอี้ชายหาดจิบน้ำส้ม" class="nimo-rig-base-open" width="260" height="260" draggable="false" />
                <img src="~/images/nimo-beach-cool-base.webp" asp-append-version="true" alt="" class="nimo-rig-base-cool" width="260" height="260" draggable="false" />
                <span class="nimo-animated-sunglasses-wrap">
                    <img src="~/images/nimo-beach-sunglasses.webp" asp-append-version="true" alt="" class="nimo-rig-sunglasses" width="260" height="260" draggable="false" />
                    <span class="nimo-shades-lens-glint"></span>
                </span>
            </span>
        </span>
    </span>
    <span class="mascot-speech-pill" data-nimo-speech-pill>
        <span data-nimo-caption>การเรียนรู้ไม่มีวันสิ้นสุด ทุกก้าวเล็กๆ วันนี้ คือความสำเร็จในวันหน้า!</span>
        <span class="speech-tail" aria-hidden="true"></span>
    </span>
</div>
