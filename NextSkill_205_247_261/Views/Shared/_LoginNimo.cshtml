@{
    var dancePoses = new[]
    {
        (Name: "bow", Image: "~/images/nimo-pose-crouch.png"),
        (Name: "hop", Image: "~/images/nimo-pose-jump.png"),
        (Name: "book", Image: "~/images/nimo-learning.png")
    };
}

<div class="mascot-character-art login-nimo" data-login-nimo data-mood="idle">
    <span class="login-nimo-motion" aria-hidden="true">
        <span class="login-nimo-dance-stage" data-nimo-stage>
            <span class="login-nimo-front" data-nimo-pose="wave">
                <img src="~/images/nimo-pose-wave.png" asp-append-version="true" alt="" width="230" height="230" draggable="false" />
                <svg class="login-nimo-face" viewBox="0 0 1280 1280" focusable="false">
                    <defs>
                        <clipPath id="login-nimo-eye-left">
                            <path d="M461 557C455 489 492 440 548 439C609 432 655 477 671 527C693 599 636 650 575 651C513 654 469 618 461 557Z" />
                        </clipPath>
                        <clipPath id="login-nimo-eye-right">
                            <path d="M817 419C809 375 838 337 877 340C930 340 968 382 975 427C987 486 946 528 896 535C847 538 818 480 817 419Z" />
                        </clipPath>
                        <linearGradient id="login-nimo-iris" x2="0" y2="1">
                            <stop stop-color="#0b294c" />
                            <stop offset=".57" stop-color="#123e6d" />
                            <stop offset="1" stop-color="#4598ce" />
                        </linearGradient>
                    </defs>
                    <g class="login-nimo-eyes">
                        <g clip-path="url(#login-nimo-eye-left)">
                            <path fill="#f8fbff" d="M450 433H688V663H450Z" />
                            <g data-nimo-pupil>
                                <ellipse cx="574" cy="556" rx="74" ry="88" transform="rotate(-8 574 556)" fill="url(#login-nimo-iris)" stroke="#0c294b" stroke-width="9" />
                                <ellipse cx="569" cy="549" rx="42" ry="50" fill="#0b2d55" transform="rotate(-10 569 549)" />
                                <circle cx="594" cy="506" r="16" fill="#fff" />
                                <circle cx="549" cy="606" r="7" fill="#ecf7ff" />
                            </g>
                            <g class="login-nimo-lids">
                                <path fill="#8bc5e8" d="M450 433H688V663H450Z" />
                                <path fill="none" stroke="#244f7e" stroke-width="12" stroke-linecap="round" d="M499 560Q566 602 629 550" />
                            </g>
                        </g>
                        <g clip-path="url(#login-nimo-eye-right)">
                            <path fill="#f8fbff" d="M805 331H985V547H805Z" />
                            <g data-nimo-pupil>
                                <ellipse cx="879" cy="447" rx="59" ry="80" transform="rotate(-13 879 447)" fill="url(#login-nimo-iris)" stroke="#0c294b" stroke-width="9" />
                                <ellipse cx="871" cy="438" rx="36" ry="54" fill="#0b2d55" transform="rotate(-15 871 438)" />
                                <circle cx="868" cy="404" r="13" fill="#fff" />
                                <circle cx="917" cy="473" r="6" fill="#ecf7ff" />
                            </g>
                            <g class="login-nimo-lids">
                                <path fill="#8bc5e8" d="M805 331H985V547H805Z" />
                                <path fill="none" stroke="#244f7e" stroke-width="11" stroke-linecap="round" d="M835 443Q888 478 947 431" />
                            </g>
                        </g>
                    </g>
                </svg>
            </span>
            @foreach (var pose in dancePoses)
            {
                <span class="login-nimo-pose" data-nimo-pose="@pose.Name">
                    <img src="@pose.Image" asp-append-version="true" alt="" width="230" height="230" loading="lazy" decoding="async" draggable="false" />
                    <partial name="_LoginNimoDanceEyes" model="pose.Name" />
                </span>
            }
        </span>
    </span>
    <span class="mascot-speech-pill">
        <span data-nimo-caption>ไปเรียนด้วยกันนะ!</span>
        <span class="speech-tail" aria-hidden="true"></span>
    </span>
    <button class="login-nimo-pause" type="button" data-nimo-pause hidden>พักท่าเต้น</button>
</div>
